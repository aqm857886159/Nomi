  "dependency_lifecycle": {
    "decision": "retain-with-exit",
    "current": "@earendil-works/pi-ai 0.85 + @earendil-works/pi-agent-core 0.85",
    "target": "上游 SDK 在 SSE 流内异常上保留完整协议 error.type / error.code 结构对象时可精简传输层 SSE 错误帧旁路提取",
    "rationale": "当前 openai SDK 与 pi-ai 在 HTTP 200 SSE 流内报错时将异常压成无状态码裸字符串，需在传输包装层旁路保留原始协议 JSON。",
    "exit_criteria": [
      "升级 pi-ai 后若 AssistantMessage 原生携带流内协议 error.code 与 error.type，可移除 modelCallFetch 的 SSE 错误帧缓存并保持 fcAgentScenarios 全绿。"
    ]
  },
  "migration": "历史转录中已落盘的 length 助手消息在打开对话投影时自动补齐截断提示并保留正文；已落盘的 nomi.output-truncated 诊断自动映射本地化故障；旧版无诊断槽的错误消息保持 fail-closed 不泄露内部裸串。",
  "residual_risks": [
    "若个别非标自建网关在 HTTP 200 SSE 中既不发 event: error 也不带 JSON error/response.failed 字段而只把报错拼进普通正文 delta，客户端无法也绝不靠猜正文句子将其判为报错。",
    "真模型线上付费回合对照在本线仅做 no-key 免费演练，实网付费验证交协调会话统一执行。"
  ]
