  "door_reduction": {
    "before": 65,
    "after": 65,
    "why_not": "No door is removed: all readers already go through the one choke point (readCatalog); the fix makes that choke point cheap instead of adding a second read path. listModelCatalogMappings switches to the frozen shared snapshot of the same owner."
  },
  "generality_proof": "The cache sits inside readCatalog, keyed by path + raw bytes, so every present and future reader benefits and any writer (this process, another instance, a hand edit) invalidates it by changing the bytes. The renderer reader is scoped to one computation, so it cannot go stale.",
  "shared_boundaries": [
    {
