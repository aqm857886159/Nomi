{
  "schema_version": 3,
  "id": "2026-10-31-generation-idle-work",
  "problem_type": "Idle observations incorrectly schedule continuous rendering and durable snapshot work",
  "symptom": "Canvas interaction stalls while multiple cards wait for generation",
  "direct_cause": "Waiting shaders draw continuously; every progress tick bumps persistence revision; every pending poll writes envelope and Run snapshots; poll/materialize capture state before external awaits and commit after another operation has advanced observation, revision or completion.",
  "class_root": "Display observations and durable execution facts lack separate scheduling/persistence boundaries; async observations lacked a durable version fence and materialization ownership at the shared lifecycle boundary.",
  "affected_population": [
    "Every image/video waiting node and chat pointer",
    "Every setNodeProgress producer",
    "Every provider pending query across restart"
  ],
  "scope_paths": [
    "src/workbench/generationCanvas/nodes/GenerationWaitingSurface.tsx",
    "src/workbench/generationCanvas/nodes/BaseGenerationNode.tsx",
    "src/workbench/generationCanvas/nodes/NodeGeneratingOverlay.tsx",
