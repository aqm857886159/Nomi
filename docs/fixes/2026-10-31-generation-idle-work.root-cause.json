    "src/workbench/generationCanvas/nodes/ProgressRevealCanvas.tsx",
    "electron/productionRun/productionGenerationMaterialization.ts"
  ],
  "entry_points": [
    "Seven setNodeProgress producers from the generated matrix",
    "Three GenerationWaitingSurface consumers",
    "Run poll and runtime envelope writes"
  ],
  "external_sources": [],
  "internal_only_reason": "Internal scheduling and persistence invariants are established by repository source and controlled local measurements; no external API changes.",
  "invariants": [
    "Waiting for unchanged generation never schedules canvas drawing",
    "Only recovery identity or lifecycle changes mark the project dirty",
    "Same-status pending never rewrites complete envelope or Run snapshots",
    "First task identity, state transitions, terminal raw and idempotency remain durable",
    "After every external await, completed receipts win without writes or recovery conflicts.",
    "Stale observations cannot overwrite a newer completed observation, even before materialization.",
    "Run changes use the latest revision; only one filesystem lifecycle owner may invoke materializeOutput for an unlanded envelope."
  ],
