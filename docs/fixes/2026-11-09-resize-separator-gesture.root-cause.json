{
  "schema_version": 3,
  "id": "2026-11-09-resize-separator-gesture",
  "problem_type": "自定义尺寸把手未在 pointerdown 认领手势，字面 role 普查漏掉无 role 把手",
  "symptom": "提示词库抽屉拖宽时半截停住；示例图未加载时，自动走查的 mouse.move 等不到拖动拦截事件，直到外层 900 秒超时。 独立验收发现画中画右下角尺寸把手无同一道防护，且无 separator role 而漏过旧守卫；真实原生拖动是否发生以对照收据为准。",
  "direct_cause": "分隔条随指针移动，浏览器按按下坐标重新寻找拖动源时命中刚露出的图片；未取消 pointerdown 默认行为，原生拖动接走指针。未加载图片触发 dragstart 又撤回，Playwright 等不到 dragIntercepted。",
  "class_root": "指针捕获不取消默认内容拖动；以字面无障碍 role 代替真实尺寸手势的识别，使无 role 的把手漏过结构检查。",
  "affected_population": [
    "抽屉内容有图片、链接或选区的用户",
    "Agent 面板及时间轴分隔条附近存在可原生拖动内容的用户",
    "使用共享 Electron 启动器的原始输入走查"
  ],
  "scope_paths": [
    "src/ui/app-shell/shell/ShellRail.tsx",
    "src/workbench/AssistantPane.tsx",
    "src/workbench/timeline/TimelineResizeHandle.tsx",
    "src/workbench/generationCanvas/nodes/director/panels/viewport/PipViewport.tsx",
    "src/ui/onboarding/workflowPage/WorkflowGraphCanvas.tsx"
  ],
  "entry_points": [
    "WorkbenchShell → ShellRail → DrawerResizeHandle",
    "CreationWorkspace / StoryboardWorkspace / GenerationWorkspace / PreviewWorkspace → AssistantPane",
    "GenerationWorkspace → TimelineResizeHandle",
    "DirectorViewport → PipViewport.beginResize",
    "PipViewport.beginDrag → 画中画标题移动",
    "ComfyuiWorkflowSettingsPage → WorkflowGraphCanvas.onPointerDown → 空白起手平移"
  ],
  "external_sources": [],
  "internal_only_reason": "手势归属是本应用的内部交互契约；仓库内 EditorSplit 和 TimelineTextTrack 已使用同一 preventDefault 写法，静态类测试检查全部分隔条。浏览器和 Playwright 诊断源码证据保留在实现报告，不据此变更依赖。",
  "invariants": [
    "具有 resize/grab/move 光标且本地 pointerdown 实现发起 setPointerCapture 或 onMove 拖动会话的自定义尺寸把手，按下处理必须 preventDefault；不依赖 role。跨文件委托、库托管、外置 CSS 与非 pointerdown 的边界单列，不能宣称已被本守卫覆盖。",
    "分隔条键盘操作、尺寸钳制和双击复位保持可用；指针拖动保留原焦点。",
    "共享启动器给首窗及后续窗口的 mouse、keyboard、touchscreen 装入站点预算，原始输入挂住时在 30 秒内定位调用处；显式 delay 另按 API 语义计入。"
  ],
