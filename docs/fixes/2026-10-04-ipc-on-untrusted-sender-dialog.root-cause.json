    },
    {
      "path": "electron/logging/rendererLog.ts",
      "symbol": "registerRendererLogIpc",
      "responsibility": "渲染层日志 fire-and-forget 入口丢弃不可信来源，不把守卫异常抛回主进程。"
    },
    {
      "path": "electron/browser/core/browserViews.ts",
      "symbol": "runBrowserViewFireAndForget",
