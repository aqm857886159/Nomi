new file mode 100644
index 00000000..6e59b0ef
--- /dev/null
+++ b/src/workbench/ai/resident/ResidentComposerReferences.tsx
@@ -0,0 +1,103 @@
+import React from 'react'
+import { IconChevronDown, IconChevronUp, IconPencil, IconTool, IconX } from '@tabler/icons-react'
+import type { ProjectAgentReference } from '../../workbenchStore'
+import type { LibraryPrompt } from '../../api/promptLibraryApi'
+import { cn } from '../../../utils/cn'
+import { ResidentReferenceChip } from './ResidentReferenceChip'
+
+type Translate = (key: string, options?: Record<string, unknown>) => string
+
+type Props = {
+  references: readonly ProjectAgentReference[]
+  activeSkill: { key: string; name: string } | null
+  selectedLibraryPrompt: LibraryPrompt | null
+  promptModeId: string
+  promptLabel: string
+  t: Translate
+  onRemoveReference: (id: string) => void
+  onRemoveSkill: () => void
+  onRemovePrompt: () => void
+  onRemoveMode: () => void
+  referenceChip?: typeof ResidentReferenceChip
+}
+
+type ReferenceItem = { key: string; label: string; content: React.ReactNode }
+
+/** The composer owns one message: references and draft text share this box. */
+export function ResidentComposerReferences({
+  references,
+  activeSkill,
+  selectedLibraryPrompt,
+  promptModeId,
+  promptLabel,
+  t,
+  onRemoveReference,
+  onRemoveSkill,
+  onRemovePrompt,
+  onRemoveMode,
+  referenceChip: ReferenceChip = ResidentReferenceChip,
+}: Props): JSX.Element | null {
+  const [expanded, setExpanded] = React.useState(false)
+  const items: ReferenceItem[] = [
+    ...references.map((reference) => ({
+      key: reference.id,
+      label: reference.label,
+      content: <ReferenceChip reference={reference} t={t} onRemove={() => onRemoveReference(reference.id)} />,
+    })),
+    ...(activeSkill ? [{
+      key: `skill:${activeSkill.key}`,
+      label: activeSkill.name,
+      content: <span data-agent-reference={`skill:${activeSkill.key}`} className="inline-flex h-6 max-w-full items-center gap-1 rounded-pill bg-nomi-accent-soft px-2 text-micro text-nomi-accent">
+        <IconTool size={12} aria-hidden="true" /><span className="truncate">{activeSkill.name}</span>
+        <button type="button" aria-label={t('agentResident.removeReference')} title={t('agentResident.removeReference')} onClick={onRemoveSkill} className="grid size-4 shrink-0 place-items-center rounded-pill hover:bg-nomi-accent/10"><IconX size={11} aria-hidden="true" /></button>
+      </span>,
+    }] : []),
+    ...(selectedLibraryPrompt && !activeSkill ? [{
+      key: `prompt-library:${selectedLibraryPrompt.origin}:${selectedLibraryPrompt.id}`,
+      label: promptLabel,
+      content: <span data-agent-reference={`prompt-library:${selectedLibraryPrompt.origin}:${selectedLibraryPrompt.id}`} className="inline-flex h-6 max-w-full items-center gap-1 rounded-pill bg-nomi-accent-soft px-2 text-micro text-nomi-accent" title={selectedLibraryPrompt.prompt}>
+        <IconPencil size={12} aria-hidden="true" /><span className="truncate">{promptLabel}</span>
+        <button type="button" aria-label={t('agentResident.removeReference')} title={t('agentResident.removeReference')} onClick={onRemovePrompt} className="grid size-4 shrink-0 place-items-center rounded-pill hover:bg-nomi-accent/10"><IconX size={11} aria-hidden="true" /></button>
+      </span>,
+    }] : []),
+    ...(promptModeId !== 'general' && !activeSkill && !selectedLibraryPrompt ? [{
+      key: `prompt:${promptModeId}`,
+      label: promptLabel,
+      content: <span data-agent-reference={`prompt:${promptModeId}`} className="inline-flex h-6 max-w-full items-center gap-1 rounded-pill bg-nomi-ink-05 px-2 text-micro text-nomi-ink-80">
+        <IconPencil size={12} aria-hidden="true" /><span className="truncate">{promptLabel}</span>
+        <button type="button" aria-label={t('agentResident.removeReference')} title={t('agentResident.removeReference')} onClick={onRemoveMode} className="grid size-4 shrink-0 place-items-center rounded-pill hover:bg-nomi-ink-10"><IconX size={11} aria-hidden="true" /></button>
+      </span>,
+    }] : []),
+  ]
+
+  React.useEffect(() => {
+    if (items.length <= 3 && expanded) setExpanded(false)
+  }, [expanded, items.length])
+  if (!items.length) return null
+
+  const visibleItems = expanded || items.length <= 3 ? items : items.slice(0, 2)
+  const overflowCount = items.length - visibleItems.length
+  const third = items[2]
+  return (
+    <div className={cn('flex flex-wrap items-center gap-1', expanded && 'max-h-20 overflow-y-auto')} data-agent-references="true">
+      {visibleItems.map((item) => <React.Fragment key={item.key}>{item.content}</React.Fragment>)}
+      {!expanded && overflowCount > 0 && third ? (
+        <button
+          type="button"
+          className="inline-flex h-6 max-w-full items-center gap-1 rounded-pill bg-nomi-ink-05 px-2 text-micro text-nomi-ink-80 hover:bg-nomi-ink-10"
+          aria-expanded="false"
+          aria-label={t('agentResident.referenceMore', { label: third.label, count: overflowCount })}
+          title={t('agentResident.referenceMore', { label: third.label, count: overflowCount })}
+          onClick={() => setExpanded(true)}
+        >
+          <span className="truncate">{third.label}</span><span className="shrink-0">+{overflowCount}</span><IconChevronDown size={12} aria-hidden="true" />
+        </button>
+      ) : null}
+      {expanded ? (
+        <button type="button" className="inline-flex h-6 items-center gap-1 rounded-pill px-2 text-micro text-nomi-ink-60 hover:bg-nomi-ink-05" aria-expanded="true" aria-label={t('agentResident.referenceCollapse')} title={t('agentResident.referenceCollapse')} onClick={() => setExpanded(false)}>
+          <IconChevronUp size={12} aria-hidden="true" />{t('agentResident.referenceCollapse')}
+        </button>
+      ) : null}
+    </div>
+  )
+}
