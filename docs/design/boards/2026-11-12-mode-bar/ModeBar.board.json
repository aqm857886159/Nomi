{
  "board": "ModeBar",
  "approvedOn": "2026-11-12",
  "stage": "built",
  "visualReview": "用户 2026-11-12 看过探索稿 A–J（11 张）后点头，边界稿 K1–K5 同日「按推荐做」，另一条线独立核对过一遍（9 处已改）。改掉 10-18 ComposerB3 的三条拍板：方式放在参数面板里 / 永远没有「文生视频」/ 「未用到」淡格；用户知情并同意。",
  "sourceBoundary": "板源 = Claude Design 画布「底栏：模型｜方式｜参数」探索稿 A–J（source/ 下每格一个 .dc.html，canvas.json 为画布布局与备注）。preview/ModeBar.html 是把这些格展开成的静态拼页，candidates 由 board-extract 在该拼页上抽出；preview/*.png 是拍板时看的图。源里的品牌图标是占位圆（图标库不在仓库里），以 PNG 为准。边界稿 K1–K5 用户 2026-11-12「按推荐做」后收进本板，canvas.json 里的边界备注一并保留；K6（模型菜单排满）属下一刀，不收。",
  "designIntent": "底栏三格「模型｜方式｜参数」，方式格写的就是这次真发的方式；方式由唯一 owner modeForInputs 按「模型有哪些方式 + 放了哪些输入 + 人手偏好」现算：没放输入 = 文生视频，放了输入默认取放得下全部的那种，手选只在放得下时生效，放多了自动改并说一句，减少不跳回，删光回文生视频，模型放不下就留在收得最多的那种、多出的淡显「不会发」、照样能发。图片节点没有方式格。叫法统一：文生视频 / 图生视频 / 首尾帧 / 全能参考。",
  "decisions": [
    {
      "id": "D1",
      "text": "方式回到底栏做成一格下拉（10-18 放进参数面板的决定作废）",
      "appliesTo": [
        "bar.mode",
        "mode.menu",
        "params.panel"
      ],
      "source": "用户 2026-11-12「是不是应该放回来呢？让他确认和理解」"
    },
    {
      "id": "D2",
      "text": "有「文生视频」这个选项，没放输入时方式格写的就是它（10-18「永远没有文生视频」作废）",
      "appliesTo": [
        "bar.mode",
        "mode.menu"
      ],
      "source": "用户 2026-11-12「按照他的思路改…他已经是成熟产品了」"
    },
    {
      "id": "D3",
      "text": "「未用到」淡格只在模型自己放不下时留着，写「不会发」；其余情况自动换方式并在行尾说一句",
      "appliesTo": [
        "ref.tile.not-sent",
        "ref.tail.switched",
        "ref.tail.model-limit"
      ],
      "source": "用户 2026-11-12 点头探索稿 D / J"
    },
    {
      "id": "D4",
      "text": "菜单每行下面一句说明（要什么、上限多少；置灰的写为什么），图标用 Tabler 成套",
      "appliesTo": [
        "mode.menu"
      ],
      "source": "用户 2026-11-12「学一下 libtv 的交互，下面写一些描述…其余按你的做」「跟这些成熟的产品做对齐…包括 Icon」"
    },
    {
      "id": "D6",
      "text": "边界四条：行尾那句话整句不折、放不下换到图下面一行并钉在滚动区外；淡图不逐张写字；按类型报数；底栏挤时只退参数一格（比例 → 有声 → 清晰度 → 时长）；方式菜单说明最多两行",
      "appliesTo": [
        "ref.tail.count",
        "ref.tail.kind-count",
        "ref.tile.not-sent",
        "ref.tail.model-limit",
        "bar.params",
        "mode.menu"
      ],
      "source": "用户 2026-11-12「按推荐做」（边界稿 K1–K5）"
    },
    {
      "id": "D5",
      "text": "模型菜单加品牌图标和说明、「变体」并进模型菜单——下一刀",
      "appliesTo": [
        "model.menu",
        "bar.model.brand-icon"
      ],
      "source": "用户 2026-11-12 点头探索稿 G；协调排为下一刀"
    }
