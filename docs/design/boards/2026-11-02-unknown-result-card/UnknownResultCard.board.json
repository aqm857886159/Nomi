{
  "board": "UnknownResultCard",
  "approvedOn": "2026-11-02",
  "stage": "built",
  "visualReview": "用户 11-02 在 Claude Design 画布「结果未知的卡」第二版（https://claude.ai/artifact/Ws3NRu9dmtstoUyjx7mPDQ，私有）上说「按设计稿改」。画布同屏放了调研、用户以前定过的话和三条路。协调逐张对过设计系统。",
  "sourceBoundary": "板源是画布的原样副本：部件在画布上叫 Main.dc.html，这里按板名存为 source/UnknownResultCard.dc.html，薄板的 dc-import 仍写 Main。preview/UnknownResultCard.html 和 -dark.html 是把画布渲染后抠出卡、格、确认卡、提示拼成的静态页，只用来抽候选；preview/*.png 是拍板时看的整页截图。分镜页上已经去掉的两条按另一张已批样张画，那是另一条线，不归这张板。",
  "designIntent": "结果不知道的卡不再画成失败；点「再发一次」时，三页弹同一张已有的花钱确认卡，写清为什么可能多扣钱。",
  "priorArt": [
    {
      "url": "https://www.nngroup.com/articles/confirmation-dialog/",
      "takeaway": "确认框只用在有严重后果、撤不回的动作上；写清后果；按钮写具体动作，不写 OK。",
      "decisionImpact": "确认了保留确认（可能多扣钱，撤不回）；改了：按钮从「继续」换成「再发一次」。"
    },
    {
      "url": "https://chromium.googlesource.com/chromium/src/+/9e001703a2/components/dialog_strings.grdp",
      "takeaway": "Chromium 的 Confirm Form Resubmission：重复提交可能重复下单，用弹窗说清，人点了才重发；按钮是 Continue。",
      "decisionImpact": "确认了「人亲手重发用弹窗问一次」；没有学它的按钮字。"
    },
    {
      "url": "https://docs.wcpos.com/error-codes/PAYMENT201",
      "takeaway": "POS 收款结果未知单独一类，提示先核对再重刷：Do not run the card again yet。",
      "decisionImpact": "确认了结果未知不当失败，卡不用失败红。Nomi 看不到账单，所以只提醒不拦人。"
    },
    {
      "url": "https://developer.apple.com/design/human-interface-guidelines/alerts",
      "takeaway": "提醒框的按钮用和提示内容相关的动词。",
      "decisionImpact": "确认了主按钮写「再发一次」。"
    }
  ],
  "decisions": [
    {
      "id": "D1",
      "text": "确认留着，不删：点 ↑ 时眼前不一定有那句话。全走已有的花钱确认卡，不另画。",
      "source": "用户 11-02「按设计稿改」，画布上三条路选第二条"
    },
    {
      "id": "D2",
      "text": "主按钮「再发一次」，不是「继续」。",
      "source": "用户 11-02 批过的字和设计系统 §1.9.1 相冲突，交用户定，「按设计稿改」按推荐走"
    },
    {
      "id": "D3",
      "text": "结果不明的卡用纸底，不用失败红；其它失败照旧红。",
      "source": "用户 11-02「按设计稿改」；可找回态代码注释早就写了刻意不进红色"
    },
    {
      "id": "D4",
      "text": "同一句话一处只说一次；分镜慢任务免费按钮排第一。",
      "source": "用户 11-02「按设计稿改」"
    }
  ],
