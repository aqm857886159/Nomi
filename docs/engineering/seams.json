      "owner": "未核",
      "map": "无",
      "checked": false,
      "prefixes": [
        "electron/shared/generationLowering/",
        "electron/catalog/outboundReferenceUrl",
        "electron/catalog/referenceChannels",
        "electron/shared/modelArchetypes/referenceChannels"
      ]
    },
    {
      "id": "draft-save",
      "name": "草稿 → 保存",
      "owner": "未核",
      "map": "无",
      "checked": false,
      "prefixes": [
        "electron/projects/",
        "electron/jsonFile",
        "electron/workspace/workspaceRepository",
