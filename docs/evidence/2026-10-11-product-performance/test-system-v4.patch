+// Correct owned test fixtures from decoded bytes. Never modify source media or product code.
+import fs from "node:fs";
+import path from "node:path";
+import { createRequire } from "node:module";
+import { execFileSync } from "node:child_process";
+import { pathToFileURL } from "node:url";
+import { hash, hashFile, inside } from "./baseline-config.mjs";
+import { validateMediaKind } from "./media-kind.mjs";
+export const FIXTURE_VERSION = "v2-actual-media-metadata";
+export const LAYOUT_VERSION = "v2-production-visual-size-row-max-gutter-70";
+const probes = new Map();
+export function resolveFixtureAsset(url, { projectRoot, projectId }) {
+  const u = new URL(url);
+  const segments = u.pathname
+    .split("/")
+    .filter(Boolean)
+    .map(decodeURIComponent);
+  if (
+    u.protocol !== "nomi-local:" ||
+    u.hostname !== "asset" ||
+    segments.shift() !== projectId ||
+    u.search ||
+    u.hash
+  )
+    throw new Error("Fixture media is not an owned project asset");
+  const file = fs.realpathSync(path.resolve(projectRoot, ...segments));
+  if (
+    !inside(fs.realpathSync(projectRoot), file) ||
+    !fs.statSync(file).isFile()
+  )
+    throw new Error("Fixture asset escapes project");
+  return file;
+}
+export function decodedSpec(probe) {
+  const s = probe.streams?.[0];
+  const rotation = Number(
+    s?.side_data_list?.find((x) => Number.isFinite(Number(x.rotation)))
+      ?.rotation ??
+      s?.tags?.rotate ??
+      0,
+  );
+  if (!Number.isFinite(rotation) || Math.abs(rotation % 90) > 0.001)
+    throw new Error("Unsupported non-right-angle media rotation");
+  const swap = Math.abs(rotation % 180) === 90;
+  const durationSeconds = Number(probe.format?.duration ?? s?.duration);
+  return {
+    width: swap ? s.height : s.width,
+    height: swap ? s.width : s.height,
+    codedWidth: s.width,
+    codedHeight: s.height,
+    rotation,
+    codec: s.codec_name,
+    durationSeconds:
+      Number.isFinite(durationSeconds) && durationSeconds > 0
+        ? durationSeconds
+        : null,
+  };
+}
+function probeMedia(file, kind, repoRoot) {
+  const sha256 = hashFile(file),
+    key = `${kind}:${sha256}`;
+  if (probes.has(key)) return probes.get(key);
+  const require = createRequire(path.join(repoRoot, "package.json"));
+  const probe = JSON.parse(
+    execFileSync(
+      require("@ffprobe-installer/ffprobe").path,
+      [
+        "-v",
+        "error",
+        "-select_streams",
+        "v:0",
+        "-show_streams",
+        "-show_format",
+        "-of",
+        "json",
+        file,
+      ],
+      { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] },
+    ),
+  );
+  const bytes = Buffer.alloc(16),
+    fd = fs.openSync(file, "r");
+  try {
+    fs.readSync(fd, bytes, 0, 16, 0);
+  } finally {
+    fs.closeSync(fd);
+  }
+  validateMediaKind(bytes, kind, probe);
+  execFileSync(
+    require("@ffmpeg-installer/ffmpeg").path,
+    [
+      "-v",
+      "error",
+      "-threads",
+      "1",
+      "-i",
+      file,
+      "-frames:v",
+      "1",
+      "-threads",
+      "1",
+      "-f",
+      "null",
+      "-",
+    ],
+    { stdio: ["ignore", "pipe", "pipe"] },
+  );
+  const spec = {
+    kind,
+    sha256,
+    bytes: fs.statSync(file).size,
+    ...decodedSpec(probe),
+  };
+  if (kind === "video" && spec.durationSeconds === null)
+    throw new Error("Video duration unavailable");
+  probes.set(key, spec);
+  return spec;
+}
+export function correctFixtureMedia(
+  record,
+  { projectRoot, repoRoot, inspect = probeMedia } = {},
+) {
+  const beforePayloadDigest = hash(JSON.stringify(record.payload)),
+    media = new Map();
+  let nodesChecked = 0,
+    resultsChecked = 0,
+    thumbnailsChecked = 0;
+  for (const node of record.payload.generationCanvas.nodes) {
+    if (!["image", "video"].includes(node.kind) || !node.result?.url) continue;
+    let current;
+    for (const result of [node.result, ...(node.history ?? [])]) {
+      const kind = result.type ?? node.kind;
+      if (!["image", "video"].includes(kind))
+        throw new Error("Unsupported result kind in media fixture");
+      const file = resolveFixtureAsset(result.url, {
+        projectRoot,
+        projectId: record.id,
+      });
+      const spec = inspect(file, kind, repoRoot);
+      media.set(spec.sha256, spec);
+      if (result === node.result) current = spec;
+      if (kind === "video") result.durationSeconds = spec.durationSeconds;
+      resultsChecked++;
+      if (result.thumbnailUrl) {
+        const thumb = inspect(
+          resolveFixtureAsset(result.thumbnailUrl, {
+            projectRoot,
+            projectId: record.id,
+          }),
+          "image",
+          repoRoot,
+        );
+        media.set(thumb.sha256, thumb);
+        thumbnailsChecked++;
+      }
+    }
+    const prefix = node.result.type ?? node.kind;
+    node.meta = {
+      ...node.meta,
+      [`${prefix}Width`]: current.width,
+      [`${prefix}Height`]: current.height,
+      [`${prefix}AspectRatio`]: current.width / current.height,
+      ...(prefix === "video"
+        ? { videoDuration: Math.round(current.durationSeconds * 1000) / 1000 }
+        : {}),
+    };
+    if (
+      node.meta[`${prefix}Width`] !== current.width ||
+      node.meta[`${prefix}Height`] !== current.height
+    )
+      throw new Error("Fixture metadata integrity failed");
+    nodesChecked++;
+  }
+  return {
+    fixtureVersion: FIXTURE_VERSION,
+    status: "verified",
+    nodesChecked,
+    resultsChecked,
+    thumbnailsChecked,
+    beforePayloadDigest,
+    afterPayloadDigest: hash(JSON.stringify(record.payload)),
+    media: [...media.values()].sort((a, b) => a.sha256.localeCompare(b.sha256)),
+  };
+}
+export function layoutRows(
+  nodes,
+  sizes,
+  { columns = 12, startX = 80, startY = 80, gutter = 70 } = {},
+) {
+  let y = startY,
+    maxX = startX;
+  for (let i = 0; i < nodes.length; i += columns) {
+    const row = nodes.slice(i, i + columns);
+    let x = startX,
+      height = 0;
+    for (const n of row) {
+      const s = sizes[n.id];
+      if (!(s?.width > 0 && s?.height > 0))
+        throw new Error("Production visual size unavailable");
+      n.position = { x, y };
+      x += s.width + gutter;
+      height = Math.max(height, s.height);
+      maxX = Math.max(maxX, x - gutter);
+    }
+    y += height + gutter;
+  }
+  return { maxX, maxY: y - gutter };
+}
+export function productionVisualSizes(nodes, { repoRoot, projectRoot }) {
+  const require = createRequire(path.join(repoRoot, "package.json")),
+    source = "src/workbench/generationCanvas/nodes/nodeSizing.ts";
+  const input = path.join(
+    projectRoot,
+    ".nomi",
+    "quality-layout-input.private.json",
+  );
+  fs.mkdirSync(path.dirname(input), { recursive: true });
+  fs.writeFileSync(input, JSON.stringify(nodes));
+  let sizes;
+  try {
+    const code = `import fs from 'node:fs';const m=await import(${JSON.stringify(pathToFileURL(path.join(repoRoot, source)).href)});const f=(m.default||m).resolveNodeVisualSize;process.stdout.write(JSON.stringify(Object.fromEntries(JSON.parse(fs.readFileSync(process.argv[1],'utf8')).map(n=>[n.id,f(n)]))));`;
+    sizes = JSON.parse(
+      execFileSync(
+        process.execPath,
+        [
+          "--import",
+          pathToFileURL(require.resolve("tsx")).href,
+          "--input-type=module",
+          "-e",
+          code,
+          input,
+        ],
+        { cwd: repoRoot, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] },
+      ),
+    );
+  } finally {
+    fs.rmSync(input, { force: true });
+  }
+  return sizes;
+}
+export function layoutFixture(
+  record,
+  { repoRoot, projectRoot, partitions } = {},
+) {
+  const nodes = record.payload.generationCanvas.nodes,
+    beforePositionDigest = hash(
+      JSON.stringify(nodes.map((n) => ({ id: n.id, position: n.position }))),
+    );
+  const source = "src/workbench/generationCanvas/nodes/nodeSizing.ts";
+  const sizes = productionVisualSizes(nodes, { repoRoot, projectRoot });
+  if (partitions) {
+    const left = nodes.filter((n) => partitions.members.includes(n.id)),
+      right = nodes.filter((n) => !partitions.members.includes(n.id));
+    const end = layoutRows(left, sizes, { columns: 2 });
+    layoutRows(right, sizes, { columns: 8, startX: end.maxX + 230 });
+  } else layoutRows(nodes, sizes);
+  for (let i = 0; i < nodes.length; i++)
+    for (let j = i + 1; j < nodes.length; j++) {
+      const a = nodes[i],
+        b = nodes[j],
+        sa = sizes[a.id],
+        sb = sizes[b.id];
+      if (
+        a.position.x < b.position.x + sb.width &&
+        b.position.x < a.position.x + sa.width &&
+        a.position.y < b.position.y + sb.height &&
+        b.position.y < a.position.y + sa.height
+      )
+        throw new Error("Canonical fixture visual boxes overlap");
+    }
+  return {
+    overlapCount: 0,
+    layoutVersion: LAYOUT_VERSION,
+    source,
+    sourceSHA256: hashFile(path.join(repoRoot, source)),
+    beforePositionDigest,
+    positionDigest: hash(
+      JSON.stringify(nodes.map((n) => ({ id: n.id, position: n.position }))),
+    ),
+    visualSizeDigest: hash(JSON.stringify(sizes)),
+    gutter: 70,
+    partitioned: Boolean(partitions),
+  };
+}
