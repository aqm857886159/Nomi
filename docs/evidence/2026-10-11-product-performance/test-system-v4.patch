+import fs from 'node:fs';
+import path from 'node:path';
+import {readConfig} from '../../../scripts/quality-system/baseline-config.mjs';
+import {preflightDocumentFixture} from '../../../scripts/quality-system/fixture-document-contract.mjs';
+// Portable adapter executes the same production ownership, hydration and count contract.
+export function preflightFixture(f) {
+ const config=readConfig(),p=JSON.parse(fs.readFileSync(path.join(f.projectRoot,'.nomi/project.json'),'utf8')).payload;
+ const result=preflightDocumentFixture(config.repoRoot,p,{documents:f.dimensions.documents,shots:f.dimensions.shots,clips:f.dimensions.clips,plans:1});
+ const nodes=p.generationCanvas.nodes;
+ const actual={...result.actual,images:nodes.filter(n=>n.kind==='image').length,videos:nodes.filter(n=>n.kind==='video').length};
+ const design=Object.values(p.storyboardDesignsByDocumentId).flat()[0];
+ const identity=design?.id===f.plan.id&&design?.title===f.plan.title&&design?.documentId===f.documents[0].id;
+ const passed=result.passed&&identity&&actual.images===f.dimensions.images&&actual.videos===f.dimensions.videos;
