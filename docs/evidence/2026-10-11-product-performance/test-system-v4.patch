+import {
+  acquireNativeLock,
+  releaseNativeLock,
+  runOwnedProcess,
+  childEnvironment,
+} from "./native-process.mjs";
+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { fileURLToPath } from "node:url";
+import { spawnSync } from "node:child_process";
