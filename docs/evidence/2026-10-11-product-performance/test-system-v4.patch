+test("every shipped runner parses before any GUI launch", () => {
+  const dir = path.resolve(import.meta.dirname, "baseline");
+  for (const name of fs.readdirSync(dir).filter((n) => n.endsWith(".mjs"))) {
+    const r = spawnSync(process.execPath, ["--check", path.join(dir, name)], {
+      encoding: "utf8",
+    });
+    assert.equal(r.status, 0, `${name}: ${r.stderr}`);
+  }
+});
