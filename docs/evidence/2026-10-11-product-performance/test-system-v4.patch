+// Reopen memory measures the settled library after close, never the earlier open-state window.
+export function postCloseMemorySeries(
+  cell,
+  { warmupRuns = 1, measuredCycles = 30, settleMs = 750 } = {},
+) {
+  const rows = (cell.memoryTrend ?? []).filter((r) => r.isWarmup === false);
+  const valid =
+    measuredCycles === 30 &&
+    rows.length === measuredCycles &&
+    rows.every(
+      (r, i) =>
+        r.iteration === warmupRuns + i &&
+        r.settleMs === settleMs &&
+        Number.isFinite(r.rendererWorkingSetKiB) &&
+        r.rendererWorkingSetKiB >= 0,
+    );
+  if (!valid)
+    return {
+      status: "inconclusive",
+      reason:
+        "Requires 30 ordered post-close library RSS snapshots with consecutive iterations and fixed 750ms settle",
+      observations: rows.length,
+    };
+  const values = rows.map((r) => r.rendererWorkingSetKiB / 1024),
+    mean = values.reduce((a, b) => a + b, 0) / values.length,
+    center = (values.length - 1) / 2;
+  const value =
+    values.reduce((n, y, i) => n + (i - center) * (y - mean), 0) /
+    values.reduce((n, _, i) => n + (i - center) ** 2, 0);
+  return {
+    status: "measured",
+    value,
+    observations: rows.length,
+    seriesCount: 1,
+    aggregation: "ols-over-measured-cycles",
+    phase: "post-close-project-library",
+    settleMs,
+    firstMiB: values[0],
+    lastMiB: values.at(-1),
+    peakMiB: Math.max(...values),
+    firstLastGrowthMiB: values.at(-1) - values[0],
+  };
+}
+export const INTERACTIVE_METRIC_MEANING = Object.freeze({
+  kind: "post-observation-control-ack-upper-bound",
+  unit: "ms",
+  start: "original trusted input",
+  end: "subsequent trusted project-menu visible acknowledgement",
+  includesObservationAndDriverGap: true,
+  earliestInteractiveTime: false,
+  budgetPolicy: "no-earliest-TTI-budget",
+});
