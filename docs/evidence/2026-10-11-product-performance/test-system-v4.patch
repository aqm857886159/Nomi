+    while (queue.length) {
+      const parent = queue.shift();
+      for (const child of children(parent)) {
+        if (!Number.isInteger(child) || child <= 1 || seen.has(child)) continue;
+        if (seen.size >= 256) throw new Error("descendant limit");
+        seen.add(child);
+        queue.push(child);
+        count++;
