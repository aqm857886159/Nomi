+import {
+  readConfig,
+  cloneOwned,
+  verifyGzip,
+} from "../../../scripts/quality-system/baseline-config.mjs";
+const config = readConfig();
+// Performance measurements only. Product source and user originals are read-only.
+// Execute one --suite=open|workflow|reopen at a time; never parallel Electron runs.
+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { spawnSync } from "node:child_process";
+import { pipeline } from "node:stream/promises";
+import { createGzip } from "node:zlib";
+import { pathToFileURL } from "node:url";
+import {
+  root,
+  repo,
+  out,
+  runId,
+  report,
+  launch,
+  close,
+  finish,
+  cell,
+  measure,
+  delay,
+  openProject,
+  generation,
+  fit,
+  save,
+} from "./completion-common.mjs";
+
+const arg = (key, fallback) =>
+  process.argv.find((s) => s.startsWith(`--${key}=`))?.slice(key.length + 3) ??
+  fallback;
+const suite = arg("suite", "workflow"),
+  scales = arg("scales", "small,typical,heavy").split(","),
+  only = arg("scenarios", "").split(",").filter(Boolean);
+const warmup = report.protocol.warmup,
+  runs = report.protocol.runs,
+  reopenRounds = Number(arg("reopen-rounds", "30"));
+if (!["open", "workflow", "reopen"].includes(suite))
+  throw new Error("Expected suite=open|workflow|reopen");
+const { findCanvasBlankPoint, findNodeHitPoint } = await import(
+  pathToFileURL(path.join(repo, "tests/ux/_canvasHit.mjs"))
+);
+const { selectAllCanvasNodes, runDragSelectionAll } = await import(
+  pathToFileURL(path.join(repo, "tests/ux/canvas-perf/dragScenarios.mjs"))
+);
+const fixtures = JSON.parse(fs.readFileSync(config.fixtureIndex, "utf8"));
+const projectsDir = path.join(out, "isolated-projects");
+fs.mkdirSync(projectsDir, { recursive: true });
+const shaFile = async (file) => {
+  const h = crypto.createHash("sha256");
+  for await (const b of fs.createReadStream(file)) h.update(b);
+  return h.digest("hex");
+};
+for (const f of fixtures) {
+  const originalRoot = f.projectRoot,
+    dest = path.join(projectsDir, f.scale);
+  cloneOwned(originalRoot, dest);
+  // Reapply the immutable seed, since another scenario may have mutated its copy.
+  f.record = JSON.parse(
+    JSON.stringify(f.record).replaceAll(originalRoot, dest),
+  );
+  f.record.lastKnownRootPath = dest;
+  f.projectRoot = dest;
+  for (const rel of ["project.json", ".nomi/project.json"])
+    fs.writeFileSync(path.join(dest, rel), JSON.stringify(f.record));
+  f.sourceSeedSha256 = crypto
+    .createHash("sha256")
+    .update(JSON.stringify(f.record.payload))
+    .digest("hex");
+  f.mediaInventory = {
+    images: {
+      nodeReferences: 0,
+      distinctURLs: 0,
+      uniqueContent: 0,
+      referencedFileBytes: 0,
+    },
+    videos: {
+      nodeReferences: 0,
+      distinctURLs: 0,
+      uniqueContent: 0,
+      referencedFileBytes: 0,
+    },
+  };
+  for (const [kind, key] of [
+    ["image", "images"],
+    ["video", "videos"],
+  ]) {
+    const nodes = f.record.payload.generationCanvas.nodes.filter(
+        (n) => n.kind === kind && n.result?.url,
+      ),
+      urls = [...new Set(nodes.map((n) => n.result.url))],
+      hashes = new Set();
+    let bytes = 0;
+    for (const url of urls) {
+      const rel = decodeURIComponent(new URL(url).pathname)
+          .replace(/^\//, "")
+          .split("/")
+          .slice(1)
+          .join("/"),
+        file = path.join(dest, rel);
+      bytes += fs.statSync(file).size;
+      hashes.add(await shaFile(file));
+    }
+    f.mediaInventory[key] = {
+      nodeReferences: nodes.length,
+      distinctURLs: urls.length,
+      uniqueContent: hashes.size,
+      referencedFileBytes: bytes,
+    };
+  }
+}
+const registry = path.join(out, "registry.private.json");
+fs.writeFileSync(
+  registry,
+  JSON.stringify(
+    fixtures.map((f) => ({
+      id: f.record.id,
+      name: f.record.name,
