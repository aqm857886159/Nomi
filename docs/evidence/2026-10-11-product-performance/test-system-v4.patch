+// Pure-JS safety regression only: never accesses the OS clipboard or starts GUI.
+import fs from 'node:fs'
+import vm from 'node:vm'
+import test from 'node:test'
+import assert from 'node:assert/strict'
+
+const source=fs.readFileSync(new URL('./baseline/ui-gap-completion.mjs',import.meta.url),'utf8')
+const script=name=>source.match(new RegExp('const '+name+'=`([^`]+)`'))?.[1]
+function nativeFixture(rows,{unreadable=false,reconstructable=true,changing=false}={}){
+ let clears=0,writes=0
+ const data=value=>({base64EncodedStringWithOptions:()=>value})
+ const array=values=>({get count(){return values.length},objectAtIndex:i=>values[i],addObject:item=>values.push(item),values})
+ const item=row=>({types:array(Object.keys(row)),dataForType:type=>unreadable?undefined:data(row[type]),setDataForType:(bytes,type)=>{if(!reconstructable)return false;row[type]=bytes.base64EncodedStringWithOptions(0);return true},row})
+ let current=array(rows.map(row=>item({...row}))),reads=0
+ const board={get pasteboardItems(){return current},get changeCount(){return changing?reads++:1},clearContents(){clears++;current=array([])},writeObjects(items){writes++;current=items;return true}}
+ const $={NSPasteboard:{generalPasteboard:board},NSPasteboardItem:{alloc:{get init(){return item({})}}},NSMutableArray:{alloc:{get init(){return array([])}}},NSData:{alloc:{initWithBase64EncodedStringOptions:value=>data(value)}},NSFileHandle:{fileHandleWithStandardInput:{readDataToEndOfFile:JSON.stringify(rows)}},NSString:{alloc:{initWithDataEncoding:value=>value}},NSUTF8StringEncoding:4}
+ return{context:{$,ObjC:{import(){},unwrap:value=>value}},counts:()=>({clears,writes}),rows:()=>current.values.map(x=>x.row)}
+}
+const run=(name,fixture)=>vm.runInNewContext(script(name)+';run()',fixture.context)
+test('snapshot preserves every item and format without writing the clipboard',()=>{
+ const rows=[{'public.utf8-plain-text':'Zml4dHVyZQ==','public.html':'PGI+eDwvYj4='},{'public.png':'AAECAw=='}],f=nativeFixture(rows)
+ assert.deepEqual(JSON.parse(run('clipboardSnapshotScript',f)),rows)
+ assert.deepEqual(f.counts(),{clears:0,writes:0})
+})
+test('unreadable promised data blocks before any clipboard write',()=>{
+ const f=nativeFixture([{'promised.format':'AA=='}],{unreadable:true})
+ assert.throws(()=>run('clipboardSnapshotScript',f));assert.equal(f.counts().clears,0)
+})
+test('unsupported reconstruction blocks before any clipboard write',()=>{
+ const f=nativeFixture([{'custom.format':'AA=='}],{reconstructable:false})
+ assert.throws(()=>run('clipboardSnapshotScript',f),/cannot be reconstructed/);assert.equal(f.counts().clears,0)
+})
+test('concurrent clipboard change invalidates snapshot without writes',()=>{
+ const f=nativeFixture([{'text':'AA=='}],{changing:true})
+ assert.throws(()=>run('clipboardSnapshotScript',f),/changed during snapshot/);assert.equal(f.counts().clears,0)
+})
+test('restore reconstructs all formats before clearing and preserves item order',()=>{
+ const rows=[{'a':'AQ==','b':'Ag=='},{'c':'Aw=='}],f=nativeFixture(rows)
+ assert.equal(run('clipboardRestoreScript',f),'restored');assert.deepEqual(f.rows(),rows);assert.deepEqual(f.counts(),{clears:1,writes:1})
+ const bad=nativeFixture(rows,{reconstructable:false});assert.throws(()=>run('clipboardRestoreScript',bad));assert.equal(bad.counts().clears,0)
+})
+test('empty clipboard round-trips without inventing content',()=>{
+ const f=nativeFixture([]);assert.equal(run('clipboardSnapshotScript',f),'[]');run('clipboardRestoreScript',f);assert.deepEqual(f.rows(),[])
+})
+test('portable smoke labels performance ineligible and retains clipboard finally restoration',()=>{assert.match(source,/config\.executionKind!==?'functional-smoke'/);assert.match(source,/restoreClipboard\(originalClipboard\)/)});
