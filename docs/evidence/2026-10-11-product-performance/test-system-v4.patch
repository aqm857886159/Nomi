+    if (!s) continue;
+    const timeline = cell.fixture==="timeline" || ["timeline", "extended"].includes(cell.suite),
+      creating = cell.scenario === "project-create-enter",
+      agent = cell.suite === "agent";
+    s.expectedAxes = {
+      ...s.expectedAxes,
+      documents: creating
+        ? 1
+        : timeline
+          ? { small: 2, typical: 24, heavy: 160 }[scale]
+          : { small: 2, typical: 5, heavy: 12 }[scale],
+      shots: creating ? 0 : { small: 12, typical: 48, heavy: 320 }[scale],
+      clips: timeline ? { small: 4, typical: 24, heavy: 160 }[scale] : 0,
+      // Opening a project creates the native main lane even without any prompt.
+      // Agent pressure cases explicitly seed 2/5/10; ordinary prepared cases keep one.
+      agentSessions: agent ? { small: 2, typical: 5, heavy: 10 }[scale] : 1,
+      libraryProjects: agent || cell.suite.startsWith("group-") || ["timeline","canvas-variant"].includes(cell.fixture) ? 1 : 3,
+      workspace: agent
+        ? cell.scenario.includes("canvas")
+          ? "generation"
+          : "creation"
+        : /timeline/.test(cell.scenario)
+          ? "preview"
+          : /storyboard/.test(cell.scenario)
+            ? "storyboard"
