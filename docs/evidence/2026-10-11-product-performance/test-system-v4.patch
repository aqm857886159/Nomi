+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { ProviderBudget, providerContractDigest, validateProviderContract } from "./real-provider.mjs";
+const sha = s => crypto.createHash("sha256").update(s).digest("hex");
+const oneYuan = 1000000;
+function writeAtomic(file, data) {
+  const tmp = file + "." + crypto.randomUUID() + ".tmp";
+  const fd = fs.openSync(tmp, "wx", 0o600);
+  try { fs.writeFileSync(fd, JSON.stringify(data, null, 2) + "\n"); fs.fsyncSync(fd); }
+  finally { fs.closeSync(fd); }
+  fs.renameSync(tmp, file);
+}
+function transaction(file, operation) {
+  const lock = file + ".lock", fd = fs.openSync(lock, "wx", 0o600);
+  try {
