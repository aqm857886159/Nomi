+    assert.equal(c.results.length, 0);
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test("JPEG in an mp4 slot cannot count as unique video even with positive ffprobe duration", () => {
+  const bytes = Buffer.from([255, 216, 255, 224, ...Array(12).fill(0)]);
+  assert.equal(classifyHeader(bytes), "image");
+  assert.throws(
+    () =>
+      validateMediaKind(bytes, "video", {
+        streams: [
+          { codec_name: "mjpeg", width: 640, height: 360, duration: 0.04 },
