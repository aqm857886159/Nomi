+      env: childEnvironment({ NOMI_QUALITY_CONFIG: config, NOMI_SERIAL_GUI_PERMIT:"1" }),
+      timeoutMs: Number(arg("timeout-ms", "1500000")),
+      ownersFile: path.join(dir, file + ".owners.private.jsonl"),
+      stdoutFile: path.join(dir, file + ".stdout.private.log"),
+      stderrFile: path.join(dir, file + ".stderr.private.log"),
+    },
