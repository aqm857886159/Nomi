+  // are queued for these handlers, rather than terminating the wrapper by default.
+  process.on('SIGINT',onInt);process.on('SIGTERM',onTerm);
+  try {
+    assertOwnedDispatchInspection();
+    fs.mkdirSync(path.dirname(ownersFile),{recursive:true});fs.writeFileSync(ownersFile,'',{mode:0o600});
+    // Open output files before dispatch so an ordinary file-open error starts no child.
+    stdoutFd=fs.openSync(stdoutFile,'w',0o600);stderrFd=fs.openSync(stderrFile,'w',0o600);
+    stdout=fs.createWriteStream(null,{fd:stdoutFd});stdoutFd=undefined;
+    stderr=fs.createWriteStream(null,{fd:stderrFd});stderrFd=undefined;
+    for(const stream of [stdout,stderr])stream.on('error',error=>{setupError??=error;requestTermination();});
