+  process.env.NOMI_QUALITY_CONFIG = path.resolve(configFile);
+  process.env.NOMI_CANVAS_PERF_REAL_ASSET_DIR = mediaDir;
+  process.env.NOMI_CANVAS_PERF_CANVAS_ONLY = "1";
+  const { createNomiUserWorkflowFixture } = await import(
+    pathToFileURL(
+      path.join(
+        here,
+        "../../tests/quality-system/baseline/workflow-fixture.mjs",
+      ),
+    )
+  );
+  const fixtures = [],
+    legacy = [],
+    groupAudit = [];
+  for (const scale of ["small", "typical", "heavy"]) {
+    const f = createNomiUserWorkflowFixture({
+      projectsDir: path.join(c.privateRoot, "projects"),
