+      cleanup=child?.pid?await cleanupOwnedTree(ownersFile):{confirmed:true,owned:0,terminated:0,unconfirmed:0,reason:'NO_CHILD_DISPATCHED'};
+      if(timeoutDescendants?.status==='unavailable'){cleanup.confirmed=false;cleanup.reason='PRE_TERMINATION_INVENTORY_UNAVAILABLE';cleanup.unconfirmed=Math.max(1,cleanup.unconfirmed??0);}
+    } catch {cleanup={confirmed:false,unconfirmed:1,reason:'CLEANUP_FAILED'};}
+    if(!cleanup.confirmed)unconfirmedExitSeen=true;
+    process.off('SIGINT',onInt);process.off('SIGTERM',onTerm);
+    if(child&&stdout&&stderr)closeOwnedProcessHandles(child,stdout,stderr,{confirmed:cleanup.confirmed});
+    else {stdout?.end();stderr?.end();}
+    for(const fd of [stdoutFd,stderrFd])if(fd!==undefined)try{fs.closeSync(fd);}catch{}
+  }
+  const result={status,timedOut,spawnError,interrupted,timeoutDescendants,cleanup,...(setupError?{setupError:setupError.code||'OWNED_PROCESS_SETUP_FAILED'}:{})};
+  try {fs.writeFileSync(ownersFile+'.cleanup.private.json',JSON.stringify(result));}
+  catch {result.receiptWriteFailed=true;}
+  if(interrupted){const error=new Error('Native execution interrupted; queue stopped after owned cleanup');error.name='NativeExecutionInterrupted';error.result=result;throw error;}
+  if(setupError){setupError.result=result;throw setupError;}
+  return result;
+}
+
+export function childEnvironment(extra = {}, base = process.env) {
+  const keys = [
+    "PATH",
+    "HOME",
+    "SHELL",
+    "TMPDIR",
+    "TMP",
+    "TEMP",
+    "LANG",
+    "LC_ALL",
+    "LC_CTYPE",
+    "__CF_USER_TEXT_ENCODING",
+    "DISPLAY",
+    "WAYLAND_DISPLAY",
+    "XDG_RUNTIME_DIR",
+  ];
+  const env = Object.fromEntries(
+    keys.filter((k) => typeof base[k] === "string").map((k) => [k, base[k]]),
+  );
+  for (const k of ["NOMI_QUALITY_CONFIG"]) if (extra[k]) env[k] = extra[k];
+  if(extra.NOMI_SERIAL_GUI_PERMIT === "1") env.NOMI_SERIAL_GUI_PERMIT="1";
+  return {
+    ...env,
+    NOMI_SPEND_OK: "0",
+    NOMI_ALLOW_REAL_PROVIDERS: "0",
+    NOMI_WALK_ALLOW_ORIGINS: "",
+  };
+}
