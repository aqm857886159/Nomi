+  }
+  scenarios.push(...matrixScenarios);
+  for(const cell of baselinePlan({suites:["format",...Object.keys(UI_TEXT_GROUPS).map(g=>"ui-"+g),"task-recovery"],executionKind:"functional-smoke"}).cells) {
