+  writeJson(fixtureIndex, fixtures);
+  writeJson(
+    path.join(jobRoot, "registry.private.json"),
+    fixtures.map((f, i) => ({
+      id: f.record.id,
+      name: f.record.name,
+      rootPath: f.projectRoot,
+      lastOpenedAt: 100 - i,
+      missing: false,
+    })),
+  );
