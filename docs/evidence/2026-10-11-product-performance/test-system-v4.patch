+          input: target,
+          event: "pointerover",
+          target,
+          condition: `const v=document.querySelector(spec.target)?.querySelector('video');return !!v&&v.readyState>=2&&v.videoWidth>0&&!v.paused&&v.currentTime>0`,
+        },
+        action: () => w.mouse.move(point.x, point.y),
+        verify: async () => {
+          const after = await w.locator(target).evaluate((el) => {
+            const v = el.querySelector("video"),
+              q = v?.getVideoPlaybackQuality?.();
+            return {
+              width: v?.videoWidth,
+              height: v?.videoHeight,
+              currentTime: v?.currentTime,
+              quality: q
+                ? { total: q.totalVideoFrames, dropped: q.droppedVideoFrames }
+                : null,
+            };
+          });
+          return {
+            before,
+            after,
+            counterDelta:
+              before && after.quality
+                ? {
+                    total: after.quality.total - before.total,
+                    dropped: after.quality.dropped - before.dropped,
+                  }
+                : null,
+          };
+        },
+      };
+    });
+    await measuredCell(inst, f, "project-create-enter", async () => {
+      await library(w);
+      const libraryProjectCountBefore = await w
+        .locator("[data-project-card]")
+        .count();
+      return {
+        spec: {
+          input: "[data-library-new-project]",
+          condition:
+            vis +
+            `const t=document.querySelector('[data-shell-project-menu]'),e=document.querySelector('[aria-label="创作文档编辑区"] .tiptap[contenteditable=true]');return visible(t)&&visible(e)`,
+        },
+        action: () => w.locator("[data-library-new-project]").click(),
+        verify: async () => ({
+          newProjectVisible: await w
+            .locator("[data-shell-project-menu]")
+            .isVisible(),
+          libraryProjectCountBefore,
+        }),
+      };
+    });
+  } finally {
+    for (const c of report.cells) normalizeSampling(c);
+    await closeAndCompress(inst);
+  }
+}
+
+async function reopenSuite(f) {
+  if (!selected("project-reopen-30")) return;
+  const inst = await start(`${f.scale}-reopen`),
+    w = inst.win,
+    c = {
+      alias: f.scale,
+      scenario: "project-reopen-30",
+      cache: "hot",
+      status: "running",
+      samples: [],
+      memoryTrend: [],
+      fixture: f.summary,
+    };
+  report.cells.push(c);
+  save();
+  try {
+    for (let i = 0; i < warmup + reopenRounds; i++) {
+      const p = await preparedOpen(inst, f);
+      const s = await measure(
+        inst,
+        { ...p.spec, kind: c.scenario },
+        p.action,
+        i,
+      );
+      s.assertions = await p.verify();
+      c.samples.push(s);
+      await library(w);
+      const bw = await inst.app.browserWindow(w),
+        rendererPid = await bw.evaluate((b) => b.webContents.getOSProcessId()),
+        m = await inst.app.evaluate(({ app }) => app.getAppMetrics());
+      c.memoryTrend.push({
+        iteration: i,
+        isWarmup: i < warmup,
+        atUtc: new Date().toISOString(),
+        settleMs: 750,
+        mainWorkingSetKiB:
+          m.find((x) => x.pid === inst.app.process().pid)?.memory
+            .workingSetSize ?? null,
+        rendererWorkingSetKiB:
+          m.find((x) => x.pid === rendererPid)?.memory.workingSetSize ?? null,
+      });
+      save();
+    }
+    c.status = "executed";
+    c.summary = {
+      measuredSamples: c.samples.filter((s) => !s.isWarmup).length,
+      functionalPassed: c.samples.every((s) => s.summary.functionalPassed),
+      memoryInterpretation:
+        "Fixed 750 ms library settle after each open; trend only, no forced GC; cannot establish a leak from this run alone",
+    };
+  } catch (e) {
+    c.status = "blocked";
+    c.errorType = e.name;
+    c.error = String(e.stack || e);
+  } finally {
+    normalizeSampling(c);
+    await closeAndCompress(inst);
+    save();
+  }
+}
+
+try {
+  for (const scale of scales) {
+    const f = fixtures.find((f) => f.scale === scale);
+    if (!f) throw new Error("Unknown scale");
+    console.log(JSON.stringify({ phase: "workflow-scale", suite, scale }));
+    if (suite === "open") await openSuite(f);
+    else if (suite === "reopen") await reopenSuite(f);
+    else await workflowSuite(f);
+  }
+} catch (e) {
+  report.harnessErrorType = e.name;
+  report.harnessError = String(e.stack || e);
+  console.log(
+    JSON.stringify({
+      phase: "harness-blocked",
+      errorType: e.name,
+      message: String(e.message).replaceAll(root, "<TASK>").slice(0, 300),
+    }),
+  );
+} finally {
+  await closeAndCompress(current);
+  await finish();
+  fs.writeFileSync(
+    path.join(out, "trace-archive-receipts.json"),
+    JSON.stringify(report.traceArchives, null, 2),
+  );
+}
diff --git a/tests/quality-system/baseline/workflow-fixture.mjs b/tests/quality-system/baseline/workflow-fixture.mjs
new file mode 100644
--- /dev/null
+++ b/tests/quality-system/baseline/workflow-fixture.mjs
@@ -0,0 +1,306 @@
+// Source: https://github.com/aqm857886159/Nomi/blob/b8270014acdf59f2c51b4c149d52a44c8e450b1e/tests/ux/fixtures/nomi-user-workflow-fixture.mjs
+// Portable adaptation corrects owned fixture metadata and layout; product source remains unchanged.
+import fs from "node:fs";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import {
+  correctFixtureMedia,
+  layoutFixture,
+} from "../../../scripts/quality-system/fixture-media-metadata.mjs";
+import { readConfig } from "../../../scripts/quality-system/baseline-config.mjs";
+const { CANVAS_PERF_SCALES, createCanvasPerformanceFixture } = await import(
+  pathToFileURL(
+    path.join(
+      readConfig().repoRoot,
+      "tests/ux/fixtures/canvas-performance-fixture.mjs",
+    ),
+  )
+);
+
+export const NOMI_WORKFLOW_SCALES = Object.freeze({
+  small: Object.freeze({
+    canvasScale: "REAL",
+    documents: 2,
+    plans: 2,
+    shots: 12,
+    images: 4,
+    videos: 2,
+    references: 4,
+  }),
+  typical: Object.freeze({
+    canvasScale: "S",
+    documents: 5,
+    plans: 5,
+    shots: 48,
+    images: 24,
+    videos: 24,
+    references: 48,
+  }),
+  heavy: Object.freeze({
+    canvasScale: "XL",
+    documents: 12,
+    plans: 10,
+    shots: 320,
+    images: 160,
+    videos: 160,
+    references: 320,
+  }),
+});
+
+const clone = (value) => JSON.parse(JSON.stringify(value));
+
+function distributePlans(documentCount, planCount) {
+  const result = Array.from({ length: documentCount }, () => 0);
+  // Two competing plans on the first document; retain drafts without plans.
+  result[0] = Math.min(2, planCount);
+  for (let index = 2; index < planCount; index += 1)
+    result[1 + ((index - 2) % (documentCount - 1))] += 1;
+  return result;
+}
+
+function shot(index, scale, planIndex) {
+  const shotId = `workflow-${scale}-plan-${planIndex}-shot-${index + 1}`;
+  return {
+    index: index + 1,
+    shotId,
+    shotKind: index % 3 === 0 ? "image" : "video",
+    durationSec: 5,
+    anchorIds: [],
+    prompt: `Workflow fixture ${shotId}`,
+    modelKey: "local-fixture-model",
+    modeId: "fixture",
+  };
+}
+
+function buildPlan(scale, planIndex, shotCount) {
+  return {
+    title: `Workflow plan ${planIndex + 1}`,
+    profileKey: "fixture.performance",
+    anchors: [],
+    shots: Array.from({ length: shotCount }, (_, index) =>
+      shot(index, scale, planIndex),
+    ),
+  };
+}
+
+function ensureTwoVideos(record, projectId) {
+  // REAL is intentionally the small, real-media profile (4 images + 1 video).
+  // Add one deterministic copy so the user matrix's small tier remains 4 + 2.
+  const canvas = record.payload?.generationCanvas;
+  const source = canvas?.nodes?.find((node) => node.kind === "video");
+  if (!source) return;
+  const copy = clone(source);
+  copy.id = `${source.id}-workflow-video-2`;
+  copy.title = "Workflow video 2";
+  copy.result = { ...copy.result, id: `${copy.id}-result` };
+  copy.position = {
+    x: (copy.position?.x ?? 80) + 390,
+    y: (copy.position?.y ?? 80) + 300,
+  };
+  canvas.nodes.push(copy);
+  canvas.edges = Array.isArray(canvas.edges) ? canvas.edges : [];
+  canvas.edges.push({
+    id: `${projectId}-workflow-edge-video-2`,
+    source: source.id,
+    target: copy.id,
+    mode: "reference",
+    order: 0,
+  });
+}
+
+export function validateWorkflowFixtureSummary(summary, scale) {
+  const expected = NOMI_WORKFLOW_SCALES[scale];
+  if (!expected) throw new Error(`unknown workflow scale: ${scale}`);
+  for (const key of [
+    "documents",
+    "plans",
+    "shots",
+    "images",
+    "videos",
+    "references",
+  ]) {
+    const expectedValue = expected[key];
+    if (summary[key] !== expectedValue) {
+      throw new Error(
+        `${scale} ${key} expected ${expectedValue} but received ${summary[key]}`,
+      );
+    }
+  }
+  if (
+    summary.mediaProfile !== "synthetic-preview" &&
+    summary.mediaProfile !== "real-assets"
+  ) {
+    throw new Error(`unexpected media profile: ${summary.mediaProfile}`);
+  }
+  return true;
+}
+
+/**
+ * Offline project shape fixture. It contains no Agent streams or tools;
+ * future Agent journeys must drive the production runtime through a local peer.
+ */
+export function createNomiUserWorkflowFixture({
+  projectsDir,
+  scale = "typical",
+  projectId,
+} = {}) {
+  const config = NOMI_WORKFLOW_SCALES[scale];
+  if (!config) throw new Error(`unknown workflow scale '${scale}'`);
+  if (!projectsDir) throw new Error("projectsDir is required");
+  const id = projectId || `project-nomi-user-workflow-${scale}`;
+  if (!CANVAS_PERF_SCALES[config.canvasScale])
+    throw new Error(`unknown canvas scale '${config.canvasScale}'`);
+  const base = createCanvasPerformanceFixture({
+    projectsDir,
+    scale: config.canvasScale,
+    projectId: id,
+    projectName: `ZZ Nomi user workflow ${scale}`,
+  });
+  const record = clone(base.record);
+  if (scale === "small") ensureTwoVideos(record, id);
+
+  const planDistribution = distributePlans(config.documents, config.plans);
+  const documents = [];
+  const designsByDocument = {};
+  const plansByDocument = {};
+  let globalPlanIndex = 0;
+  for (
+    let documentIndex = 0;
+    documentIndex < config.documents;
+    documentIndex += 1
+  ) {
+    const documentId = `workflow-${scale}-document-${documentIndex + 1}`;
+    documents.push({
+      id: documentId,
+      version: 1,
+      title: `Workflow document ${documentIndex + 1}`,
+      updatedAt: 100 + documentIndex,
+      contentJson: {
+        type: "doc",
+        content: [
+          {
+            type: "paragraph",
+            content: [
+              {
+                type: "text",
+                text: `Workflow draft ${documentIndex + 1}. A creator compares scenes, edits dialogue and references mixed media.`,
+              },
+            ],
+          },
+        ],
+      },
+    });
+    const designs = [];
+    const persistedPlans = [];
+    for (
+      let localPlan = 0;
+      localPlan < planDistribution[documentIndex];
+      localPlan += 1
+    ) {
+      const planIndex = globalPlanIndex++;
+      const shotCount =
+        Math.floor(config.shots / config.plans) +
+        (planIndex < config.shots % config.plans ? 1 : 0);
+      const plan = buildPlan(scale, planIndex, shotCount);
+      const designId = `workflow-${scale}-design-${documentIndex + 1}-${localPlan + 1}`;
+      const design = {
+        id: designId,
+        documentId,
+        title: plan.title,
+        plan,
+        committed: false,
+        status: "draft",
+        sourceDocumentUpdatedAt: 100 + documentIndex,
+        createdAt: 101 + planIndex,
+        updatedAt: 101 + planIndex,
+      };
+      designs.push(design);
+      persistedPlans.push({ plan, committed: false });
+    }
+    designsByDocument[documentId] = designs;
+    plansByDocument[documentId] = persistedPlans;
+  }
+  record.payload = {
+    ...record.payload,
+    workbenchDocuments: documents,
+    activeDocumentId: documents[0]?.id,
+    storyboardDesignsByDocumentId: designsByDocument,
+    storyboardPlans: plansByDocument,
+  };
+  const canvas = record.payload.generationCanvas;
+  canvas.edges = canvas.edges.slice(0, config.references);
+  canvas.groups = [
+    {
+      id: `workflow-${scale}-mixed-group`,
+      name: "Workflow mixed media",
+      categoryId: "shots",
+      nodeIds: canvas.nodes.slice(0, 4).map((node) => node.id),
+      collapsed: false,
+      createdAt: 100,
+      updatedAt: 100,
+    },
+  ];
+  // Persist current results in the production version-list shape. Opening the
+  // project must not be the operation that invents its history for this test.
+  for (const node of canvas.nodes) {
+    if (node.result && !node.history?.length) {
+      node.result = { ...node.result, versionNo: 1 };
+      node.history = [node.result];
+      node.resultVersionMax = 1;
+    }
+  }
+  for (const node of canvas.nodes.slice(0, 2)) {
+    node.history = [2, 1].map((versionNo) => ({
+      ...node.result,
+      id: `${node.id}-workflow-v${versionNo}`,
+      versionNo,
+      createdAt: versionNo,
+    }));
+    node.result = node.history[0];
+    node.resultVersionMax = 2;
+  }
+  // Preserve the old factory payload as an explicitly diagnostic private variant.
+  fs.writeFileSync(
+    path.join(base.projectRoot, ".nomi", "quality-legacy-v1.private.json"),
+    JSON.stringify(record),
+  );
+  const metadataIntegrity = correctFixtureMedia(record, {
+    projectRoot: base.projectRoot,
+    repoRoot: readConfig().repoRoot,
+  });
+  const layoutIntegrity = layoutFixture(record, {
+    projectRoot: base.projectRoot,
+    repoRoot: readConfig().repoRoot,
+  });
+  record.lastKnownRootPath = base.projectRoot;
+  for (const filename of [
+    path.join(base.projectRoot, "project.json"),
+    path.join(base.projectRoot, ".nomi", "project.json"),
+  ]) {
+    fs.writeFileSync(filename, JSON.stringify(record, null, 1));
+  }
+  const summary = {
+    scale,
+    documents: documents.length,
+    plans: Object.values(designsByDocument).flat().length,
+    shots: Object.values(designsByDocument)
+      .flat()
+      .reduce((total, design) => total + design.plan.shots.length, 0),
+    images: canvas.nodes.filter((node) => node.kind === "image").length,
+    videos: canvas.nodes.filter((node) => node.kind === "video").length,
+    references: canvas.edges.length,
+    mediaProfile: base.summary.mediaProfile,
+    canvasScale: config.canvasScale,
+    canvasNodes: record.payload.generationCanvas?.nodes?.length || 0,
+    canvasEdges: record.payload.generationCanvas?.edges?.length || 0,
+  };
+  validateWorkflowFixtureSummary(summary, scale);
+  return {
+    ...base,
+    record,
+    summary,
+    fixtureVersion: metadataIntegrity.fixtureVersion,
+    metadataIntegrity,
+    layoutIntegrity,
+  };
+}
