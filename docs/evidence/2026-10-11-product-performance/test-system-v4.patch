+        const r = await execute(job.file, job.args, prepared.file);
+        confirmedExit = r.cleanup.confirmed;
+        writeJson(
+          path.join(prepared.runPrivateDir, "process-cleanup.private.json"),
+          r.cleanup,
+        );
