+}
+export function captureOwnedDescendants(
+  pid,
+  file,
+  {
+    children = (parent) => {
+      try {
+        return execFileSync("/usr/bin/pgrep", ["-P", String(parent)], {
+          encoding: "utf8",
+          stdio: ["ignore", "pipe", "ignore"],
+        })
+          .trim()
+          .split(/\s+/)
