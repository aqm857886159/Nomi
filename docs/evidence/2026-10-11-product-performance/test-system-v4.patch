+import vm from 'node:vm';
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  manifestAxes,
+  readWorkspaceIdentity,
+  observedAxes,
+} from "../../scripts/quality-system/runtime-axes.mjs";
+const fixture = {
+  record: {
+    payload: {
+      generationCanvas: {
+        nodes: Array.from({ length: 320 }, (_, i) => ({
+          kind: i < 160 ? "image" : "video",
+        })),
+      },
+      workbenchDocuments: Array.from({ length: 24 }, () => ({})),
+      storyboardDesignsByDocumentId: {
+        d: [{ plan: { shots: Array(48).fill({}) } }],
+      },
+      timeline: { tracks: [{ clips: Array(24).fill({}) }] },
+    },
+  },
+  mediaProfile: { uniqueImageAssets: 2, uniqueVideoAssets: 1 },
+};
+const observation = (extra = {}) => ({
+  manifest: manifestAxes(fixture.record),
+  workspace: "preview",
+  sessionHistory: 10,
+  activeStreams: 0,
+  libraryProjects: 1,
+  libraryLaunch: { verified: true },
+  ...extra,
+});
+const cell = (before = observation(), after = observation()) => ({
+  alias: "heavy",
+  scenario: "timeline-select-clip",
+  cache: "hot",
+  samples: [{ isWarmup: false, axisObservations: { before, after } }],
+});
+test("heavy label never upgrades an actual 24-document fixture to 160", () => {
+  const r = observedAxes(fixture, cell());
+  assert.equal(r.axes.documents, 24);
+  assert.equal(r.axes.shots, 48);
+  assert.equal(r.axes.clips, 24);
+  assert.notEqual(r.axes.documents, 160);
+});
+test("actual one-project library cannot become default three", () => {
+  assert.equal(observedAxes(fixture, cell()).axes.libraryProjects, 1);
+});
+test("missing active/history observations remain incomplete without scale fallback", () => {
+  const o = observation({ sessionHistory: null, activeStreams: null }),
+    r = observedAxes(fixture, cell(o, o));
+  assert.equal(r.status, "incomplete");
+  assert.equal(r.axes.agentSessions, null);
+  assert.ok(r.missing.includes("active-stream-observation"));
+  assert.equal(
+    observedAxes(fixture, { alias: "heavy", samples: [] }).status,
+    "incomplete",
+  );
+});
+test("expected mutation after action does not change starting load; next sample drift does", () => {
+  const after = observation();
+  after.manifest = { ...after.manifest, documents: 25 };
+  const c = cell(observation(), after),
+    r = observedAxes(fixture, c);
+  assert.equal(r.status, "observed");
+  assert.equal(r.axes.documents, 24);
+  assert.equal(r.observations[0].afterManifest.documents, 25);
+  c.samples.push({ axisObservations: { before: after, after } });
+  assert.ok(
+    observedAxes(fixture, c).missing.includes("within-cell-axis-drift"),
+  );
+});
+test("project transition reports actual target rather than previous project payload", () => {
+  const after = observation();
+  after.manifest = {
+    ...after.manifest,
+    nodes: 6,
+    imageVideo: { images: 4, videos: 2 },
+  };
+  const c = cell(observation(), after);
+  c.scenario = "project-switch";
+  const r = observedAxes(fixture, c);
+  assert.equal(r.axes.nodes, 6);
+  assert.equal(r.observations[0].loadPhase, "target-after-transition");
+});
+test("missing project transition target cannot fall back to the previous project", () => {
+  const c = cell(observation(), observation({ manifest: null }));
+  c.scenario = "project-switch";
+  const r = observedAxes(fixture, c);
+  assert.equal(r.status, "incomplete");
+  assert.equal(r.axes.nodes, null);
+});
+
+test("missing pre-action manifest cannot inherit post-action scale", () => {
+  const c = cell(observation({ manifest: null }), observation());
+  c.scenario = "group-delete";
+  const r = observedAxes(fixture, c);
+  assert.equal(r.status, "incomplete");
+  assert.equal(r.axes.nodes, null);
+  assert.equal(r.observations[0].loadPhase, "before-action");
+});
+
+test('internal storyboard identity comes from visible production shell despite creation presentation tab',()=>{
+ const shell=(mode,visible=true)=>({getClientRects:()=>visible?[{}]:[],getAttribute:k=>k==='data-workspace-mode'?mode:null,querySelector:()=>({getAttribute:()=> 'fixture-project'})});
+ const read=nodes=>vm.runInNewContext('('+readWorkspaceIdentity.toString()+')()', {document:{querySelectorAll:selector=>{assert.equal(selector,'.workbench-shell[data-workspace-mode]');return nodes;}}});
+ for(const mode of ['creation','storyboard','generation','preview'])assert.equal(read([shell(mode)]).workspace,mode);
+ assert.equal(read([shell('storyboard'),shell('creation',false)]).workspace,'storyboard');
+ for(const nodes of [[],[shell(null)],[shell('unknown')],[shell('storyboard'),shell('creation')]])assert.equal(read(nodes).workspace,null);
+});
