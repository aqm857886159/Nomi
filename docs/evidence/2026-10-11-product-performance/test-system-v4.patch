+    child=spawn(command,args,{cwd,env:{...env,NOMI_QUALITY_OWNERS:ownersFile,NODE_OPTIONS:`--require=${JSON.stringify(preload)}`},stdio:['ignore','pipe','pipe'],detached:process.platform!=='win32'});
+    completion=new Promise(resolve=>{settle=resolve;child.once('error',error=>{spawnError=error.code;resolve(null);});child.once('exit',code=>resolve(code));});
