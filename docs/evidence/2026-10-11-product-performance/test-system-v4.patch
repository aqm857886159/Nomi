+        status: "prepared-not-executed",
+        jobs: plan.jobs.length,
+        cells: plan.cells.length,
+        electronLaunched: false,
+        receiptAcceptance: false,
+      });
+    }
+  } else if (command === "import") {
+    const files = arg("receipts", "")
+      .split(",")
+      .filter(Boolean)
+      .map((x) => path.resolve(x));
