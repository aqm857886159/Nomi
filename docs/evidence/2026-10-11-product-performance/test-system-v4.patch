+      ...c,
+      ownershipRoot: c.privateRoot,
+      privateRoot: jobRoot,
+      fixtureIndex,
+      runPrivateDir,
+      runId,
+      nativeExecution: true,
+      executionKind: job.executionKind,
+      batchProtocol: job.batchProtocol,
+    },
+    file = path.join(runPrivateDir, "config.private.json");
+  writeJson(file, cfg);
+  writeJson(path.join(runPrivateDir, "job.private.json"), {
