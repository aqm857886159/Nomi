+import path from 'node:path';
+import {createRequire} from 'node:module';
+import crypto from 'node:crypto';
+const digest = value => crypto.createHash('sha256').update(JSON.stringify(value)).digest('hex');
+export function assertDocumentOwnership(payload) {
+  const documents=payload.workbenchDocuments;
+  if(!Array.isArray(documents)||!documents.length) throw Error('Missing document inventory');
+  const ids=new Set(documents.map(d=>d.id));
+  if(ids.size!==documents.length || !ids.has(payload.activeDocumentId)) throw Error('Invalid document identity or active owner');
+  const designs=payload.storyboardDesignsByDocumentId;
+  if(!designs || typeof designs!=='object') throw Error('Missing storyboard owner map');
+  for(const [owner, rows] of Object.entries(designs)) {
+    if(!ids.has(owner)||!Array.isArray(rows)) throw Error('Storyboard map owner not in document inventory');
+    for(const design of rows) {
+      if(design.documentId!==owner) throw Error('Storyboard design.documentId differs from map owner');
+      if(typeof design.title!=='string'||!design.title||design.title!==design.plan?.title) throw Error('Storyboard design and plan titles differ');
+    }
+  }
+  return true;
+}
+export function preflightDocumentFixture(repoRoot, payload, expected={}) {
+  assertDocumentOwnership(payload);
+  const require=createRequire(path.join(repoRoot,'package.json'));
+  const {require:tsxRequire}=require('tsx/cjs/api');
+  const {normalizePayload}=tsxRequire(path.join(repoRoot,'src/workbench/project/projectNormalize.ts'),import.meta.url);
+  const {createWorkbenchDocumentSlice}=tsxRequire(path.join(repoRoot,'src/workbench/workbenchDocumentSlice.ts'),import.meta.url);
+  const normalized=normalizePayload(payload);
+  let state;
+  const set=change=>{state={...state,...(typeof change==='function'?change(state):change)}};
+  state=createWorkbenchDocumentSlice(set,()=>state,{},()=>{});
+  state.hydrateWorkbenchDocuments(normalized.workbenchDocuments,normalized.activeDocumentId);
+  state.hydrateStoryboardDesigns(normalized.storyboardDesignsByDocumentId??{});
+  const rows=Object.values(state.storyboardDesignsByDocumentId).flat();
+  const actual={documents:state.workbenchDocuments.length,plans:rows.length,shots:rows.reduce((n,d)=>n+d.plan.shots.length,0),clips:normalized.timeline.tracks.reduce((n,t)=>n+t.clips.length,0)};
+  const hydrated={...normalized,workbenchDocuments:state.workbenchDocuments,activeDocumentId:state.activeDocumentId,storyboardDesignsByDocumentId:state.storyboardDesignsByDocumentId};
+  assertDocumentOwnership(hydrated);
+  const roundtrip=normalizePayload(hydrated);
+  const documentContentPreserved=state.workbenchDocuments.every((d,i)=>d.id===payload.workbenchDocuments[i]?.id&&digest(d.contentJson)===digest(payload.workbenchDocuments[i]?.contentJson));
+  const ownershipPreserved=rows.length===Object.values(payload.storyboardDesignsByDocumentId).flat().length;
+  const roundtripPreserved=roundtrip.workbenchDocuments.length===actual.documents&&digest(Object.values(roundtrip.storyboardDesignsByDocumentId??{}).flat())===digest(rows);
+  const passed=documentContentPreserved&&ownershipPreserved&&roundtripPreserved&&Object.entries(expected).every(([k,v])=>actual[k]===v);
+  if(!passed) throw Error('Production document normalization/hydration changed the declared fixture: '+JSON.stringify({actual,expected,documentContentPreserved,ownershipPreserved,roundtripPreserved}));
+  return {passed,actual,expected,documentContentPreserved,ownershipPreserved,roundtripPreserved,method:'production-normalize-and-detached-document-slice'};
+}
