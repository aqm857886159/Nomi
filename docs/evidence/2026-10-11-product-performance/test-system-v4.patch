+          confirmedExit = false;
+          throw new Error(
+            "Owned child exit unconfirmed; lock retained and queue stopped",
+          );
+        }
+        if (r.timedOut)
+          throw new Error(
+            "Native batch timed out; own children confirmed exited; queue stopped",
+          );
