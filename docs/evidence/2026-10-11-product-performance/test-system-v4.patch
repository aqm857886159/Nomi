+import {sampleSeriesIntegrity} from "./sample-series.mjs";
+import { observedAxes } from "./runtime-axes.mjs";
+import { readTraceMarkers, sampleMarkersPresent } from "./trace-markers.mjs";
+import { metricPolicyFor } from "./metric-policy.mjs";
+import fs from "node:fs";
+import path from "node:path";
+import os from "node:os";
+import {
+  hash,
+  hashFile,
+  writeJson,
+  readConfig,
+  sourceIdentity,
+  inside,
+} from "./baseline-config.mjs";
+import { completionResult } from "./import-completion.mjs";
+const finite = (n) => (typeof n === "number" && Number.isFinite(n) ? n : null);
+function guardReceipt(dir) {
+  const files = fs
+      .readdirSync(dir)
+      .filter((f) => f.endsWith(".network-guard.private.jsonl")),
+    layers = new Set(),
+    logs = [];
+  let errors = 0,
+    attempts = 0;
+  for (const f of files) {
+    let complete = false;
+    for (const line of fs
+      .readFileSync(path.join(dir, f), "utf8")
+      .split("\n")
+      .filter(Boolean)) {
+      try {
+        const e = JSON.parse(line);
+        if (e.kind === "guard-loaded") {
+          for (const l of e.layers ?? []) layers.add(l);
+          if (
+            ["fetch", "http", "https", "socket", "chromium"].every((x) =>
+              e.layers?.includes(x),
+            )
+          )
+            complete = true;
+        }
+        if (e.kind === "blocked") attempts++;
+        if (e.kind === "guard-error") errors++;
+      } catch {
+        errors++;
+      }
+    }
+    if (!complete) errors++;
+    logs.push({ name: f, sha256: hashFile(path.join(dir, f)) });
+  }
+  return {
+    networkGuardLayers: [...layers].sort(),
+    externalAttempts: files.length && errors === 0 ? attempts : null,
+    guardErrors: errors,
+    logCount: files.length,
+    logs,
+  };
+}
+export async function importBaseline(configFile, { receiptFiles = [] } = {}) {
+  const c = readConfig(configFile),
+    source = sourceIdentity(c.repoRoot),
+    resultDir = path.join(c.outputDir, "receipts");
+  fs.mkdirSync(resultDir, { recursive: true });
+  const candidate = {
+    schemaVersion: 1,
+    source,
+    environment: {
+      platform: os.platform(),
+      arch: os.arch(),
+      osVersion: os.release(),
+      hardwareClass: c.environment?.hardwareClass ?? null,
+      powerMode: c.environment?.powerMode ?? null,
+      electronVersion: null,
+      buildKind: "production-build-dev-electron",
+      viewport: { width: 1280, height: 933 },
+      displayHz: null,
+    },
+    protocol: {
+      id: "nomi-native-baseline-v3-canonical-media",
+      networkPolicy: "loopback-only",
+      traceMode: "playwright-dom-and-chromium-timeline",
+    },
+    results: [],
+    imports: [],
+    capabilityEvidence: [],
+    missingActualReceipts: receiptFiles.length === 0,
+  };
+  for (const file of receiptFiles) {
+    if (!inside(c.privateRoot, fs.realpathSync(file)))
+      throw new Error("Raw receipt is outside privateRoot");
+    const raw = JSON.parse(fs.readFileSync(file, "utf8")),
+      dir = path.dirname(file),
+      metaFile = path.join(dir, "job.private.json");
+    if (!fs.existsSync(metaFile))
+      throw new Error("Receipt lacks owned job source/fixture provenance");
+    const meta = JSON.parse(fs.readFileSync(metaFile, "utf8"));
+    const executionKind=meta.executionKind??"performance";
+    if(!["performance","functional-smoke"].includes(executionKind) || (raw.protocol.executionKind??"performance")!==executionKind) throw Error("Execution kind differs from owned job contract");
+    if(meta.batchProtocol && JSON.stringify(meta.batchProtocol)!==JSON.stringify(raw.protocol.batchProtocol)) throw Error("Batch partition provenance differs from owned job");
+    const measuredRuns=executionKind==="functional-smoke"?1:5, warmupRuns=executionKind==="functional-smoke"?0:1;
+    if(raw.protocol.runs!==measuredRuns || raw.protocol.warmup!==warmupRuns) throw Error("Repeat count differs from execution kind");
+    const actualIndex = raw.actualFixtureIndex || meta.fixtureIndex;
+    if (!inside(c.privateRoot, fs.realpathSync(actualIndex)))
+      throw new Error("Fixture provenance escapes owned privateRoot");
+    const fixtures = JSON.parse(fs.readFileSync(actualIndex, "utf8"));
+    if (
+      raw.runtime?.head !== source.commit ||
+      meta.source.commit !== source.commit ||
+      meta.source.tree !== source.tree ||
+      meta.source.dirty
+    )
+      throw new Error("Receipt source differs from current clean checkout");
+    if (
+      raw.protocol?.protocolVersion !==
+      "nomi-native-baseline-v3-canonical-media"
+    )
+      throw new Error(
+        "Unsupported measurement protocol; do not mix old batches with portable v3",
+      );
+    const guard = guardReceipt(dir),
+      traces = fs
+        .readdirSync(dir)
+        .filter((f) =>
+          /\.(chromium\.private\.json(?:\.gz)?|playwright\.private\.zip)$/.test(
+            f,
+          ),
+        )
+        .map((f) => ({
+          kind: "trace",
+          privateName: f,
+          sha256: hashFile(path.join(dir, f)),
+          bytes: fs.statSync(path.join(dir, f)).size,
+        }));
+    const markers = new Map();
+    for (const trace of traces.filter((t) =>
+      t.privateName.includes(".chromium.private.json"),
+    ))
+      for (const [name, events] of await readTraceMarkers(
+        path.join(dir, trace.privateName),
+      ))
+        markers.set(name, [...(markers.get(name) ?? []), ...events]);
+
+    for (const cell of raw.cells ?? []) {
+      if (
+        cell.scenario === "agent-concurrent-stream-canvas" &&
+        cell.status === "unsupported" &&
+        cell.reasonCode === "SINGLE_ACTIVE_LANE_BY_PRODUCT_CONTRACT"
+      ) {
+        candidate.capabilityEvidence.push({
+          scenario: cell.scenario,
+          scale: cell.alias,
+          status: "unsupported",
+          reasonCode: cell.reasonCode,
+          rawDigest: hashFile(file),
+        });
+        continue;
+      }
+      const sampleEnvironments = (cell.samples ?? [])
+        .map((s) => s.environment)
+        .filter(Boolean);
+      const compact = (e) => {
+        const { powerSnapshot, ...rest } = e ?? {};
+        return rest;
+      };
+      const env = compact(sampleEnvironments[0]);
+      if (!candidate.results.length) candidate.environment = env;
+      if (
+        sampleEnvironments.length !== (cell.samples?.length ?? 0) ||
+        sampleEnvironments.some(
+          (e) =>
+            JSON.stringify(compact(e)) !==
+            JSON.stringify(candidate.environment),
+        )
+      ) {
+        candidate.importErrors ??= [];
+        candidate.importErrors.push(
+          "Per-launch environment differs or is missing; separate comparable baselines required",
+        );
+      }
+      const f = fixtures.find((x) => x.scale === cell.alias);
+      if (!f) throw new Error("Receipt scale has no immutable fixture");
+      if (
+        (cell.fixtureVersion ?? f.fixtureVersion) !==
+          "v2-actual-media-metadata" ||
+        (cell.metadataIntegrity ?? f.metadataIntegrity)?.status !==
+          "verified" ||
+        (cell.layoutIntegrity ?? f.layoutIntegrity)?.overlapCount !== 0
+      )
+        throw new Error(
+          "Canonical fixture metadata/layout integrity missing; legacy diagnostics cannot enter v3 baseline",
+        );
