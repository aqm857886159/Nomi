new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/sample-series.mjs
@@ -0,0 +1,27 @@
+// Identity and phase are observed receipt data, never inferred from array position.
+// Position is only used to verify that observed indices form the promised sequence.
+export function sampleSeriesIntegrity(samples, {warmupRuns,measuredRuns} = {}, {raw=false,scenario} = {}) {
+  const errors=[];
+  if(!Number.isInteger(warmupRuns)||warmupRuns<0||!Number.isInteger(measuredRuns)||measuredRuns<1)
+    errors.push('invalid registered warmup/measured counts');
+  if(!Array.isArray(samples))return {status:'incomplete',errors:[...errors,'samples must be an array'],warmupSamples:0,measuredSamples:0};
+  const phases=samples.map(s=>raw ? s?.isWarmup===true?'warmup':s?.isWarmup===false?'measured':null : s?.phase);
+  const warmupSamples=phases.filter(p=>p==='warmup').length,measuredSamples=phases.filter(p=>p==='measured').length;
+  if(phases.some(p=>p!=='warmup'&&p!=='measured'))errors.push('missing or unknown sample phase');
+  if(warmupSamples!==warmupRuns)errors.push(`expected ${warmupRuns} warmup samples, got ${warmupSamples}`);
+  if(measuredSamples!==measuredRuns)errors.push(`expected ${measuredRuns} measured samples, got ${measuredSamples}`);
+  if(samples.length!==warmupRuns+measuredRuns)errors.push('unexpected total sample count');
+  for(const [position,sample] of samples.entries()) {
+    if(!Number.isInteger(sample?.index)||sample.index<0||sample.index!==position)
+      errors.push(`sample ${position}: missing, duplicate, out-of-order or discontinuous observed index`);
+    if(Number.isInteger(warmupRuns)&&phases[position] !== (position<warmupRuns?'warmup':'measured'))
+      errors.push(`sample ${position}: phase does not match registered sequence`);
+    if(!raw&&sample?.isWarmup!==undefined&&(typeof sample.isWarmup!=="boolean" || phases[position] !== (sample.isWarmup?"warmup":"measured")))
+      errors.push(`sample ${position}: phase contradicts isWarmup`);
+    if(raw&&scenario!==undefined&&sample?.state?.traceKey!=="nomi.perf:"+String(scenario).replace(/[^a-zA-Z0-9_-]/g,"_")+":"+sample?.index)
+      errors.push(`sample ${position}: trace marker identity differs from scenario/index`);
+    if(raw&&sample?.phase!==undefined&&sample.phase!==phases[position])
+      errors.push(`sample ${position}: phase contradicts isWarmup`);
+  }
+  return {status:errors.length?'incomplete':'complete',errors,warmupSamples,measuredSamples};
+}
diff --git a/scripts/quality-system/sampling-quality.mjs b/scripts/quality-system/sampling-quality.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/sampling-quality.mjs
@@ -0,0 +1,48 @@
+export function processSamplingQuality(
+  sample,
+  { intervalMs = 250, minimumCoverage = 2 / 3, maxLagMs = 500 } = {},
+) {
+  const observationMs = sample.summary?.observationMs,
+    expectedTicks =
+      Number.isFinite(observationMs) && observationMs > 0
+        ? Math.floor(observationMs / intervalMs)
+        : null;
+  const ticks = (sample.metrics ?? []).slice(1),
+    usable = ticks.filter(
+      (t) =>
+        Array.isArray(t.metrics) &&
+        t.metrics.some((m) => m.pid === sample.rendererPid) &&
+        t.metrics.some((m) => m.type === "Browser"),
+    );
+  const lags = usable.map((t) => t.samplingLagMs),
+    lagComplete = lags.every(Number.isFinite),
+    maximumLagMs = lagComplete && lags.length ? Math.max(...lags) : null,
+    actualTicks = usable.length,
+    minimumTicks =
+      expectedTicks === null
+        ? null
+        : Math.max(8, Math.ceil(expectedTicks * minimumCoverage)),
+    coverage = expectedTicks ? Math.min(1, actualTicks / expectedTicks) : null;
+  const complete =
+    minimumTicks !== null &&
+    actualTicks >= minimumTicks &&
+    maximumLagMs !== null &&
+    maximumLagMs <= maxLagMs &&
+    !ticks.some((t) => t.samplingError);
+  return {
+    status: complete ? "measured" : "inconclusive",
+    complete,
+    intervalMs,
+    observationMs: observationMs ?? null,
+    expectedTicks,
+    actualTicks,
+    minimumTicks,
+    maximumLagMs,
+    maximumAllowedLagMs: maxLagMs,
+    coverage,
+    minimumCoverage,
+    reason: complete
+      ? null
+      : "Insufficient complete renderer/main ticks, missing lag/window, sampling error, or excessive IPC sampling lag",
+  };
+}
