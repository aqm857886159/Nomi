+// Node kind/extension and ffprobe's duration do not prove a playable video.
+export function classifyHeader(bytes) {
+  if (
+    bytes.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]))
+  )
+    return "image";
+  if (bytes[0] === 255 && bytes[1] === 216 && bytes[2] === 255) return "image";
+  if (
+    bytes.toString("ascii", 0, 4) === "RIFF" &&
+    bytes.toString("ascii", 8, 12) === "WEBP"
+  )
+    return "image";
+  if (bytes.toString("ascii", 4, 8) === "ftyp") return "video";
+  if (bytes.subarray(0, 4).equals(Buffer.from([0x1a, 0x45, 0xdf, 0xa3])))
+    return "video";
+  return "unsupported";
+}
+export function validateMediaKind(bytes, kind, probe) {
+  if (classifyHeader(bytes) !== kind)
+    throw new Error("Media container/header differs from declared kind");
+  const s = probe?.streams?.[0];
+  if (!s || !(s.width > 0 && s.height > 0))
+    throw new Error("No decodable visual stream");
+  if (
+    kind === "video" &&
+    ["mjpeg", "png", "webp", "bmp", "gif"].includes(s.codec_name)
+  )
+    throw new Error("Still image does not count as video");
+  return true;
+}
