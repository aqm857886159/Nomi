+      {
+        feature: "P03",
+        actions: ["duplicate", "undo-delete", "restore"],
+        status: "source-unavailable",
+        scope: "ProjectLibraryPage exposed UI",
+        source: [
+          "src/workbench/library/ProjectLibraryPage.tsx",
+          "src/workbench/NomiStudioApp.tsx",
+          "src/workbench/project/projectRepository.ts",
+        ],
+        reason:
+          "Reviewed library controls expose rename/open/delete, deletion confirmation has no undo/restore UI. This does not claim no internal copy function exists.",
+      },
+    ],
+    journeys: c.FULL_WALK_JOURNEYS,
+    clickTargets: c.CLICK_TARGETS,
+    playbooks,
+    scenarios,
+  };
+}
+export function checkCatalog(c, repo) {
+  const errors = [];
+  const ids = new Set();
+  if (!c.features?.length || !c.scenarios?.length) errors.push("empty catalog");
+  for (const f of c.features ?? []) {
+    if (!f.actions?.length)
+      errors.push(`${f.id}: new inventory entry lacks action requirements`);
+    for (const p of f.existingScripts ?? [])
+      if (!fs.existsSync(path.join(repo, p)))
+        errors.push(`${f.id}: missing script ${p}`);
+  }
+  for (const s of c.scenarios ?? []) {
+    if (ids.has(s.id)) errors.push(`duplicate scenario ${s.id}`);
+    ids.add(s.id);
+    if (s.kind === "performance" && !s.metrics?.length)
+      errors.push(`${s.id}: no metrics`);
+  }
+  for (const id of Object.keys(FEATURE_ACTIONS))
+    if (!c.features.some((f) => f.id === id))
+      errors.push(`stale action contract ${id}`);
+  return errors;
+}
+export function executablePlan(c) {
+  return {
+    schemaVersion: 1,
+    execution: "serial-only",
+    automaticPaidExecution: false,
+    existingCommands: c.playbooks
+      .filter((p) => !p.paid)
+      .map((p) => ({
+        script: p.script,
+        variants: p.variants.map((v) => ({
+          id: v.id,
+          locale: v.locale,
+          scenarioId: v.scenarioId,
+        })),
+        runner: "node tests/ux/full-walk/run.mjs",
+        selector: `--only ${p.id}`,
+        claimsOnly:
+          "playbook scenario; action/state claims require assertion adapter",
+      })),
+    canvasCommand: "node tests/ux/canvas-performance-benchmark.e2e.mjs",
+    requiredAdapters: c.scenarios
+      .filter((s) => s.adapter === "required")
+      .map((s) => s.id),
+    blockedPaidScenarios: c.scenarios.filter((s) => s.paid).map((s) => s.id),
+  };
+}
diff --git a/scripts/quality-system/change.mjs b/scripts/quality-system/change.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/change.mjs
@@ -0,0 +1,84 @@
+import { execFileSync } from "node:child_process";
+export const productPath = (p) =>
+  (/^(src|electron|public|assets)\//.test(p) &&
+    !/(?:\.test\.|\.spec\.|\.md$)/.test(p)) ||
+  /^(package\.json|pnpm-lock\.yaml|vite\.config\.)/.test(p);
+export function changedFiles(repo, base) {
+  if (!base || base.startsWith("-"))
+    throw new Error("explicit base commit/ref required");
+  const git = (args) =>
+    execFileSync("git", args, {
+      cwd: repo,
+      encoding: "utf8",
+      maxBuffer: 16 * 1024 * 1024,
+    });
+  const sha = git(["rev-parse", "--verify", `${base}^{commit}`]).trim();
+  const head = git(["rev-parse", "HEAD"]).trim();
+  const files = git(["diff", "--name-only", "-z", sha, head, "--"])
+    .split("\0")
+    .filter(Boolean);
+  return { base: sha, head, files };
+}
+export function checkChange({ catalog, diff, impact }) {
+  const errors = [],
+    required = new Set();
+  const paths = diff.files.filter(productPath);
+  if (!paths.length)
+    return { pass: true, errors, required: [], productFiles: [] };
+  if (impact?.schemaVersion !== 1 || impact?.base !== diff.base)
+    errors.push("missing/current-base impact declaration");
+  const declarations = impact?.changes ?? [];
+  for (const file of paths) {
+    const rows = declarations.filter((x) => x.file === file);
+    if (rows.length !== 1) {
+      errors.push(`${file}: exactly one impact declaration required`);
+      continue;
+    }
+    const row = rows[0];
+    if (!["new", "changed", "refactor"].includes(row.behavior))
+      errors.push(`${file}: explicit behavior classification required`);
+    if (typeof row.reason !== "string" || row.reason.trim().length < 12)
+      errors.push(
+        `${file}: explain user-visible effect or refactor equivalence`,
+      );
+    if (
+      !row.featureIds?.length ||
+      row.featureIds.some((id) => !catalog.features.some((f) => f.id === id))
+    )
+      errors.push(`${file}: unknown/missing feature`);
+    const scenarios = (row.scenarioIds ?? []).map((id) =>
+      catalog.scenarios.find((s) => s.id === id),
+    );
+    if (!scenarios.length || scenarios.some((s) => !s))
+      errors.push(`${file}: unknown/missing scenario`);
+    for (const feature of row.featureIds ?? [])
+      for (const kind of ["functional", "performance"])
+        if (
+          !scenarios.some(
+            (s) => s?.kind === kind && s.featureIds.includes(feature),
+          )
+        )
+          errors.push(`${file}: ${feature} lacks ${kind} coverage`);
+    if (
+      row.behavior === "new" &&
+      (!row.newActionIds?.length ||
+        row.newActionIds.some(
+          (id) =>
+            !scenarios.some((s) => s?.id === id && s.kind === "functional"),
+        ))
+    )
+      errors.push(
+        `${file}: new feature must identify new functional action contracts`,
+      );
+    for (const s of scenarios) if (s) required.add(s.id);
+  }
+  for (const row of declarations)
+    if (!paths.includes(row.file))
+      errors.push(`stale/non-product declaration: ${row.file}`);
+  return {
+    pass: !errors.length,
+    errors,
+    required: [...required].sort(),
+    productFiles: paths,
+  };
+}
diff --git a/scripts/quality-system/cli.mjs b/scripts/quality-system/cli.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/cli.mjs
@@ -0,0 +1,142 @@
+#!/usr/bin/env node
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { loadCatalog, checkCatalog, executablePlan } from "./catalog.mjs";
+import { evaluate } from "./gate.mjs";
+import { changedFiles, checkChange } from "./change.mjs";
+const args = process.argv.slice(2),
+  command = args.shift(),
+  options = {};
+try {
+  for (let i = 0; i < args.length; i += 2) {
+    if (
+      !/^--[a-z-]+$/.test(args[i]) ||
+      !args[i + 1] ||
+      args[i + 1].startsWith("--")
+    )
+      throw new Error("options require --name value");
+    options[args[i].slice(2)] = args[i + 1];
+  }
+  const allowed = [
+    "repo",
+    "out",
+    "candidate",
+    "baseline",
+    "evidence-root",
+    "baseline-evidence-root",
+    "base",
+    "impact",
+    "scope",
+  ];
+  for (const k of Object.keys(options))
+    if (!allowed.includes(k)) throw new Error(`unknown option ${k}`);
+  const repo = path.resolve(
+    options.repo ??
+      path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../.."),
+  );
+  const read = (p) => JSON.parse(fs.readFileSync(path.resolve(p), "utf8"));
+  const catalog = await loadCatalog(repo),
+    catalogErrors = checkCatalog(catalog, repo);
+  let report;
+  if (command === "catalog")
+    report = {
+      ...catalog,
+      structuralErrors: catalogErrors,
+      claim: "registration only; product coverage remains unverified",
+    };
+  else if (command === "plan") report = executablePlan(catalog);
+  else if (command === "check")
+    report = {
+      pass: catalogErrors.length === 0,
+      errors: catalogErrors,
+      counts: {
+        features: catalog.features.length,
+        journeys: catalog.journeys.length,
+        clickTargets: catalog.clickTargets.length,
+        scenarios: catalog.scenarios.length,
+      },
+      claim: "structure valid, not product acceptance",
+    };
+  else if (command === "change") {
+    const diff = changedFiles(repo, options.base);
+    report = checkChange({
+      catalog,
+      diff,
+      impact: options.impact ? read(options.impact) : null,
+    });
+    report.source = diff.head;
+  } else if (command === "gate") {
+    if (!options.candidate) throw new Error("--candidate is required");
+    if (!["full", "change"].includes(options.scope ?? "full"))
+      throw new Error("--scope must be full or change");
+    let scenarioIds = null;
+    let change = null;
+    if (options.scope === "change") {
+      const diff = changedFiles(repo, options.base);
+      change = checkChange({
+        catalog,
+        diff,
+        impact: options.impact ? read(options.impact) : null,
+      });
+      if (!change.pass) throw new Error(change.errors.join("\n"));
+      if (!change.required.length)
+        throw new Error(
+          "no product change; use check, not empty acceptance gate",
+        );
+      scenarioIds = change.required;
+    }
+    const candidate = read(options.candidate);
+    report = evaluate({
+      catalog,
+      candidate,
+      baseline: options.baseline ? read(options.baseline) : null,
+      scenarioIds,
+      evidenceRoot: path.resolve(
+        options["evidence-root"] ?? path.dirname(options.candidate),
+      ),
+      baselineEvidenceRoot: path.resolve(
+        options["baseline-evidence-root"] ??
+          path.dirname(options.baseline ?? options.candidate),
+      ),
+    });
+    if (
+      candidate.source?.commit !== changeFilesHead(repo, options.base ?? "HEAD")
+    ) {
+      report.pass = false;
+      report.errors.push("candidate receipt does not match current HEAD");
+    }
+    if (catalogErrors.length) {
+      report.pass = false;
+      report.errors.push(...catalogErrors);
+    }
+  } else throw new Error("commands: check | catalog | plan | change | gate");
+  if (options.out) {
+    fs.mkdirSync(path.dirname(path.resolve(options.out)), { recursive: true });
+    fs.writeFileSync(options.out, JSON.stringify(report, null, 2) + "\n");
+  }
+  const output =
+    command === "catalog"
+      ? {
+          features: report.features.length,
+          scenarios: report.scenarios.length,
+          structuralErrors: report.structuralErrors,
+          claim: report.claim,
+        }
+      : command === "gate"
+        ? {
+            pass: report.pass,
+            scope: report.scope,
+            counts: report.counts,
+            errors: report.errors,
+          }
+        : report;
+  console.log(JSON.stringify(output, null, 2));
+  if (report.pass === false || catalogErrors.length) process.exitCode = 1;
+} catch (error) {
+  console.error(`quality-system: ${error.message}`);
+  process.exitCode = 2;
+}
+function changeFilesHead(repo, base) {
+  return changedFiles(repo, base).head;
+}
