+  const ffmpeg = require("@ffmpeg-installer/ffmpeg").path,
+    ffprobe = require("@ffprobe-installer/ffprobe").path;
+  const media = [],
+    sources = [];
+  const probe = (file) =>
+    JSON.parse(
+      execFileSync(
+        ffprobe,
+        [
+          "-v",
+          "error",
+          "-select_streams",
+          "v:0",
+          "-show_entries",
+          "stream=width,height,codec_name:format=duration",
+          "-of",
+          "json",
+          file,
+        ],
+        { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] },
+      ),
+    );
+  const copy = (file, name, kind, id) => {
+    const before = hashFile(file),
+      dest = path.join(mediaDir, name);
+    fs.copyFileSync(file, dest);
+    if (hashFile(dest) !== before || hashFile(file) !== before)
+      throw new Error("Source or copy changed");
+    sources.push({ file, sha256: before });
+    media.push({
+      file: dest,
+      kind,
+      sourceId: id,
+      sha256: before,
+      bytes: fs.statSync(dest).size,
+      stream: probe(dest).streams[0],
+    });
+  };
+  let provenance;
+  if (c.media?.kind === "local") {
+    provenance = "explicit-local-media-copy";
+    for (const [i, file] of c.media.files.entries()) {
+      const ext = path.extname(file).toLowerCase(),
+        kind = /^\.(png|jpe?g|webp)$/.test(ext)
+          ? "image"
+          : /^\.(mp4|mov|webm|m4v)$/.test(ext)
+            ? "video"
+            : null;
+      if (!kind) throw new Error("Unsupported local asset type");
+      if (fs.lstatSync(file).isSymbolicLink() || !fs.statSync(file).isFile())
+        throw new Error("Local media must be regular files");
+      copy(file, `${kind}-${i}${ext}`, kind, `local-asset-${i}`);
+    }
+  } else {
+    provenance = "registered-public-repository-media";
+    const registry = JSON.parse(
+      fs.readFileSync(
+        path.join(c.repoRoot, "tests/ux/real-media-fixtures.json"),
+        "utf8",
+      ),
+    );
+    const registered = (id) => {
+      const a = registry.assets.find((x) => x.id === id);
+      if (!a?.repoPath || path.isAbsolute(a.repoPath))
+        throw new Error("Public registered asset missing");
+      const p = fs.realpathSync(path.join(c.repoRoot, a.repoPath));
+      if (!inside(c.repoRoot, p))
+        throw new Error("Registered asset escapes checkout");
+      return p;
+    };
+    const frameSource = registered("video-ai-shot-640x360"),
+      videoSource = registered("video-canvas-follow-hand-1080p15");
+    sources.push({ file: frameSource, sha256: hashFile(frameSource) });
+    for (const [i, at] of [0.5, 1.3].entries()) {
+      const file = path.join(mediaDir, `image-${i}.png`);
