+test('native import binds each trace key to actual scenario and sample index',()=>{
+ const raw=samples(1,5).map(s=>({...s,state:{traceKey:'nomi.perf:canvas-pan:'+s.index}}));
+ assert.equal(sampleSeriesIntegrity(raw,{warmupRuns:1,measuredRuns:5},{raw:true,scenario:'canvas-pan'}).status,'complete');
+ raw[2].state.traceKey=raw[1].state.traceKey;
