+      expectedAxes: condition.values,
+      coverageState: "unverified",
+      requiredAssertions: [
+        "project-open",
+        "document-switch",
+        "group-drag",
+        "clip-select",
+        "agent-switch",
+      ],
+    });
+  const playbooks = c.FULL_WALK_PLAYBOOKS.map((p) => ({
+    ...p,
+    variants: p.variants.map((v) => ({
+      ...v,
+      scenarioId: `playbook:${p.id}:${v.id}:${v.locale}`,
+    })),
+  }));
+  for (const p of playbooks)
+    for (const v of p.variants)
+      scenarios.push({
+        id: v.scenarioId,
+        kind: "functional",
+        featureIds: features
+          .filter((f) => f.existingScripts.includes(p.script))
+          .map((f) => f.id),
+        script: p.script,
+        variant: v.id,
+        locale: v.locale,
