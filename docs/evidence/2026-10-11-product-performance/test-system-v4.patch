+const here = path.dirname(fileURLToPath(import.meta.url));
+export async function prepareBaseline(configFile) {
+  const c = readConfig(configFile),
+    require = createRequire(path.join(c.repoRoot, "package.json"));
+  if (fs.existsSync(c.fixtureIndex))
+    throw new Error(
+      "Fixture index already exists; choose a new privateRoot to preserve immutable seeds",
+    );
