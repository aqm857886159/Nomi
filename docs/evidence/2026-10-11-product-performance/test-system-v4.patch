+    fs.writeFileSync(path.join(projectRoot, "video.mp4"), "ownedvideo");
+    fs.writeFileSync(path.join(projectRoot, "thumb.jpg"), "ownedthumb");
+    const url = (n) => `nomi-local://asset/project/${n}`;
+    const record = {
+      id: "project",
+      payload: {
+        generationCanvas: {
+          nodes: [
+            {
+              kind: "video",
+              id: "video",
+              meta: { videoWidth: 1280, videoHeight: 720 },
+              result: {
+                type: "video",
+                url: url("video.mp4"),
+                thumbnailUrl: url("thumb.jpg"),
+              },
+              history: [{ type: "video", url: url("video.mp4") }],
+            },
+          ],
+        },
+      },
+    };
+    let calls = 0;
+    const inspect = (_file, kind) => {
+      calls++;
+      return {
+        kind,
+        sha256: kind === "video" ? "a".repeat(64) : "b".repeat(64),
+        width: 576,
+        height: 1024,
+        durationSeconds: 15.8,
+      };
+    };
+    const r = correctFixtureMedia(record, { projectRoot, inspect });
+    assert.equal(r.nodesChecked, 1);
+    assert.equal(r.resultsChecked, 2);
+    assert.equal(r.thumbnailsChecked, 1);
+    assert.equal(calls, 3);
+    const node = record.payload.generationCanvas.nodes[0];
+    assert.equal(node.meta.videoAspectRatio, 576 / 1024);
+    assert.equal(node.meta.videoDuration, 15.8);
+    assert.equal(node.history[0].durationSeconds, 15.8);
+    assert.notEqual(r.beforePayloadDigest, r.afterPayloadDigest);
+    assert.equal(
+      fs.readFileSync(path.join(projectRoot, "video.mp4"), "utf8"),
+      "ownedvideo",
+    );
+    assert.throws(
