+import test from "node:test";
+import assert from "node:assert/strict";
+import { ProviderBudget, prepareProviderPlan, providerContractDigest, validateProviderContract, validateProviderReceipt, worstCaseBudgetCost } from "../../scripts/quality-system/real-provider.mjs";
+import { checkRun } from "../../scripts/quality-system/gate.mjs";
+const hash = "a".repeat(64);
+const contract = () => ({version:"real-provider-bounded-v1", provider:"test-provider",model:"test-model",authorization:{humanApproved:true,receiptSha256:hash,approvedAt:"2026-10-11T00:00:00Z"},currency:"CNY",priceCurrency:"CNY",maxCostMicrounits:10000000,maxRequests:3,maxConcurrency:1,requestTimeoutMs:10000,priceScheduleSha256:hash,costReservation:"worst-case-before-dispatch",mediaPolicy:"public-or-synthetic-only",credentialsPolicy:"runtime-secret-no-logs",endpoints:[{origin:"https://test.example",method:"POST",path:"/v1/generate"}]});
+test("real provider preparation does not dispatch and missing exact model or budget blocks",()=>{
+  assert.equal(prepareProviderPlan(contract()).requestsSent,0);
+  for(const field of ["model","maxCostMicrounits","priceScheduleSha256","authorization"]){ const c=contract(); delete c[field]; assert.match(prepareProviderPlan(c).status,/blocked/); }
+  const c=contract(); c.endpoints[0].path="/*"; assert.ok(validateProviderContract(c).length);
+  const extra={...contract(),apiKey:"synthetic-secret-only"}; const result=prepareProviderPlan(extra);
+  assert.match(result.status,/blocked/); assert.equal(JSON.stringify(result).includes(extra.apiKey),false);
+});
+test("CNY ten-yuan ledger reserves worst-case before dispatch and unknown cancelled cost stays held",()=>{
+  const b=new ProviderBudget(contract());
+  b.reserve({requestId:"r1",maximumCostMicrounits:6000000});
+  assert.throws(()=>b.reserve({requestId:"r2",maximumCostMicrounits:1}),/concurrency/);
+  b.settle("r1"); // cancellation or failure without bill is not free
+  assert.equal(b.snapshot().unresolvedReservedMicrounits,6000000);
+  assert.throws(()=>b.reserve({requestId:"r2",maximumCostMicrounits:5000000}),/budget/);
+  b.reserve({requestId:"r2",maximumCostMicrounits:4000000});
+  b.settle("r2",{actualCostMicrounits:3000000,billingReceiptSha256:hash});
+  assert.equal(b.snapshot().actualBilledMicrounits,3000000);
+  assert.equal(b.snapshot().billingComplete,false);
+});
+test("unreceipted estimate cannot become billed actual and upper-bound breach stops queue",()=>{
+  const b=new ProviderBudget(contract()); b.reserve({requestId:"r1",maximumCostMicrounits:100});
+  assert.throws(()=>b.settle("r1",{actualCostMicrounits:50}),/billing receipt/);
+  b.settle("r1",{actualCostMicrounits:101,billingReceiptSha256:hash});
+  assert.equal(b.snapshot().stopped,true);
+  assert.throws(()=>b.reserve({requestId:"r2",maximumCostMicrounits:1}),/stopped/);
+});
+test("USD pricing cannot consume CNY budget without verified buffered conversion",()=>{
+  const c=contract(); c.priceCurrency="USD"; assert.ok(validateProviderContract(c).length);
+  c.fx={sourceReceiptSha256:hash,rate:7,bufferMultiplier:1.1,observedAt:"2026-10-11T00:00:00Z"};
+  assert.deepEqual(validateProviderContract(c),[]);
+  assert.ok(worstCaseBudgetCost(c,1000000)>=7700000);
+});
+test("real-provider gate has bounded receipt branch and cannot waive egress or caps",()=>{
+  const c=contract(), receipt={contractDigest:providerContractDigest(c),observedMaxConcurrency:1,blockedEgressAttempts:0,guardErrors:0,egressReceiptSha256:hash,requests:[{requestId:"r1",maximumCostMicrounits:500,state:"settled",actualCostMicrounits:null,billingReceiptSha256:null,reservedBeforeDispatch:true,publicOrSyntheticPayload:true}]};
+  assert.deepEqual(validateProviderReceipt(c,receipt),[]);
+  assert.ok(validateProviderReceipt(c,{...receipt,blockedEgressAttempts:1}).length);
+  assert.ok(validateProviderReceipt(c,{...receipt,observedMaxConcurrency:2}).length);
+  const errors=checkRun({protocol:{networkPolicy:"real-provider-bounded",realProvider:c},providerReceipt:receipt});
+  assert.equal(errors.includes("unapproved network policy"),false);
+  assert.ok(checkRun({protocol:{networkPolicy:"real-provider-bounded",realProvider:c}}).includes("missing provider dispatch ledger"));
+});
