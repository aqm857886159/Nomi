+        ],
+        { stdio: ["ignore", "pipe", "pipe"] },
+      );
+      media.push({
+        file,
+        kind: "image",
+        sourceId: "image-ai-shot-frame-png",
+        sha256: hashFile(file),
+        bytes: fs.statSync(file).size,
+        stream: probe(file).streams[0],
+      });
+    }
+    copy(
+      videoSource,
+      "video-0.mp4",
+      "video",
+      "video-canvas-follow-hand-1080p15",
+    );
+  }
+  if (
+    !media.some((x) => x.kind === "image") ||
+    !media.some((x) => x.kind === "video")
+  )
+    throw new Error("Image and video are required; no synthetic fallback");
+  for (const m of media) {
+    const b = Buffer.alloc(16),
+      fd = fs.openSync(m.file, "r");
+    try {
+      fs.readSync(fd, b, 0, 16, 0);
+    } finally {
+      fs.closeSync(fd);
+    }
+    validateMediaKind(b, m.kind, { streams: [m.stream] });
+    execFileSync(
+      ffmpeg,
+      [
+        "-v",
+        "error",
+        "-threads",
+        "1",
+        "-i",
+        m.file,
+        "-frames:v",
+        "1",
+        "-threads",
+        "1",
+        "-f",
+        "null",
+        "-",
+      ],
+      { stdio: ["ignore", "pipe", "pipe"] },
+    );
+  }
+  const unique = [...new Map(media.map((m) => [m.sha256, m])).values()],
+    images = unique.filter((x) => x.kind === "image"),
+    videos = unique.filter((x) => x.kind === "video");
+  const mediaManifest = unique.map(({ file, stream, ...m }) => ({
