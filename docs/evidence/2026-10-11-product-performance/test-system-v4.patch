+    const cells = plan.cells.map((x) => ({
+      ...x,
+      status:
+        actual.get(`${x.executionKind==="functional-smoke"?"smoke":"perf"}:${x.scenario}:${x.scale}:${x.cache}`)?.receiptStatus ??
+        "unverified",
+    }));
+    const summary = {
+      schemaVersion: 1,
+      jobs,
+      cells,
+      sourceIntegrity: integrity,
+      allPlannedReceiptsCollected: cells.every((x) => x.status === "collected"),
+      completeProductCoverage: false,
+      mandatoryMissing: plan.mandatoryMissing,
+    };
+    publicWrite("run-summary.json", summary);
+    if (
+      !summary.allPlannedReceiptsCollected ||
+      jobs.some((j) => j.exitCode !== 0)
+    )
+      process.exitCode = 1;
+  } else
+    throw new Error(
+      "Usage: baseline.mjs prepare|list|dry-run|run|import --config FILE [--suites open,workflow,reopen,groups,agent,timeline] [--scales small,typical,heavy] [--receipts RAW1,RAW2]",
+    );
+} catch (e) {
+  publicWrite("blocked.json", {
+    status: "blocked",
+    errorType: e.name,
+    code: "BASELINE_EXECUTION_INCOMPLETE",
