+export const TEXT_GAP_FEATURES=Object.fromEntries([...FORMAT_SCENES.map(x=>[x,'P04']),...Object.entries(UI_TEXT_GROUPS).flatMap(([group,ids])=>ids.map(x=>[x,group==='document-gaps'?'P04':group==='storyboard'?'P05':'UI_PROMPT_LIBRARY'])),...TASK_RECOVERY_SCENES.map(x=>[x,'P33'])]);
diff --git a/scripts/quality-system/trace-markers.mjs b/scripts/quality-system/trace-markers.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/trace-markers.mjs
@@ -0,0 +1,240 @@
+import fs from "node:fs";
+import { createGunzip } from "node:zlib";
+import { StringDecoder } from "node:string_decoder";
+// Incremental JSON grammar validation: bounded strings/tokens, never JSON.parse a large trace.
+export class TraceJsonCollector {
+  constructor() {
+    this.stack = [];
+    this.root = "value";
+    this.mode = "normal";
+    this.token = "";
+    this.escape = false;
+    this.unicode = 0;
+    this.markers = new Map();
+    this.markerCount = 0;
+    this.sawEvents = false;
+    this.maxRetainedToken = 0;
+  }
+  fail() {
+    throw new Error("Invalid or truncated Chromium trace JSON");
+  }
+  top() {
+    return this.stack.at(-1);
+  }
+  value(type, value) {
+    const p = this.top();
+    let eventArray = false,
+      eventObject = false;
+    if (!p) {
+      if (this.root !== "value") this.fail();
+      this.root = "done";
+      eventArray = type === "array";
+    } else if (p.kind === "array") {
+      if (!["value", "valueOrEnd"].includes(p.state)) this.fail();
+      p.state = "commaOrEnd";
+      eventObject = p.events && type === "object";
+    } else {
+      if (p.state !== "value") this.fail();
+      eventArray =
+        this.stack.length === 1 && p.key === "traceEvents" && type === "array";
+      if (p.event && ["name", "pid", "tid", "ts", "ph"].includes(p.key)) {
+        p.fields ??= {};
+        p.fields[p.key] = value;
+      }
+      p.state = "commaOrEnd";
+    }
+    if (type === "array" || type === "object") {
+      if (this.stack.length >= 128) this.fail();
+      this.stack.push({
+        kind: type,
+        state: type === "array" ? "valueOrEnd" : "keyOrEnd",
+        events: eventArray,
+        event: eventObject,
+        key: null,
+      });
+      if (eventArray) this.sawEvents = true;
+    }
+  }
+  string(value) {
+    const p = this.top();
+    if (p?.kind === "object" && ["key", "keyOrEnd"].includes(p.state)) {
+      p.key = value;
+      p.state = "colon";
+    } else this.value("string", value);
+  }
+  punct(c) {
+    const p = this.top();
+    if (c === "{" || c === "[") {
+      this.value(c === "{" ? "object" : "array");
+      return;
+    }
+    if (c === "}" || c === "]") {
+      if (
+        !p ||
+        p.kind !== (c === "}" ? "object" : "array") ||
+        !["commaOrEnd", c === "}" ? "keyOrEnd" : "valueOrEnd"].includes(p.state)
+      )
+        this.fail();
+      if (
+        p.event &&
+        /^nomi\.perf:[A-Za-z0-9_-]+:\d+:(input|visible-state|action-end|observation-end)$/.test(
+          p.fields?.name ?? "",
+        )
+      ) {
+        const f = p.fields;
+        if (
+          !Number.isFinite(f.ts) ||
+          f.ts < 0 ||
+          !Number.isInteger(f.pid) ||
+          f.pid < 0 ||
+          !Number.isInteger(f.tid) ||
+          f.tid < 0 ||
+          !["R", "I", "i", "X", "B", "E", "b", "e", "n"].includes(f.ph)
+        )
+          this.fail();
+        this.markers.set(f.name, [...(this.markers.get(f.name) ?? []), { pid: f.pid, tid: f.tid, ts: f.ts, ph: f.ph }]);
+        if (++this.markerCount > 200000) this.fail();
+      }
+      this.stack.pop();
+      return;
+    }
+    if (c === ",") {
+      if (!p || p.state !== "commaOrEnd") this.fail();
+      p.state = p.kind === "object" ? "key" : "value";
+      return;
+    }
+    if (c === ":") {
+      if (p?.kind !== "object" || p.state !== "colon") this.fail();
+      p.state = "value";
+      return;
+    }
+    this.fail();
+  }
+  retain(c) {
+    if (this.token !== null) {
+      if (this.token.length + c.length <= 512) this.token += c;
+      else this.token = null;
+      this.maxRetainedToken = Math.max(
+        this.maxRetainedToken,
+        this.token?.length ?? 512,
+      );
+    }
+  }
+  finishPrimitive() {
+    if (this.mode === "number") {
+      if (!/^-?(0|[1-9]\d*)(\.\d+)?([eE][+-]?\d+)?$/.test(this.token))
+        this.fail();
+      this.value("number", Number(this.token));
+    } else if (this.mode === "literal") {
+      if (!["true", "false", "null"].includes(this.token)) this.fail();
+      this.value("literal");
+    } else this.fail();
+    this.mode = "normal";
+    this.token = "";
+  }
+  write(text) {
+    for (let i = 0; i < text.length; i++) {
+      const c = text[i];
+      if (this.mode === "string") {
+        if (this.unicode) {
+          if (!/[0-9a-fA-F]/.test(c)) this.fail();
+          this.retain(c);
+          this.unicode--;
+          continue;
+        }
+        if (this.escape) {
+          if (!'"\\/bfnrtu'.includes(c)) this.fail();
+          this.retain(c);
+          this.escape = false;
+          if (c === "u") this.unicode = 4;
+          continue;
+        }
+        if (c === "\\") {
+          this.retain(c);
+          this.escape = true;
+          continue;
+        }
+        if (c === '"') {
+          let value = null;
+          if (this.token !== null) {
+            try {
+              value = JSON.parse('"' + this.token + '"');
+            } catch {
+              this.fail();
+            }
+          }
+          this.mode = "normal";
+          this.string(value);
+          this.token = "";
+          continue;
+        }
+        if (c.charCodeAt(0) < 32) this.fail();
+        this.retain(c);
+        continue;
+      }
+      if (this.mode === "number" || this.mode === "literal") {
+        if (/[\s,\]}:]/.test(c)) {
+          this.finishPrimitive();
+          i--;
+          continue;
+        }
+        this.token += c;
+        if (this.token.length > 128) this.fail();
+        continue;
+      }
+      if (/\s/.test(c)) {
+        if (![" ", "\n", "\r", "\t"].includes(c)) this.fail();
+        continue;
+      }
+      if (c === '"') {
+        this.mode = "string";
+        this.token = "";
+        continue;
+      }
+      if (c === "-" || /[0-9]/.test(c)) {
+        this.mode = "number";
+        this.token = c;
+        continue;
+      }
+      if (/[tfn]/.test(c)) {
+        this.mode = "literal";
+        this.token = c;
+        continue;
+      }
+      this.punct(c);
+    }
+  }
+  finish() {
+    if (["number", "literal"].includes(this.mode)) this.finishPrimitive();
+    if (
+      this.mode !== "normal" ||
+      this.stack.length ||
+      this.root !== "done" ||
+      !this.sawEvents
+    )
+      this.fail();
+    return this.markers;
+  }
+}
+export async function readTraceMarkers(file) {
+  const stream = file.endsWith(".gz")
+    ? fs.createReadStream(file).pipe(createGunzip())
+    : fs.createReadStream(file);
+  const parser = new TraceJsonCollector(),
+    decoder = new StringDecoder("utf8");
+  for await (const b of stream) parser.write(decoder.write(b));
+  parser.write(decoder.end());
+  return parser.finish();
+}
+export function sampleMarkersPresent(sample, markers) {
+  const key = sample.state?.traceKey;
+  if (typeof key !== "string" || !Number.isFinite(sample.state?.timeOrigin) || !(markers instanceof Map)) return false;
+  const rows = ["input", "visible-state", "action-end", "observation-end"].map(suffix => markers.get(key + ":" + suffix));
+  // A unique four-event sequence must originate from one renderer thread. Visibility
+  // may precede the gesture ending or follow it, but both occur within observation.
+  if (rows.some(row => !Array.isArray(row) || row.length !== 1)) return false;
+  const [input, visible, action, end] = rows.map(row => row[0]);
+  return [visible, action, end].every(e => e.pid === input.pid && e.tid === input.tid) &&
+    input.ts <= visible.ts && visible.ts <= end.ts &&
+    input.ts <= action.ts && action.ts <= end.ts;
+}
diff --git a/tests/quality-system/axes.test.mjs b/tests/quality-system/axes.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/quality-system/axes.test.mjs
@@ -0,0 +1,53 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  AXES,
+  BASE_AXES,
+  dimensionCases,
+  pairwiseCases,
+  sameAxes,
+} from "../../scripts/quality-system/axes.mjs";
+import { importFullWalk } from "../../scripts/quality-system/import-full-walk.mjs";
+test("document and clip heavy loads cannot be confused with old empty fixture", () => {
+  assert.equal(AXES.documents.heavy, 160);
+  assert.equal(AXES.clips.heavy, 160);
+  assert.equal(
+    sameAxes({ ...BASE_AXES, clips: 160 }, { ...BASE_AXES, clips: 0 }),
+    false,
+  );
+});
+test("workspace is categorical; library projects and session counts are independent", () => {
+  assert.deepEqual(Object.keys(AXES.workspace), [
+    "creation",
+    "storyboard",
+    "generation",
+    "preview",
+  ]);
+  assert.equal(AXES.libraryProjects.heavy, 401);
+  assert.equal(AXES.agentSessions.heavy, 10);
+});
+test("each scale is explicit and all-heavy is retained", () => {
+  const c = dimensionCases(["documents", "clips"]);
+  assert.equal(c.length, 7);
+  assert.deepEqual(
+    c.find((x) => x.label === "all-heavy").values.documents,
+    160,
+  );
+  assert.equal(c.find((x) => x.label === "all-heavy").values.clips, 160);
+});
+test("impossible node/media pairs have reasons instead of successful skips", () => {
+  const { cases, excluded } = pairwiseCases(["nodes", "imageVideo"]);
+  assert.equal(cases.length, 6);
+  assert.equal(excluded.length, 3);
+  assert.ok(excluded.every((e) => e.reason));
+});
+test("missing actual axes never match a declared heavy case", () =>
+  assert.equal(sameAxes(BASE_AXES, {}), false));
+test("full-walk import refuses a different source commit", () =>
+  assert.throws(() =>
+    importFullWalk(
+      { head: "123456789", dirty: false, runs: [] },
+      { source: { commit: "b".repeat(40) } },
+      { path: "x", sha256: "a".repeat(64) },
+    ),
+  ));
diff --git a/tests/quality-system/baseline/agent-completion.mjs b/tests/quality-system/baseline/agent-completion.mjs
new file mode 100644
--- /dev/null
+++ b/tests/quality-system/baseline/agent-completion.mjs
@@ -0,0 +1,1449 @@
+import { readConfig, cloneOwned } from "../../../scripts/quality-system/baseline-config.mjs";
+const config=readConfig();
