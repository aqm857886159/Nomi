+name: Product native baseline
+on:
+  workflow_dispatch:
+    inputs:
+      suites:
+        description: Comma-separated suites; all listed suites run serially on the desktop
+        default: open,workflow,reopen,groups,agent,timeline,extended,group-controls,group-integrity,group-frame,group-membership,group-connections,group-delivery,group-generation,group-legacy
+        required: true
+      scales:
+        description: Comma-separated scales
+        default: small,typical,heavy
+        required: true
+permissions:
+  contents: read
+concurrency:
+  group: nomi-native-display
+  cancel-in-progress: false
+jobs:
+  native:
+    # Requires a logged-in real desktop session. Do not redirect this job to a headless runner.
+    runs-on: [self-hosted, macOS, nomi-native-display]
+    timeout-minutes: 360
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 10.8.1
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+      - run: pnpm install --frozen-lockfile
+      - run: pnpm build
+      - name: Prepare explicit isolated paths and public repository media
+        run: |
+          node --input-type=module <<'NODE'
+          import fs from 'node:fs'; import path from 'node:path'; import os from 'node:os';
+          const root=path.join(process.env.RUNNER_TEMP,`nomi-quality-${process.env.GITHUB_RUN_ID}-${process.env.GITHUB_RUN_ATTEMPT}`);
+          fs.mkdirSync(root,{recursive:true});
+          fs.writeFileSync(path.join(root,'config.json'),JSON.stringify({repoRoot:process.cwd(),privateRoot:path.join(root,'private'),fixtureIndex:path.join(root,'private/fixtures.private.json'),outputDir:path.join(root,'public'),media:{kind:'repository'},environment:{hardwareClass:`${os.arch()} ${os.cpus()[0]?.model}`}}));
+          fs.appendFileSync(process.env.GITHUB_ENV,`NOMI_QUALITY_CONFIG=${path.join(root,'config.json')}\nNOMI_QUALITY_ROOT=${root}\n`);
+          NODE
+          node scripts/quality-system/baseline.mjs prepare
+      - name: Enumerate exact cells before native launch
+        env:
+          SUITES: ${{ inputs.suites }}
+          SCALES: ${{ inputs.scales }}
+        run: node scripts/quality-system/baseline.mjs dry-run --suites "$SUITES" --scales "$SCALES"
+      - name: Run real user actions and import receipts
+        env:
+          SUITES: ${{ inputs.suites }}
+          SCALES: ${{ inputs.scales }}
+        run: node scripts/quality-system/baseline.mjs run --suites "$SUITES" --scales "$SCALES"
+      - name: Evaluate complete-product contract (uncovered cases remain red)
+        if: always()
+        run: node scripts/quality-system/cli.mjs gate --candidate "$NOMI_QUALITY_ROOT/public/candidate.json" --evidence-root "$NOMI_QUALITY_ROOT/private" --out "$NOMI_QUALITY_ROOT/public/full-gate.json"
+      # Raw traces/settings/fixtures remain local. This workflow does not upload any artifact.
+      # Add a matched --baseline/--baseline-evidence-root only after approving measured baseline conditions.
