+      } catch (e) {
+        if (e.status === 1) return [];
+        throw e;
+      }
+    },
+    stamp = birthStamp,
+    expectedStart,
+  } = {},
+) {
+  if(expectedStart!==undefined && !sameStamp(stamp(pid),expectedStart)) return {status:"unavailable",reason:"OWNER_IDENTITY_UNCONFIRMED",count:0};
