+      ? tracks.reduce((n, t) => n + (t.clips?.length ?? 0), 0) +
+        (p.timeline.textClips?.length ?? 0)
+      : null,
+  };
+}
+// Read the production internal workspace identity, not the presentation-only stepper.
+// WorkbenchShell binds this attribute directly to store.workspaceMode.
+export function readWorkspaceIdentity() {
+  const shells=[...document.querySelectorAll('.workbench-shell[data-workspace-mode]')].filter(e=>e.getClientRects().length>0);
+  const shell=shells.length===1?shells[0]:null, mode=shell?.getAttribute('data-workspace-mode')??null;
+  return {title:shell?.querySelector('[data-shell-project-menu]')?.getAttribute('title')??null,
+    workspace:['creation','storyboard','generation','preview'].includes(mode)?mode:null,
+    workspaceSource:'WorkbenchShell.data-workspace-mode',visibleShellCount:shells.length};
+}
+export async function captureRuntimeAxes(instance, config) {
+  const result = {
+    status: "incomplete",
+    libraryProjects: null,
+    libraryLaunch: null,
+    workspace: null,
+    manifest: null,
+    sessionHistory: null,
+    activeStreams: null,
+  };
+  try {
+    const registryPath = path.join(
+      instance.profile,
+      "settings/recent-workspaces.json",
+    );
+    if (!inside(config.ownershipRoot, fs.realpathSync(registryPath)))
+      return result;
+    const registry = JSON.parse(fs.readFileSync(registryPath, "utf8"));
+    if (!Array.isArray(registry)) return result;
+    result.libraryProjects = registry.length;
+    result.libraryLaunch = instance.libraryAxisReceipt ?? null;
+    const ui = await instance.win.evaluate(readWorkspaceIdentity);
+    result.workspace=ui.workspace;
+    result.workspaceObservation={source:ui.workspaceSource,visibleShellCount:ui.visibleShellCount};
+    const entry = registry.find((r) => r.name === ui.title);
+    if (entry) {
+      const file = fs.realpathSync(
+        path.join(entry.rootPath, ".nomi/project.json"),
+      );
+      if (!inside(config.ownershipRoot, file)) return result;
+      const record = JSON.parse(fs.readFileSync(file, "utf8"));
+      result.manifest = manifestAxes(record);
+      result.manifestDigest = hash(JSON.stringify(record.payload));
+      const { readLaneTranscripts } = await import(
+        pathToFileURL(
+          path.join(config.repoRoot, "tests/ux/agent-lane-observer.mjs"),
+        )
+      );
+      const transcripts=readLaneTranscripts(entry.rootPath);
+      result.sessionHistory = transcripts.length;
+      const snapshot=await instance.win.evaluate(()=>window.__qualityLaneObservation?.snapshot??null);
+      result.activeStreamObservation=idleStreamObservation(snapshot,transcripts);
+      result.activeStreams=result.activeStreamObservation.activeStreams;
+    }
+    if (instance.agentAxisProbe) {
+      const agent = await instance.agentAxisProbe();
+      result.activeStreams = Number.isInteger(agent.activeStreams)
+        ? agent.activeStreams
+        : null;
+      result.activeStreamObservation={source:"loopback-provider-live-set",activeStreams:result.activeStreams};
+      result.sessionHistory = Number.isInteger(agent.sessionHistory)
+        ? agent.sessionHistory
+        : result.sessionHistory;
+    }
+    result.status =
+      result.manifest &&
+      result.workspace &&
+      result.libraryLaunch &&
+      result.sessionHistory !== null &&
+      result.activeStreams !== null
+        ? "observed"
+        : "incomplete";
+  } catch {
+    result.status = "incomplete";
+  }
+  return result;
+}
+export function observedAxes(fixture, cell) {
+  const observations = (cell.samples ?? [])
+    .filter((s) => !s.isWarmup)
+    .map((s) => {
+      const pair = s.axisObservations ?? {},
+        pre = pair.before ?? {},
+        post = pair.after ?? {},
+        targetTransition = /^project-(open|switch|create|reopen)/.test(
+          cell.scenario,
+        ),
+        m = targetTransition ? post.manifest : pre.manifest;
+      return {
+        ...m,
+        beforeManifest: pre.manifest ?? null,
+        afterManifest: post.manifest ?? null,
+        loadPhase: targetTransition
+          ? "target-after-transition"
+          : "before-action",
+        libraryProjects: pre.libraryProjects ?? post.libraryProjects ?? null,
+        workspace: post.workspace ?? pre.workspace ?? null,
+        agentSessions: pre.sessionHistory ?? post.sessionHistory ?? null,
+        activeStreamsBefore: pre.activeStreams ?? null,
+        activeStreamsAfter: post.activeStreams ?? null,
+        activeStreamsSourceBefore:pre.activeStreamObservation?.source??null,
+        activeStreamsSourceAfter:post.activeStreamObservation?.source??null,
+        launchVerified:
+          pre.libraryLaunch?.verified === true ||
+          post.libraryLaunch?.verified === true,
+      };
+    });
+  const base = observations[0] ?? {},
+    axes = {
+      nodes: base.nodes ?? null,
+      imageVideo: base.imageVideo ?? { images: null, videos: null },
+      documents: base.documents ?? null,
+      shots: base.shots ?? null,
+      clips: base.clips ?? null,
+      agentSessions: base.agentSessions ?? null,
+      libraryProjects: base.libraryProjects ?? null,
+      workspace: base.workspace ?? null,
+      cache: cell.cache,
+      uniqueMediaAssets: fixture.mediaProfile
+        ? fixture.mediaProfile.uniqueImageAssets +
+          fixture.mediaProfile.uniqueVideoAssets
+        : null,
+    };
+  const missing = [
+    "nodes",
+    "documents",
+    "shots",
+    "clips",
+    "agentSessions",
+    "libraryProjects",
+    "workspace",
+  ].filter((k) => axes[k] === null);
+  if (
+    !Number.isInteger(axes.imageVideo.images) ||
+    !Number.isInteger(axes.imageVideo.videos)
+  )
+    missing.push("imageVideo");
+  if (!observations.length || observations.some((o) => !o.launchVerified))
+    missing.push("verified-library-launch");
+  if (
+    observations.some(
+      (o) =>
+        !Number.isInteger(o.activeStreamsBefore) ||
+        !Number.isInteger(o.activeStreamsAfter),
+    )
+  )
+    missing.push("active-stream-observation");
+  const comparable = (o) =>
+    JSON.stringify(
+      Object.fromEntries(
+        Object.entries(o).filter(
+          ([k]) =>
+            !k.startsWith("activeStreams") &&
+            !["beforeManifest", "afterManifest"].includes(k),
+        ),
+      ),
+    );
+  if (observations.some((o) => comparable(o) !== comparable(base)))
+    missing.push("within-cell-axis-drift");
+  return {
+    axes,
+    status: missing.length ? "incomplete" : "observed",
+    missing,
+    observations,
+    fixtureManifest: manifestAxes(fixture.record),
+  };
+}
