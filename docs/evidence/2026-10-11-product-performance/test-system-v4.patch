@@ -0,0 +1,88 @@
+#!/usr/bin/env node
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { execFileSync } from "node:child_process";
+import { scanControls, checkControlCoverage } from "./controls.mjs";
+import { loadCatalog } from "./catalog.mjs";
+const [command, ...args] = process.argv.slice(2),
+  o = {};
+try {
+  for (let i = 0; i < args.length; i += 2) {
+    if (!args[i]?.startsWith("--") || !args[i + 1])
+      throw new Error("expected --key value");
+    o[args[i].slice(2)] = args[i + 1];
+  }
+  const repo = path.resolve(
+    o.repo ??
+      path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../.."),
+  );
+  const current = scanControls(repo);
+  let report = current;
+  if (command === "check") {
+    let baseline = null;
+    if (o.base) {
+      const sha = execFileSync(
+        "git",
+        ["rev-parse", "--verify", `${o.base}^{commit}`],
+        {
+          cwd: repo,
+          encoding: "utf8",
+        },
+      ).trim();
+      const files = [...new Set(current.controls.map((c) => c.file))];
+      baseline = scanControls(repo, { base: sha, files });
+    }
+    const mappings =
+      o.map && fs.existsSync(o.map)
+        ? JSON.parse(fs.readFileSync(o.map, "utf8"))
+        : null;
+    const catalog = await loadCatalog(repo),
+      candidate = o.candidate
+        ? JSON.parse(fs.readFileSync(o.candidate, "utf8"))
+        : null;
+    report = checkControlCoverage({
+      current,
+      baseline,
+      mappings,
+      scenarios: catalog.scenarios,
+      results: candidate?.results ?? null,
+    });
+    if (candidate) {
+      const head = execFileSync("git", ["rev-parse", "HEAD"], {
+        cwd: repo,
+        encoding: "utf8",
+      }).trim();
+      if (candidate.source?.commit !== head) {
+        report.pass = false;
+        report.errors.push("candidate source does not match current HEAD");
+      }
+    }
+  } else if (command !== "inventory")
+    throw new Error("commands: inventory | check");
+  if (o.out) {
+    fs.mkdirSync(path.dirname(path.resolve(o.out)), { recursive: true });
+    fs.writeFileSync(o.out, JSON.stringify(report, null, 2) + "\n");
+  }
+  console.log(
+    JSON.stringify(
+      command === "inventory"
+        ? {
+            ...report,
+            controls: undefined,
+            parseErrors: report.parseErrors.length,
+          }
+        : {
+            ...report,
+            errors: report.errors.slice(0, 10),
+            unresolved: report.unresolved.length,
+          },
+      null,
+      2,
+    ),
+  );
+  if (report.pass === false) process.exitCode = 1;
+} catch (e) {
+  console.error(e.message);
+  process.exitCode = 2;
+}
