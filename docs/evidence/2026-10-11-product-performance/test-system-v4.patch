+  }
+  if (committed > contract?.maxCostMicrounits) errors.push("provider budget exceeded");
+  if (receipt.blockedEgressAttempts !== 0 || receipt.guardErrors !== 0 || !hash(receipt.egressReceiptSha256)) errors.push("provider constrained egress receipt incomplete");
