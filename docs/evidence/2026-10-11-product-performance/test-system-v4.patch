+import {
+  readConfig,
+  sourceIdentity,
+  cloneOwned,
+  verifyGzip,
+} from "../../../scripts/quality-system/baseline-config.mjs";
+const config = readConfig();
+import fs from "node:fs";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { createGzip } from "node:zlib";
+import { pipeline } from "node:stream/promises";
+import {
+  root,
+  repo,
+  out,
+  report,
+  launch,
+  close,
+  finish,
+  cell,
+  delay,
+  openProject,
+  generation,
+  fit,
+  save,
+} from "./completion-common.mjs";
+const {
+  findCanvasBlankPoint,
+  findFrameDragHandlePoint,
+  findNodeHitPoint,
+  panCanvasUntilInside,
+} = await import(pathToFileURL(path.join(repo, "tests/ux/_canvasHit.mjs")));
+const fixtures = JSON.parse(fs.readFileSync(config.fixtureIndex));
+const scaleArg = process.argv
+  .find((x) => x.startsWith("--scale="))
+  ?.split("=")[1];
+report.protocol = {
+  ...report.protocol,
+  realUserData: config.media?.kind === "local",
+  traceOverhead:
+    "Chromium devtools.timeline and Playwright DOM snapshots; no periodic screenshots",
+  scope: "group full actions",
+  gestureReceipt:
+    "drag uses visible bounding rectangle during drag; first pilot used committed inline position at release and is superseded",
+  cacheHot: "same process with one excluded warmup per operation",
+  libraryCards: 3,
+};
+const frame = ".generation-canvas-v2__group-box[data-group-id]";
+async function blank(w) {
+  await w.keyboard.press("Escape");
+  const p = await findCanvasBlankPoint(w, { inset: 35 });
+  if (!p) throw new Error("no real blank canvas hit");
+  await w.mouse.click(p.x, p.y);
+  return p;
+}
+async function selectedFrame(w) {
+  await fit(w);
+  let p = await findFrameDragHandlePoint(w);
+  if (!p) {
+    const title = w.locator(frame + " [data-frame-title=true]").first();
+    const moved = await panCanvasUntilInside(w, title);
+    if (!moved.ok) throw new Error("group title cannot be panned into canvas");
+    const dot = w.locator(frame + " [data-group-color-dot=true]").first(),
+      box = await dot.boundingBox();
+    if (!box) throw new Error("group color handle absent");
+    p = { x: box.x + box.width / 2, y: box.y + box.height / 2 };
+    await w.mouse.click(p.x, p.y);
+  } else await w.mouse.click(p.x, p.y);
+  await w.locator("[data-group-toolbar=true]").waitFor({ state: "visible" });
+  return p;
+}
+async function read(w) {
+  return w.evaluate(
+    (sel) => ({
+      groups: [...document.querySelectorAll(sel)].map((g) => ({
+        id: g.getAttribute("data-group-id"),
+        screenX: g.getBoundingClientRect().x,
+        screenY: g.getBoundingClientRect().y,
+        x: parseFloat(g.style.left),
+        y: parseFloat(g.style.top),
+        width: parseFloat(g.style.width),
+        height: parseFloat(g.style.height),
+        count: g.querySelector("[data-frame-count=true]")?.textContent,
+        border: getComputedStyle(g).borderColor,
+      })),
+      nodes: [...document.querySelectorAll(".react-flow__node[data-id]")].map(
+        (n) => ({
+          id: n.getAttribute("data-id"),
+          transform: n.style.transform,
+        }),
+      ),
+      viewport: document.querySelector(".react-flow__viewport")?.style
+        .transform,
+    }),
+    frame,
+  );
+}
+async function undo(w) {
+  await w.keyboard.press("Escape");
+  await w.keyboard.press("Control+z");
+  await delay(500);
+}
+async function drag(w, p, dx = 45, dy = 25, alt = false) {
+  await w.mouse.move(p.x, p.y);
+  if (alt) await w.keyboard.down("Alt");
+  await w.mouse.down();
+  for (let n = 1; n <= 30; n++) {
+    await w.mouse.move(p.x + (dx * n) / 30, p.y + (dy * n) / 30);
+    await delay(16);
+  }
+  await w.mouse.up();
+  if (alt) await w.keyboard.up("Alt");
+}
+async function menu(w, index) {
+  const p = await findFrameDragHandlePoint(w);
+  if (!p) throw new Error("no group context hit");
+  await w.mouse.click(p.x, p.y, { button: "right" });
+  const b = w
+    .locator("[data-frame-menu=true] button[role=menuitem]")
+    .nth(index);
+  await b.waitFor({ state: "visible" });
+  return b;
+}
+async function compress() {
+  for (const f of fs
+    .readdirSync(out)
+    .filter((f) => f.endsWith(".chromium.private.json"))) {
+    const p = path.join(out, f);
+    await pipeline(
+      fs.createReadStream(p),
+      createGzip(),
+      fs.createWriteStream(p + ".gz"),
+    );
+    await verifyGzip(p + ".gz");
+    fs.unlinkSync(p);
+  }
+}
+try {
+  for (const f of fixtures.filter((f) => !scaleArg || f.scale === scaleArg)) {
+    // Restore only this task's fixture manifest with the app closed; never user originals.
+    fs.writeFileSync(
+      path.join(f.projectRoot, ".nomi/project.json"),
+      JSON.stringify(f.record),
+    );
+    const ins = await launch("groups-" + f.scale),
+      w = ins.win;
+    await openProject(ins, f.record);
+    await generation(w);
+    await fit(w);
+    // Existing 4-member fixture group is dissolved by the production UI.
+    await selectedFrame(w);
+    await w
+      .locator('[data-group-toolbar=true] button[aria-label="解组"]')
+      .click();
+    await w.locator(frame).waitFor({ state: "detached" });
+    const expected = f.summary.canvasNodes;
+    await cell(ins, f.scale, "group-create", async () => {
+      await fit(w);
+      await blank(w);
+      await w.keyboard.press("Control+a");
+      const input = '[aria-label^="创建分组"]';
+      await w.locator(input).first().waitFor({ state: "visible" });
+      return {
+        spec: {
+          input,
+          expected,
+          condition: `const g=document.querySelector('${frame}');return g?.querySelector('[data-frame-count=true]')?.textContent===String(spec.expected)&&g.getAttribute('data-frame-selected')==='true'`,
+        },
+        action: () => w.locator(input).first().click(),
+        verify: async () => ({
+          groupCount: await w.locator(frame).count(),
+          memberCount: await w
+            .locator(frame + " [data-frame-count=true]")
+            .textContent(),
+        }),
+        cleanup: () => undo(w),
+      };
+    });
+    // Keep a fresh all-node group for remaining operations.
+    await blank(w);
+    await w.keyboard.press("Control+a");
+    await w.locator('[aria-label^="创建分组"]').first().click();
+    await w.locator(frame).waitFor({ state: "visible" });
+    await cell(ins, f.scale, "group-drag", async () => {
+      const p = await selectedFrame(w),
+        before = await read(w);
+      return {
+        spec: {
+          input: frame,
+          before: before.groups[0],
+          condition: `const g=document.querySelector('${frame}');return g&&Math.abs(g.getBoundingClientRect().x-spec.before.screenX)>2`,
+        },
+        action: () => drag(w, p),
+        verify: async () => {
