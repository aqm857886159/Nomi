+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import crypto from "node:crypto";
+import { spawn, execFileSync } from "node:child_process";
+import snapshotTools from "./owned-process-snapshot.cjs";
+const {readProcessSnapshot,selectResidualProcesses,sameStamp}=snapshotTools;
+let unconfirmedExitSeen=false,queueInterrupted=false;
+const pause = (ms) => new Promise((r) => setTimeout(r, ms));
+export function hostLockPath() {
+  return path.join(
+    process.platform === "win32" ? os.tmpdir() : "/tmp",
+    `nomi-quality-native-user-${process.getuid?.() ?? os.userInfo().username}.lock`,
+  );
+}
+export function acquireNativeLock() {
+  const file = hostLockPath(),
+    token = crypto.randomUUID();
+  const fd = fs.openSync(file, "wx", 0o600);
+  fs.writeFileSync(
+    fd,
+    JSON.stringify({
+      token,
+      pid: process.pid,
+      status: "running",
+      createdAt: new Date().toISOString(),
+    }),
+  );
+  fs.closeSync(fd);
+  return { file, token };
+}
+export function releaseNativeLock(lock, { confirmed = true } = {}) {
+  const current = JSON.parse(fs.readFileSync(lock.file, "utf8"));
+  if (current.token !== lock.token) throw new Error("Lock ownership changed");
+  if (!confirmed || unconfirmedExitSeen || current.status === "blocked-unconfirmed-process-exit") {
+    fs.writeFileSync(
+      lock.file,
+      JSON.stringify({
+        ...current,
+        status: "blocked-unconfirmed-process-exit",
+      }),
+    );
+    return false;
+  }
+  fs.unlinkSync(lock.file);
+  return true;
+}
+export function birthStamp(pid) {
+  try {
+    return (
+      execFileSync("/bin/ps", ["-p", String(pid), "-o", "lstart="], {
+        encoding: "utf8",
+        stdio: ["ignore", "pipe", "ignore"],
+      }).trim() || null
