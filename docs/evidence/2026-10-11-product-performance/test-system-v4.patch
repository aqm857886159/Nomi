+  if (c?.version !== "real-provider-bounded-v1") errors.push("missing bounded provider protocol version");
+  for (const k of ["provider", "model"])
+    if (typeof c?.[k] !== "string" || !/^[A-Za-z0-9._:/-]{1,120}$/.test(c[k])) errors.push(`missing explicit ${k}`);
+  if (c?.authorization?.humanApproved !== true || !hash(c?.authorization?.receiptSha256) || !Number.isFinite(Date.parse(c?.authorization?.approvedAt ?? ""))) errors.push("missing explicit human budget/model authorization receipt");
+  if (!/^[A-Z]{3}$/.test(c?.currency ?? "")) errors.push("missing budget currency");
+  for (const k of ["maxCostMicrounits", "maxRequests", "maxConcurrency", "requestTimeoutMs"])
+    if (!positive(c?.[k])) errors.push(`missing finite ${k}`);
+  if (c?.maxConcurrency > c?.maxRequests) errors.push("concurrency exceeds request count");
+  if (!hash(c?.priceScheduleSha256) || c?.costReservation !== "worst-case-before-dispatch") errors.push("missing pinned price schedule and worst-case reservation");
+  if (!/^[A-Z]{3}$/.test(c?.priceCurrency ?? "")) errors.push("missing provider price currency");
+  if (c?.priceCurrency !== c?.currency && (!hash(c?.fx?.sourceReceiptSha256) || !Number.isFinite(c?.fx?.rate) || c.fx.rate <= 0 || !Number.isFinite(c?.fx?.bufferMultiplier) || c.fx.bufferMultiplier <= 1 || !Number.isFinite(Date.parse(c?.fx?.observedAt ?? "")))) errors.push("cross-currency budget requires verified FX and conservative buffer");
+  if (c?.mediaPolicy !== "public-or-synthetic-only" || c?.credentialsPolicy !== "runtime-secret-no-logs") errors.push("unsafe media or credential policy");
+  if (!Array.isArray(c?.endpoints) || !c.endpoints.length) errors.push("missing exact provider endpoint allowlist");
