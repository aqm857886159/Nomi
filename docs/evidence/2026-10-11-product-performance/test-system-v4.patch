+name: Product quality contract
+on:
+  pull_request:
+  merge_group:
+  workflow_dispatch:
+    inputs:
+      base_ref:
+        description: Reachable base commit for the impact declaration
+        required: true
+        default: origin/main
+permissions:
+  contents: read
+jobs:
+  contract:
+    name: Product quality coverage contract
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 10.8.1
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24
+      - name: Install the repository TypeScript parser
+        run: pnpm install --frozen-lockfile
+      - name: Verify the evidence gate with negative controls
+        run: node --test tests/quality-system/*.test.mjs
+      - name: Validate live feature inventory
+        run: node scripts/quality-system/cli.mjs check
+      - name: Require every product change to declare functional and performance coverage
+        env:
+          QUALITY_BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || inputs.base_ref }}
+        run: node scripts/quality-system/cli.mjs change --base "$QUALITY_BASE" --impact docs/quality-system/change-impact.json --out artifacts/quality-system/change-contract.json
+      # This CPU job proves registration only. Do not call it a completed product test.
+      # A trusted native desktop run must execute `cli.mjs gate --scope change` against
+      # the exact merge/head SHA before merge; see docs/quality-system/README.md.
+      # No local user data, trace, or screenshot is uploaded by this workflow.
+      - name: Require exact case/assertion mapping for added or changed UI controls
+        env:
+          QUALITY_BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || inputs.base_ref }}
+        run: node scripts/quality-system/control-cli.mjs check --base "$QUALITY_BASE" --map docs/quality-system/control-cases.json --out artifacts/quality-system/control-contract.json
