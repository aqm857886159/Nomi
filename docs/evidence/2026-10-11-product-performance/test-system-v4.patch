+            "timeline-document-completion.mjs",
+            ["--prepare-only"],
+            prepared.file,
+          );
+          confirmedExit = p.cleanup.confirmed;
+          if (!p.cleanup.confirmed) {
+            confirmedExit = false;
+            throw new Error(
+              "Native child exit unconfirmed; desktop lock retained",
+            );
+          }
