+++ b/scripts/quality-system/import-completion.mjs
@@ -0,0 +1,180 @@
+import {sampleSeriesIntegrity} from "./sample-series.mjs";
+import {
+  postCloseMemorySeries,
+  INTERACTIVE_METRIC_MEANING,
+} from "./lifecycle-series.mjs";
+import { processSamplingQuality } from "./sampling-quality.mjs";
+// Numeric allowlist adapter for completion-common.mjs. Does not infer missing milestones or axes.
+export function completionResult(cell, mapping) {
+  if (
+    !mapping?.scenarioId ||
+    !mapping.protocol ||
+    !mapping.execution ||
+    !mapping.evidence?.length
+  )
+    throw new Error(
+      "Explicit scenario, measured protocol/axes/media profile, execution and evidence mapping required",
+    );
+  const number = (n) =>
+    typeof n === "number" && Number.isFinite(n) ? n : null;
+  const samples = (cell.samples ?? []).map((sample) => {
+    const s = sample.summary ?? {};
+    const samplingQuality = processSamplingQuality(sample),
+      processComplete = samplingQuality.complete;
+    return {
+      index: Number.isInteger(sample.index)&&sample.index>=0?sample.index:null,
+      phase: sample.isWarmup===true ? "warmup" : sample.isWarmup===false ? "measured" : null,
+      samplingQuality,
+      metrics: {
+        visibleStateMs: number(s.responseMs),
+        inputFeedbackMs: number(sample.assertions?.feedbackMs),
+        inputInteractiveMs: number(
+          sample.assertions?.interactiveConfirmedUpperBoundMs,
+        ),
+        actionCompletedMs: number(
+          sample.state?.actionCompletedAt - sample.state?.inputAt,
+        ),
+        frameP95Ms: number(s.frameP95Ms),
+        frameP99Ms: number(s.frameP99Ms),
+        activeFrameP95Ms: number(s.activeGesture?.p95Ms),
+        activeFrameP99Ms: number(s.activeGesture?.p99Ms),
+        estimatedMissedFrames: number(s.droppedFrameEstimate),
+        longTaskCount: number(s.longTasks),
+        longTaskMaxMs: number(s.longTaskMaxMs),
+        mainCpuPct: processComplete ? number(s.mainCPUPercent?.mean) : null,
+        rendererCpuPct: processComplete
+          ? number(s.rendererCPUPercent?.mean)
+          : null,
+        mainRssMiB:
+          processComplete && s.mainMemory?.lastKiB != null
+            ? number(s.mainMemory.lastKiB / 1024)
+            : null,
+        rendererRssMiB:
+          processComplete && s.rendererMemory?.lastKiB != null
+            ? number(s.rendererMemory.lastKiB / 1024)
+            : null,
+        networkWaitMs: number(s.networkWaitMs),
+        modelWaitMs: number(s.modelWaitMs),
+        mainEventLoopP99Ms: number(s.mainEventLoop?.p99Ms),
+      },
+    };
+  });
+  const measured = (cell.samples ?? []).filter((s) => s.isWarmup===false);
+  const sampleIntegrity=sampleSeriesIntegrity(cell.samples,mapping.protocol,{raw:true});
+  const booleanKeys = [
+    ...new Set(
+      measured.flatMap((s) =>
+        Object.entries(s.assertions ?? {})
+          .filter(([, v]) => typeof v === "boolean")
+          .map(([k]) => k),
+      ),
+    ),
+  ];
+  const memory =
+    mapping.protocol.measuredCycles === 30
+      ? postCloseMemorySeries(cell, mapping.protocol)
+      : null;
+  return {
+    sampleIntegrity,
+    lifecycleSeries: memory,
+    seriesMetrics:
+      memory?.status === "measured" ? { memorySlopeMiBPerCycle: memory } : {},
+    scenarioId: mapping.scenarioId,
+    status:
+      cell.status === "executed"
+        ? measured.length > 0 &&
+          measured.every(
+            (s) =>
+              s.summary?.functionalPassed === true &&
+              booleanKeys.every((id) => s.assertions?.[id] === true),
+          )
+          ? sampleIntegrity.status === "complete" ? "passed" : "unverified"
+          : "failed"
+        : cell.status === "blocked"
+          ? "blocked"
+          : "unverified",
+    protocol: {
+      ...mapping.protocol,
+      metricMeaning: {
+        ...mapping.protocol.metricMeaning,
+        inputInteractiveMs: INTERACTIVE_METRIC_MEANING,
+      },
+    },
+    execution: mapping.execution,
+    evidence: mapping.evidence,
+    controlFingerprints: mapping.controlFingerprints ?? [],
+    assertions: [
+      {
+        id: "measured-visible-state-receipts",
+        passed:
+          measured.length > 0 &&
+          measured.every((s) => s.summary?.functionalPassed === true),
+      },
+      ...booleanKeys.map((id) => ({
+        id,
+        passed: measured.every((s) => s.assertions?.[id] === true),
+      })),
+    ],
+    availability: {
+      ...Object.fromEntries(
+        ["mainCpuPct", "rendererCpuPct", "mainRssMiB", "rendererRssMiB"].map(
+          (metric) => [
+            metric,
+            {
+              status:
+                samples.filter((s) => s.phase === "measured").length > 0 &&
+                samples
+                  .filter((s) => s.phase === "measured")
+                  .every((s) => s.samplingQuality.complete)
+                  ? "measured"
+                  : "inconclusive",
+              reason:
+                "Requires at least 8 complete process ticks, >=2/3 of expected window/250ms ticks, no sampling errors, all IPC lag <=500ms",
+            },
+          ],
+        ),
+      ),
+      inputFeedbackMs: {
+        status:
+          measured.length > 0 &&
+          measured.every((s) => Number.isFinite(s.assertions?.feedbackMs))
+            ? "measured"
+            : "unsupported",
+        reason:
+          "Explicit open feedback probe when available; otherwise completion-common responseMs is a scenario-specific visible state, not a separately instrumented first feedback",
+      },
+      inputInteractiveMs: {
+        status:
+          measured.length > 0 &&
+          measured.every((s) =>
+            Number.isFinite(s.assertions?.interactiveConfirmedUpperBoundMs),
+          )
+            ? "measured"
+            : "unsupported",
+        reason:
+          "Explicit subsequent project-menu acknowledgement is an upper bound including driver dispatch gap; generic probe unsupported",
+      },
+      networkWaitMs: {
+        status:
+          measured.length > 0 &&
+          samples
+            .filter((s) => s.phase === "measured")
+            .every((s) => s.metrics.networkWaitMs !== null)
+            ? "measured"
+            : "inconclusive",
+        reason: "No automatic assumption that loopback waiting is zero",
+      },
+      modelWaitMs: {
+        status:
+          measured.length > 0 &&
+          samples
+            .filter((s) => s.phase === "measured")
+            .every((s) => s.metrics.modelWaitMs !== null)
+            ? "measured"
+            : "inconclusive",
+        reason: "Model/fixture waiting requires explicit timing",
+      },
+    },
+    samples,
+  };
+}
diff --git a/scripts/quality-system/import-full-walk.mjs b/scripts/quality-system/import-full-walk.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/import-full-walk.mjs
@@ -0,0 +1,87 @@
+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { fileURLToPath } from "node:url";
+import { relativePath, checkRun } from "./gate.mjs";
+export function importFullWalk(summary, context, evidence) {
+  const errors = checkRun({ ...context, results: [] });
+  if (
+    !summary.head ||
+    !context.source?.commit?.startsWith(summary.head) ||
+    summary.dirty !== false
+  )
+    errors.push("full-walk source does not match clean context");
+  if (!Array.isArray(summary.runs) || summary.runs.length === 0)
+    errors.push("empty full-walk report");
+  if (errors.length) throw new Error(errors.join("; "));
+  return {
+    ...context,
+    results: summary.runs.map((r) => {
+      const steps = /^(\d+)\/(\d+)$/.exec(r.steps ?? "");
+      const stepPass = !!steps && Number(steps[1]) > 0 && steps[1] === steps[2];
+      const egress = r.egress;
+      const attempts = egress
+        ? egress.vendor?.length + egress.other?.length
+        : null;
+      return {
+        scenarioId: `playbook:${r.playbookId}:${r.variantId}:${r.locale}`,
+        status:
+          r.status === "clean" &&
+          r.exitCode === 0 &&
+          r.violations === 0 &&
+          stepPass
+            ? "passed"
+            : r.status === "red"
+              ? "failed"
+              : r.status === "skipped"
+                ? "unverified"
+                : "blocked",
+        assertions: [
+          { id: "all-playbook-steps-completed", passed: stepPass },
+          { id: "zero-monitor-violations", passed: r.violations === 0 },
+          {
+            id: "guard-ready",
+            passed:
+              egress?.guardReady === true && egress.guardErrors?.length === 0,
+          },
+        ],
+        execution: {
+          realUserActions: stepPass,
+          renderer: "electron",
+          networkGuardLayers: egress?.guardLayers ?? [],
+          externalAttempts: Number.isFinite(attempts) ? attempts : null,
+        },
+        evidence: [{ ...evidence, kind: "assertion-report" }],
+        samples: [],
+      };
+    }),
+  };
+}
+if (
+  process.argv[1] &&
+  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
+) {
+  try {
+    const [contextFile, summaryFile, relativeEvidence, out] =
+      process.argv.slice(2);
+    if (!out || !relativePath(relativeEvidence))
+      throw new Error(
+        "Usage: import-full-walk.mjs context.json report.json relative/report.json output.json",
+      );
+    const raw = fs.readFileSync(summaryFile),
+      summary = JSON.parse(raw),
+      context = JSON.parse(fs.readFileSync(contextFile, "utf8"));
+    const result = importFullWalk(summary, context, {
+      path: relativeEvidence,
+      sha256: crypto.createHash("sha256").update(raw).digest("hex"),
+    });
+    fs.mkdirSync(path.dirname(path.resolve(out)), { recursive: true });
+    fs.writeFileSync(out, JSON.stringify(result, null, 2) + "\n");
+    console.log(
+      `Imported ${result.results.length} playbook receipts; action/state coverage is not inferred.`,
+    );
+  } catch (error) {
+    console.error(error.message);
+    process.exitCode = 2;
+  }
+}
