+    docs = p?.workbenchDocuments,
+    designs = p?.storyboardDesignsByDocumentId,
+    tracks = p?.timeline?.tracks;
+  return {
+    nodes: Array.isArray(n) ? n.length : null,
+    imageVideo: {
+      images: Array.isArray(n)
+        ? n.filter((x) => x.kind === "image").length
+        : null,
+      videos: Array.isArray(n)
+        ? n.filter((x) => x.kind === "video").length
+        : null,
+    },
+    documents: Array.isArray(docs) ? docs.length : null,
+    shots:
+      designs && typeof designs === "object"
+        ? Object.values(designs)
+            .flat()
