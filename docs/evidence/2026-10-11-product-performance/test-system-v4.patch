+      ins,
+      f,
+      collapsed ? "group-collapsed-move-integrity" : "group-move-integrity",
+      async () => {
+        const expandedHandle = await select(w);
+        if (collapsed) {
+          await w.locator(frame + ' button[aria-label^="收起分组"]').click();
+          await persisted(f, (p) => p.generationCanvas.groups[0].collapsed);
+        }
+        const before = read(f).generationCanvas;
+        const selector = collapsed ? collapse + " [role=group]" : frame;
+        const p = collapsed
+          ? await w
+              .locator(selector)
+              .boundingBox()
+              .then((b) => ({ x: b.x + b.width / 2, y: b.y + b.height / 2 }))
+          : expandedHandle;
+        const rect = await w.locator(selector).boundingBox();
+        let released, committed;
+        return {
+          spec: {
+            input: selector,
+            x: rect.x,
+            condition: `const e=document.querySelector('${selector}');return e&&Math.abs(e.getBoundingClientRect().x-spec.x)>2`,
+          },
+          action: async () => {
+            released = await drag(w, p);
+            committed = observePersisted(
+              f,
+              (q) =>
+                q.generationCanvas.nodes.some(
