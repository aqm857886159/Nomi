new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/full-walk/cleanup-owned-processes.mjs
@@ -0,0 +1,16 @@
+// Never enumerate or terminate unrelated processes. The launcher records only its own PID + birth stamp.
+import fs from 'node:fs'
+import { execFileSync } from 'node:child_process'
+const stamp = pid => {try{return execFileSync('/bin/ps',['-p',String(pid),'-o','lstart='],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()}catch{return null}}
+export async function cleanupOwnedProcesses(traceLog) {
+ const file=traceLog+'.owners'
+ if(!fs.existsSync(file))return{owned:0,terminated:0,identityRejected:0}
+ const rows=fs.readFileSync(file,'utf8').split('\n').filter(Boolean).map(l=>JSON.parse(l)),seen=new Set(),result={owned:0,terminated:0,identityRejected:0}
+ for(const row of rows){
+  if(seen.has(row.pid))continue;seen.add(row.pid);result.owned++
+  const current=stamp(row.pid);if(!current)continue
+  if(current!==row.startToken){result.identityRejected++;continue}
+  try{process.kill(row.pid,'SIGTERM');await new Promise(r=>setTimeout(r,250));if(stamp(row.pid)===row.startToken)process.kill(row.pid,'SIGKILL');result.terminated++}catch{}
+ }
+ return result
+}
