+) {
+  if (!file) throw new Error("Owned process receipt missing");
+  for (const metric of metrics ?? []) {
+    const pid = metric.pid,
+      key = `${file}:${pid}:${metric.creationTime ?? ""}`;
+    if (!Number.isInteger(pid) || pid <= 1 || registered.has(key)) continue;
+    registered.add(key);
