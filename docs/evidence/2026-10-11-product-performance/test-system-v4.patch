+    null,
+  );
+});
+
+test("missing, wrong-settle or unordered post-close data cannot fall back to open-state RSS", () => {
+  const samples = Array.from({ length: 30 }, () => ({
+    summary: { rendererMemory: { lastKiB: 400 * 1024 } },
+  }));
+  const map = {
+    ...mapping,
