+#!/usr/bin/env node
+// Registration-only legacy adapter. Native execution needs the audited full-walk isolation/ownership wrapper.
+import path from "node:path";
+import { loadCatalog } from "./catalog.mjs";
+const [repoArg, selector] = process.argv.slice(2);
+if (!repoArg)
+  throw new Error("Usage: run-existing.mjs /path/to/repo [exact-playbook-id]");
+const catalog = await loadCatalog(path.resolve(repoArg));
+if (selector && !catalog.playbooks.some((p) => p.id === selector && !p.paid))
+  throw new Error(
+    "Selector must be an exact registered zero-spend playbook ID",
+  );
+console.log(
+  JSON.stringify({
+    status: "blocked",
+    code: "LEGACY_NATIVE_ADAPTER_REQUIRES_ISOLATION",
+    nativeLaunched: false,
+    playbooks: catalog.playbooks
+      .filter((p) => !p.paid && (!selector || p.id === selector))
+      .map((p) => p.id),
+    reason:
+      "The raw full-walk entry is not allowed to bypass credential isolation, environment allowlist, global desktop lock and owned-process cleanup. Use the separately audited native adapter; no execution receipt is produced.",
+  }),
+);
+process.exitCode = 2;
