+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { execFileSync } from "node:child_process";
+import { createGunzip } from "node:zlib";
+import { pipeline } from "node:stream/promises";
+export const hash = (value) =>
+  crypto.createHash("sha256").update(value).digest("hex");
+export function hashFile(file) {
+  const h = crypto.createHash("sha256"),
+    b = Buffer.alloc(1024 * 1024),
+    fd = fs.openSync(file, "r");
+  try {
+    let n;
+    while ((n = fs.readSync(fd, b, 0, b.length, null)) > 0)
+      h.update(b.subarray(0, n));
+    return h.digest("hex");
+  } finally {
+    fs.closeSync(fd);
+  }
+}
+export const inside = (root, file) =>
+  file === root || file.startsWith(root + path.sep);
+function canonical(file) {
+  let p = path.resolve(file),
+    tail = [];
+  while (!fs.existsSync(p)) {
+    tail.unshift(path.basename(p));
+    p = path.dirname(p);
+  }
+  return path.join(fs.realpathSync(p), ...tail);
+}
+export function readConfig(file = process.env.NOMI_QUALITY_CONFIG) {
+  if (!file)
+    throw new Error("Explicit --config or NOMI_QUALITY_CONFIG is required");
+  const c = JSON.parse(fs.readFileSync(file, "utf8")),
+    base = path.dirname(path.resolve(file));
+  for (const k of ["repoRoot", "privateRoot", "outputDir"]) {
+    if (typeof c[k] !== "string" || !c[k]) throw new Error(`Missing ${k}`);
+    c[k] = canonical(path.resolve(base, c[k]));
+  }
+  c.ownershipRoot = c.ownershipRoot
+    ? canonical(path.resolve(base, c.ownershipRoot))
+    : c.privateRoot;
+  if (
+    !inside(c.ownershipRoot, c.privateRoot) ||
+    inside(c.repoRoot, c.ownershipRoot) ||
+    inside(c.ownershipRoot, c.repoRoot)
+  )
+    throw new Error(
+      "Private ownership root must be outside the product checkout",
+    );
+  if (c.runPrivateDir) {
+    c.runPrivateDir = canonical(path.resolve(base, c.runPrivateDir));
+    if (!inside(c.ownershipRoot, c.runPrivateDir))
+      throw new Error("Run output escapes owned storage");
+  }
+  c.fixtureIndex = canonical(
+    path.resolve(
+      base,
+      c.fixtureIndex || path.join(c.privateRoot, "fixtures.private.json"),
+    ),
+  );
+  if (inside(c.privateRoot, c.repoRoot) || inside(c.repoRoot, c.privateRoot))
+    throw new Error("privateRoot must be outside the product checkout");
+  if (
+    inside(c.repoRoot, c.outputDir) ||
+    inside(c.privateRoot, c.outputDir) ||
+    inside(c.outputDir, c.privateRoot)
+  )
+    throw new Error("outputDir must be separate from repoRoot and privateRoot");
+  if (!inside(c.privateRoot, c.fixtureIndex))
+    throw new Error("fixtureIndex must be owned by privateRoot");
+  if (c.media?.kind === "local") {
+    if (!Array.isArray(c.media.files) || !c.media.files.length)
+      throw new Error("Local media requires explicit file allowlist");
+    c.media.files = c.media.files.map((p) => canonical(path.resolve(base, p)));
+    for (const p of c.media.files)
+      if (inside(c.privateRoot, p) || inside(c.outputDir, p))
+        throw new Error("Local source overlaps owned outputs");
+  } else if (c.media?.kind && c.media.kind !== "repository")
+    throw new Error("Unknown media provenance");
+  return c;
+}
+export function sourceIdentity(repoRoot, { requireBuild = false } = {}) {
+  const git = (args) =>
+    execFileSync("git", args, {
+      cwd: repoRoot,
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "pipe"],
+    }).trim();
+  const source = {
+    commit: git(["rev-parse", "HEAD"]),
+    tree: git(["rev-parse", "HEAD^{tree}"]),
+    dirty: git(["status", "--porcelain"]).length > 0,
+  };
+  if (requireBuild) {
+    if (source.dirty)
+      throw new Error("Refuse native baseline from dirty source");
+    for (const output of ["dist", "dist-electron"]) {
+      const s = JSON.parse(
+        fs.readFileSync(
+          path.join(repoRoot, output, "build-stamp.json"),
+          "utf8",
+        ),
+      );
+      if (
+        s.version !== 1 ||
+        s.head !== source.commit ||
+        s.tree !== source.tree ||
+        s.dirty !== false
+      )
+        throw new Error(
+          "Build stamp does not match clean source; run pnpm build",
+        );
+    }
+  }
+  return source;
+}
+export function writeJson(file, value) {
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, JSON.stringify(value, null, 2) + "\n");
+}
+export function cloneOwned(source, dest) {
+  if (fs.existsSync(dest)) throw new Error("Clone destination already exists");
+  fs.cpSync(source, dest, {
+    recursive: true,
+    dereference: false,
+    errorOnExist: true,
+    force: false,
+  });
+  rejectSymlinks(dest);
+}
+export function rejectSymlinks(root) {
+  for (const item of fs.readdirSync(root, { withFileTypes: true })) {
+    const p = path.join(root, item.name);
+    if (item.isSymbolicLink()) throw new Error("Fixture contains a symlink");
+    if (item.isDirectory()) rejectSymlinks(p);
+  }
+}
+export async function verifyGzip(file) {
+  await pipeline(
+    fs.createReadStream(file),
+    createGunzip(),
+    async function (src) {
+      for await (const _ of src) {
+        /* CRC/footer verification without buffering */
+      }
+    },
+  );
+}
+export function credentialIsolationOptions({ requireCatalog = false } = {}) {
+  if (requireCatalog)
+    throw new Error(
+      "Live credential catalog is unsupported by the zero-spend system",
+    );
+  return {
+    requireCatalog: false,
+    realProfileAccess: "forbidden",
+    syntheticCredentialStorage: false,
+  };
+}
