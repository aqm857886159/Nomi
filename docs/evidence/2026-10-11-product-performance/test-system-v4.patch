+    false,
+  );
+  assert.deepEqual(metricPolicyFor("new-unknown-feature", repo), {});
+});
+test("missing actual receipts fail closed via executable import CLI", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "nomi-quality-empty-"));
+  try {
+    const file = path.join(dir, "c.json"),
+      out = path.join(dir, "public");
+    writeJson(file, {
+      repoRoot: repo,
+      privateRoot: path.join(dir, "private"),
+      outputDir: out,
+    });
+    const r = spawnSync(
