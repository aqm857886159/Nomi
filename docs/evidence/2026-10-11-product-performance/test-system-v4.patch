@@ -0,0 +1,55 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import assert from 'node:assert/strict'
+
+export function resolveOwnedAsset(url, projectId, projectRoot) {
+  const parsed = new URL(url)
+  assert.equal(parsed.protocol, 'nomi-local:')
+  assert.equal(parsed.hostname, 'asset')
+  const parts = parsed.pathname.slice(1).split('/').map(decodeURIComponent)
+  assert.equal(parts.shift(), projectId, 'Asset must identify this isolated project')
+  assert.ok(parts.length && parts.every(p => p && p !== '.' && p !== '..' && !/[\\/]/.test(p)), 'Asset path must be a plain project-relative path')
+  const file = path.resolve(projectRoot, ...parts)
+  assert.ok(file.startsWith(path.resolve(projectRoot) + path.sep), 'Asset must stay in isolated project')
+  return file
+}
+
+export function verifyNetworkGuards(file) {
+  assert.ok(fs.existsSync(file), 'Network guard receipt required')
+  const entries = fs.readFileSync(file, 'utf8').trim().split('\n').filter(Boolean).map(line => JSON.parse(line))
+  const layers = [...new Set(entries.filter(e => e.kind === 'guard-loaded').flatMap(e => e.layers || []))]
+  for (const layer of ['fetch', 'http', 'https', 'socket', 'chromium']) assert.ok(layers.includes(layer), 'Missing network guard layer: ' + layer)
+  // Blocked attempts are reported separately; this checks enforcement was installed.
+  return { layers, blockedAttempts: entries.filter(e => e.kind === 'blocked').length, policy: 'loopback-only' }
+}
+
+// Fixture validation uses the actual rendered production UI before any measured
+// action. It never injects store state or changes source fixture ownership.
+export async function verifyNativeWorkload(page, fixture) {
+  assert.ok(fixture.fixtureRevision >= 3 && fixture.ownershipVersion === 'document-owner-v3', 'Document ownership v3 required')
+  const rail = page.locator('[data-shell-rail-item="docs"]')
+  const drawer = page.locator('[data-shell-drawer="docs"]')
+  const openDrawer = async () => {
+    if (await rail.getAttribute('aria-pressed') !== 'true') await rail.click()
+    await drawer.locator('[data-document-row]').first().waitFor({ state: 'visible' })
+  }
+  await page.locator('[data-mode="creation"]').click()
+  await openDrawer()
+  const documents = await drawer.locator('[data-document-row]').count()
+  assert.equal(documents, fixture.dimensions.documents, 'Rendered document scale required')
+  await drawer.locator(`[data-document-id="${fixture.documents[0].id}"]:not([data-storyboard-id])`).click()
+  // Clicking the editor may dismiss the drawer; open it explicitly for the next entry.
+  await openDrawer()
+  await drawer.locator(`[data-storyboard-id="${fixture.plan.id}"]`).click()
+  await page.locator('[data-storyboard-editor]').waitFor({ state: 'visible' })
+  await page.waitForFunction(expected => document.querySelectorAll('[data-storyboard-rows=true] [data-storyboard-row]').length === expected, fixture.dimensions.shots)
+  const shots = await page.locator('[data-storyboard-rows=true] [data-storyboard-row]').count()
+  if (await rail.getAttribute('aria-pressed') === 'true') await rail.click()
+  await drawer.waitFor({ state: 'hidden' })
+  await page.locator('[data-mode="preview"]').click()
+  const clipsSelector = '.workbench-preview .workbench-timeline [data-clip-id]'
+  await page.waitForFunction(({selector, expected}) => document.querySelectorAll(selector).length === expected, {selector: clipsSelector, expected: fixture.dimensions.clips})
+  const clips = await page.locator(clipsSelector).count()
+  await page.locator('[data-mode="generation"]').click()
+  return { scale: fixture.scale, fixtureRevision: fixture.fixtureRevision, ownershipVersion: fixture.ownershipVersion, sourceFixtureManifestSha256: fixture.fixtureManifestSha256, live: {documents, shots, clips}, passed: true }
+}
