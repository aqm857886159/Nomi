+    checkHash = crypto.createHash("sha256");
+  await pipeline(fs.createReadStream(gz), createGunzip(), async function (src) {
+    for await (const b of src) checkHash.update(b);
+  });
+  assert.equal(checkHash.digest("hex"), originalSha256);
+  report.traceCompression.push({
+    label,
+    sourceSha256: originalSha256,
+    originalBytes: fs.statSync(file).size,
+    gzipBytes: fs.statSync(gz).size,
+    roundTripVerified: true,
+  });
+  fs.unlinkSync(file);
+  save();
