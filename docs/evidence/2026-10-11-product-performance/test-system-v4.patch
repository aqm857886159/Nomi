+        ffmpeg,
+        [
+          "-hide_banner",
+          "-loglevel",
+          "error",
+          "-threads",
+          "1",
+          "-ss",
+          String(at),
+          "-i",
+          frameSource,
+          "-frames:v",
+          "1",
+          "-threads",
+          "1",
