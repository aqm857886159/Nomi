+      if (u.protocol !== "https:" || u.origin !== e.origin || u.username || u.password || u.port || !/^[A-Za-z0-9.-]+$/.test(u.hostname) || ["localhost", "127.0.0.1"].includes(u.hostname)) throw new Error();
