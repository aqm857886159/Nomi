+  settleProviderTextRequest(file,"request-3",{outcome:"completed",promptTokens:80,completionTokens:50});
+  assert.throws(()=>reserveProviderTextRequest(file,request(4,"live-text-continue")),/no retry/);
+  const data=JSON.parse(fs.readFileSync(file));assert.equal(data.requests.length,3);assert.equal(data.unresolvedReservedMicrounits,3000000);assert.equal(data.actualBilledMicrounits,0);assert.equal(data.billingComplete,false);
