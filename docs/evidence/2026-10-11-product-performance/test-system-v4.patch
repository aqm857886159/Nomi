+import fs from "node:fs";
+import path from "node:path";
+import { hashFile } from "./baseline-config.mjs";
+// Reviewed local UI families. A fixture-specific network guard receipt is still required.
+// Unknown/new paths retain required metrics until a review adds an explicit contract.
+const LOCAL_CONTRACTS = [
+  {
+    pattern: /^(group-|canvas-(pan|zoom|multiselect-drag))/,
+    path: "src/workbench/generationCanvas/components/GenerationCanvas.tsx",
+    reason:
+      "Local canvas selection/group/viewport operations on preloaded fixture nodes; no generation action",
+  },
+  {
+    pattern: /^(documents?-|storyboard-|timeline-|video-hover)/,
+    path: "src/workbench/WorkbenchShell.tsx",
+    reason:
+      "Local fixture document, storyboard, timeline and pre-existing media UI actions; no provider generation",
+  },
+  {
+    pattern: /^project-(open|switch|create|reopen)/,
+    path: "src/workbench/NomiStudioApp.tsx",
+    reason:
+      "Local project lifecycle over owned fixture files; no provider generation",
+  },
+];
+export function metricPolicyFor(name, repoRoot) {
+  if (name === "group-generate-loopback-complete") return {};
+  const canvas=JSON.parse(fs.readFileSync(new URL('../../tests/quality-system/baseline/canvas-controls-gap-coverage.json',import.meta.url),'utf8')).cases.find(c=>c.id===name);
+  const match = canvas ? {path:canvas.source.file,reason:'Prepared local canvas control; no provider submit; complete loopback egress guard still required'} : LOCAL_CONTRACTS.find((x) => x.pattern.test(name));
+  if (!match) return {};
+  // Moved production ownership fails closed instead of inventing replacement evidence.
+  if (!fs.existsSync(path.join(repoRoot, match.path))) return {};
+  const source = {
+    path: match.path,
+    sha256: hashFile(path.join(repoRoot, match.path)),
+  };
+  return Object.fromEntries(
+    ["networkWaitMs", "modelWaitMs"].map((k) => [
+      k,
+      {
+        requirement: "not-applicable",
+        reason: match.reason,
+        productionSource: source,
+        requiresLoopbackGuard: true,
+      },
+    ]),
+  );
+}
+export function validateNotApplicable(metric, policy, availability, execution) {
+  const p = policy?.[metric],
+    a = availability?.[metric];
+  if (p?.requirement !== "not-applicable") return false;
+  return (
+    a?.status === "not-applicable" &&
+    a.reason === p.reason &&
+    JSON.stringify(a.productionSource) === JSON.stringify(p.productionSource) &&
+    execution?.externalAttempts === 0 &&
+    ["fetch", "http", "https", "socket", "chromium"].every((x) =>
+      execution.networkGuardLayers?.includes(x),
+    )
+  );
+}
