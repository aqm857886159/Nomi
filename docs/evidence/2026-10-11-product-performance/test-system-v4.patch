+  } catch {
+    return { status: "unavailable", count };
+  }
+}
+// A host that cannot identify processes must reject before it starts a detached
+// workload. Identity becoming unavailable later remains an unconfirmed cleanup.
+export function assertOwnedDispatchInspection({snapshot=readProcessSnapshot,stamp=birthStamp,pid=process.pid,uid=process.getuid?.()}={}) {
+  try {
+    const token=stamp(pid),self=snapshot().find(row=>row.pid===pid);
