+  writeJson,
+  cloneOwned,
+  hashFile,
+} from "./baseline-config.mjs";
+import { prepareBaseline } from "./prepare-baseline.mjs";
+import { baselinePlan } from "./baseline-plan.mjs";
+import { importBaseline } from "./baseline-import.mjs";
+const args = process.argv.slice(2),
+  command = args.shift(),
+  arg = (k, fallback) => {
+    const i = args.indexOf("--" + k);
+    return i < 0 ? fallback : args[i + 1];
+  };
+const configFile = path.resolve(
+  arg("config", process.env.NOMI_QUALITY_CONFIG || "quality.local.json"),
+);
+const c = readConfig(configFile),
+  here = path.dirname(fileURLToPath(import.meta.url)),
+  runnerRoot = path.resolve(here, "../../tests/quality-system/baseline");
+const plan = baselinePlan({
+  suites: arg("suites")?.split(","),
+  executionKind: arg("execution-kind", "performance"),
+  scales: arg("scales")?.split(","),
+  scenarios: arg("scenarios", "").split(",").filter(Boolean),
+});
+const publicWrite = (name, value) =>
+  writeJson(path.join(c.outputDir, name), value);
+
+function prepareJob(job) {
+  const runId = crypto.randomUUID(),
+    runPrivateDir = path.join(c.privateRoot, "runs", runId),
+    jobRoot = path.join(runPrivateDir, "fixture-seed");
+  fs.mkdirSync(jobRoot, { recursive: true });
+  const fixtures = JSON.parse(fs.readFileSync(c.fixtureIndex, "utf8")).map(
+    (f) => {
+      const dest = path.join(jobRoot, "projects", f.scale);
+      cloneOwned(f.projectRoot, dest);
+      const record = JSON.parse(
+        JSON.stringify(f.record).replaceAll(f.projectRoot, dest),
+      );
+      record.lastKnownRootPath = dest;
+      for (const rel of ["project.json", ".nomi/project.json"])
+        writeJson(path.join(dest, rel), record);
+      return { ...f, record, projectRoot: dest };
+    },
+  );
