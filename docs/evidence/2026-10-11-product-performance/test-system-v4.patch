+// No Electron. Pure ownership tests plus an explicit opt-in harmless Node process repro.
+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
+import {createRequire} from 'node:module';
+import {PassThrough} from 'node:stream';
+const require=createRequire(import.meta.url);
+const stamp='Sun Oct 11 12:00:00 2026';
+const owned=[{pid:100,startToken:stamp,kind:'owned-dispatch-child',processGroup:100},{pid:110,startToken:stamp,profile:'/tmp/owned-profile',kind:'owned-child'}];
+const processRow=(pid,extra={})=>({pid,ppid:1,pgid:100,uid:501,startToken:stamp,command:'helper --user-data-dir=/tmp/owned-profile',...extra});
+test('late orphan helper is found by owned group or exact owned profile after the parent has exited',()=>{
+ const {selectResidualProcesses}=require('../../scripts/quality-system/owned-process-snapshot.cjs');
+ const r=selectResidualProcesses(owned,[processRow(120),processRow(121,{pgid:900})],{uid:501});
+ assert.equal(r.complete,true);assert.deepEqual(r.rows.map(x=>x.pid),[120,121]);
+});
+test('profile prefix, other UID, older process and reused leader are never signalled by residual scan',()=>{
+ const {selectResidualProcesses}=require('../../scripts/quality-system/owned-process-snapshot.cjs');
+ const rows=[processRow(120,{pgid:900,command:'helper --user-data-dir=/tmp/owned-profile-other'}),processRow(121,{uid:502}),processRow(122,{startToken:'Sun Oct 11 11:59:59 2026'}),processRow(100,{startToken:'Sun Oct 11 12:01:00 2026'}),processRow(123,{command:'unrelated'})];
+ assert.deepEqual(selectResidualProcesses(owned,rows,{uid:501}).rows,[]);
+});
+test('failed/truncated process inventory or unknown birth identity cannot certify residual absence',()=>{
+ const {selectResidualProcesses,parseProcessSnapshot}=require('../../scripts/quality-system/owned-process-snapshot.cjs');
+ assert.throws(()=>parseProcessSnapshot('not a complete ps row'),/inventory/);
+ assert.equal(selectResidualProcesses([{...owned[0],startToken:null}],[],{uid:501}).complete,false);
+});
+test('repeated residual rounds register late arrivals, confirm their exit, and fail closed when scans fail',async()=>{
+ const {cleanupOwnedTree}=await import('../../scripts/quality-system/native-process.mjs');
+ const dir=fs.mkdtempSync(path.join(os.tmpdir(),'nomi-owned-lifecycle-'));try {
+  const file=path.join(dir,'owners');fs.writeFileSync(file,owned.map(r=>JSON.stringify(r)).join('\n')+'\n');
+  let scans=0;const live=new Set([120]);const r=await cleanupOwnedTree(file,{uid:501,snapshot:()=>++scans===1?[processRow(120)]:[],alive:pid=>live.has(pid),stamp:()=>stamp,signal:pid=>live.delete(pid),wait:async()=>{}});
+  assert.equal(r.confirmed,true);assert.equal(live.size,0);assert.ok(scans>=3);assert.equal(r.residualInventory.complete,true);
+  const blocked=await cleanupOwnedTree(file,{uid:501,snapshot:()=>{throw Error('denied');},alive:()=>false,wait:async()=>{}});assert.equal(blocked.confirmed,false);
+ }finally{fs.rmSync(dir,{recursive:true,force:true});}
+});
+test('dispatch inspection denies missing identity before any detached workload can start',async()=>{
+ const {assertOwnedDispatchInspection}=await import('../../scripts/quality-system/native-process.mjs');
+ const good={pid:100,uid:501,stamp:()=>stamp,snapshot:()=>[processRow(100)]};
+ assert.equal(assertOwnedDispatchInspection(good).status,'available');
+ for(const patch of [{stamp:()=>null},{snapshot:()=>{throw Error('denied');}},{snapshot:()=>[processRow(100,{uid:502})]},{snapshot:()=>[]}])
+  assert.throws(()=>assertOwnedDispatchInspection({...good,...patch}),/no workload dispatched/);
+});
+test('unconfirmed return closes caller pipe handles without manufacturing an exit claim',async()=>{
+ const {closeOwnedProcessHandles}=await import('../../scripts/quality-system/native-process.mjs');
+ const child={stdout:new PassThrough(),stderr:new PassThrough(),unref(){this.unreferenced=true;}},out=new PassThrough(),err=new PassThrough();
+ child.stdout.pipe(out);child.stderr.pipe(err);
+ const cleanup={confirmed:false};closeOwnedProcessHandles(child,out,err,cleanup);
