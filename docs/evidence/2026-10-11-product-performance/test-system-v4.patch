+  }catch {throw Error('OWNED_PROCESS_INSPECTION_UNAVAILABLE: no workload dispatched');}
+}
+export function closeOwnedProcessHandles(child,stdout,stderr,{confirmed=false}={}) {
+  child.stdout?.unpipe(stdout);child.stderr?.unpipe(stderr);
+  // unref(child) alone leaves its readable pipe handles keeping the caller alive.
+  // Closing our pipe ends changes no cleanup claim and never releases the lock.
+  child.stdout?.destroy();child.stderr?.destroy();stdout.end();stderr.end();
+  if(!confirmed)child.unref();
+}
+export async function cleanupOwnedTree(file,{snapshot=readProcessSnapshot,uid=process.getuid?.(),wait=pause,...ops}={}) {
+  let rounds=0,emptyRounds=0,terminated=0,last={confirmed:false,unconfirmed:1};
+  for(;rounds<5;rounds++) {
