+      const axesReceipt = observedAxes(f, cell),
+        axes = axesReceipt.axes;
+      const scenarioId = `${executionKind==="functional-smoke"?"smoke":"perf"}:${cell.scenario}:${cell.alias}:${cell.cache}`;
+      const receipt = {
+        schemaVersion: 1,
+        source: meta.source,
+        suite: meta.suite,
+        scenario: cell.scenario,
+        scale: cell.alias,
+        sourceStatus: cell.status,
+        sampleCount: cell.samples?.length ?? 0,
+        sampleIdentity,
+        traceMarkedSamples: (cell.samples ?? []).filter((s) =>
+          sampleMarkersPresent(s, markers),
+        ).length,
+        guard: {
+          layers: guard.networkGuardLayers,
+          externalAttempts: guard.externalAttempts,
+          guardErrors: guard.guardErrors,
+          logCount: guard.logCount,
+        },
+        traceInventory: traces.map(({ privateName, ...r }) => r),
+        rawDigest: hashFile(file),
+      };
+      const receiptName = `receipts/${hash(scenarioId + raw.runId).slice(0, 24)}.json`;
+      writeJson(path.join(c.outputDir, receiptName), receipt);
+      // Evidence points to sanitized attestations, not exported private trace data. A trace receipt is distinct from the trace itself.
+      const privateReceipt = "evidence/" + path.basename(receiptName);
+      writeJson(path.join(c.privateRoot, privateReceipt), receipt);
+      const evidence = [
+        {
+          kind: "receipt",
+          path: privateReceipt,
+          sha256: hashFile(path.join(c.privateRoot, privateReceipt)),
+        },
+      ];
+      for (const t of traces) {
+        const opaque = "evidence/" + t.sha256 + ".trace";
+        const dest = path.join(c.privateRoot, opaque);
+        if (!fs.existsSync(dest))
+          fs.linkSync(path.join(dir, t.privateName), dest);
+        evidence.push({ kind: "trace", path: opaque, sha256: t.sha256 });
+      }
+      const r = completionResult(cell, {
+        scenarioId,
+        protocol: {
+          id: raw.protocol?.protocolVersion ?? null,
+          executionKind,
+          batchProtocol:raw.protocol.batchProtocol??null,
+          instrumentationVersion: raw.protocol?.instrumentationVersion ?? null,
+          feedbackProbeMode: raw.protocol?.feedbackProbeMode ?? null,
+          cache: cell.cache,
+          scale: cell.alias,
+          counts: axes.imageVideo,
+          axes,
+          warmupRuns: raw.protocol?.warmup,
+          measuredRuns:
+            cell.scenario === "project-reopen-30" ? 30 : measuredRuns,
+          cycles: 1,
+          ...(cell.scenario === "project-reopen-30"
+            ? {
+                measuredCycles: 30,
+                seriesRuns: 1,
+                sampleUnit: "one open-close cycle",
+              }
+            : {}),
+          fixtureDigest: cell.fixtureDigest ?? f.fixtureDigest,
+          fixtureVersion: cell.fixtureVersion ?? f.fixtureVersion,
+          metadataIntegrity: cell.metadataIntegrity ?? f.metadataIntegrity,
+          layoutIntegrity: cell.layoutIntegrity ?? f.layoutIntegrity,
+          mediaProfile:
+            meta.suite === "group-generation" ? null : f.mediaProfile,
+          fixtureVariant:
+            meta.suite === "group-legacy"
+              ? "legacy-rejected-edges+metadata-layout-v2"
+              : f.fixtureVariant,
+          frameWindows: {
+            observation: raw.protocol?.sampleWindow,
+            activeGesture: "trusted input to actionCompletedAt",
+          },
+        },
+        execution: {
+          realUserActions: true,
+          renderer: "electron",
+          networkGuardLayers: guard.networkGuardLayers,
+          externalAttempts: guard.externalAttempts,
+        },
+        evidence,
+      });
+      for (const [metric, policy] of Object.entries(
+        metricPolicyFor(cell.scenario, c.repoRoot),
+      )) {
+        if (guard.externalAttempts === 0 && guard.guardErrors === 0)
+          r.availability[metric] = {
+            status: "not-applicable",
+            reason: policy.reason,
+            productionSource: policy.productionSource,
+          };
+      }
+      r.axisReceipt = axesReceipt;
+      r.measuredEnvironment = env;
+      r.traceAttestation = {
+        status: traces.length ? "present-private" : "missing",
+        count: traces.length,
+        requiresLocalTraceVerification: true,
+      };
+      // Local gate can verify traces without exporting them: copy no raw trace into public output.
+      r.privateEvidence = traces.map((t) => ({
+        kind: "trace",
+        path: t.privateName,
+        sha256: t.sha256,
+      }));
+      r.receiptStatus =
+        sampleIdentity.status === "complete" &&
+        axesReceipt.status === "observed" &&
+        r.status === "passed" &&
+        r.assertions.every((a) => a.passed === true) &&
+        cell.status === "executed" &&
+        cell.samples?.filter((s) => !s.isWarmup).length ===
+          (cell.scenario === "project-reopen-30" ? 30 : measuredRuns) &&
+        cell.samples.every((s) => s.summary?.functionalPassed === true) &&
+        traces.length &&
+        cell.samples.every((s) => sampleMarkersPresent(s, markers)) &&
+        guard.externalAttempts === 0 &&
+        ["fetch", "http", "https", "socket", "chromium"].every((l) =>
+          guard.networkGuardLayers.includes(l),
+        )
+          ? "collected"
+          : "incomplete";
+      r.executionKind=executionKind;
+      r.performanceClaim=executionKind==="performance";
+      candidate.results.push(r);
+    }
+    candidate.imports.push({
+      suite: meta.suite,
+      rawDigest: hashFile(file),
+      cells: raw.cells?.length ?? 0,
+      traceCount: traces.length,
+    });
+  }
+  const exportCandidate = structuredClone(candidate);
+  for (const r of exportCandidate.results) delete r.privateEvidence;
+  writeJson(path.join(c.outputDir, "candidate.json"), exportCandidate);
+  return candidate;
+}
