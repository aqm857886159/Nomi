+ const source=fs.readFileSync(entry,'utf8'),line=source.split('\n').find(s=>s.trim().startsWith('const status ='));
+ assert.ok(line);
+ const status=new Function('cleanupConfirmed','originalStatus','traceCount','traceErrors',line+';return status;');
+ for(const original of ['clean','red','broken'])assert.equal(status(false,original,1,0),'broken');
+ assert.equal(status(true,'clean',1,0),'clean');assert.equal(status(true,'clean',0,0),'broken');assert.equal(status(true,'clean',1,1),'broken');
+ const projection=source.split('\n').find(s=>s.trim().startsWith('runs: summary.runs.map')).trim().slice(6).replace(/,$/,'');
