+        const before = bv.values[metric];
+        if (!finite(before)) continue;
+        const delta = value - before,
+          noise = METRICS[metric]?.noise ?? 0;
+        if (
+          !["networkWaitMs", "modelWaitMs"].includes(metric) &&
+          delta > noise &&
+          delta > Math.abs(before) * 0.1
+        )
+          regressions.push({
+            metric,
+            before,
+            after: value,
+            delta,
+            ratio: before === 0 ? null : delta / Math.abs(before),
+          });
+      }
+    }
+    rows.push({
+      scenarioId: id,
+      sourceStatus: r?.status ?? "unverified",
+      status: v.errors.length
+        ? "incomplete"
+        : regressions.length
+          ? "regression"
+          : "passed",
+      errors: v.errors,
+      metrics: v.values,
+      targets: v.targets,
+      regressions,
+    });
+  }
+  return {
+    schemaVersion: 1,
+    scope: scenarioIds ? "change" : "full",
+    pass:
+      errors.length === 0 &&
+      rows.length === required.length &&
+      rows.every((r) => r.status === "passed"),
+    errors,
+    counts: {
+      required: required.length,
+      passed: rows.filter((r) => r.status === "passed").length,
+      incomplete: rows.filter((r) => r.status === "incomplete").length,
+      regressions: rows.filter((r) => r.status === "regression").length,
+    },
+    rows,
+  };
+}
