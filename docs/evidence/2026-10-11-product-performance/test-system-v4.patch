+export function evaluate({
+  catalog,
+  candidate,
+  baseline = null,
+  evidenceRoot = ".",
+  baselineEvidenceRoot = evidenceRoot,
+  scenarioIds = null,
+  verifyFiles = true,
+}) {
+  const errors = checkRun(candidate),
+    rows = [];
+  if (baseline)
+    errors.push(
+      ...checkRun(baseline).map((x) => `baseline: ${x}`),
+      ...compareConditions(baseline, candidate),
+    );
+  const required = scenarioIds ?? catalog.scenarios.map((s) => s.id);
+  if (!required.length) errors.push("empty required scenario set");
+  const byId = new Map();
+  for (const r of candidate?.results ?? []) {
+    if (byId.has(r.scenarioId))
+      errors.push(`duplicate result: ${r.scenarioId}`);
+    byId.set(r.scenarioId, r);
+    if (!catalog.scenarios.some((s) => s.id === r.scenarioId))
+      errors.push(`unknown result: ${r.scenarioId}`);
+  }
+  for (const id of required) {
+    const s = catalog.scenarios.find((x) => x.id === id);
+    if (!s) {
+      errors.push(`unknown required scenario: ${id}`);
+      continue;
+    }
+    const r = byId.get(id),
+      v = validateResult(s, r, evidenceRoot, { verifyFiles, run: candidate }),
+      regressions = [];
+    if (baseline && s.kind === "performance") {
+      const b = baseline.results?.find((x) => x.scenarioId === id),
+        bv = validateResult(s, b, baselineEvidenceRoot, { verifyFiles, run: baseline });
+      v.errors.push(...bv.errors.map((x) => `baseline: ${x}`));
+      if (JSON.stringify(b?.protocol) !== JSON.stringify(r?.protocol))
+        v.errors.push("scenario protocol mismatch");
