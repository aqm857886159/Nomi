+      },
+    },
+    axes: AXES,
+    milestones: MILESTONES,
+    pairwiseExcluded: cross.excluded,
+    features,
+    unavailableCapabilities: [
+      {
+        feature: "P27",
+        actions: ["agent-concurrent-stream-canvas"],
+        scales: ["small", "typical", "heavy"],
+        status: "source-unavailable",
+        scope: "more than one active stream in the same project",
+        source: [{path:"electron/agentLane/laneWorkspace.mts",sha256:hashFile(path.join(repo,"electron/agentLane/laneWorkspace.mts")),contract:"switchTo awaits active.close before openOne"}],
+        replacement: "agent-session-switch-cancels-stream",
+        historyPolicy: "retain prior unsupported receipts; never convert to passed",
+        reason: "The exposed session switch closes the prior lane. The replacement verifies cancellation and retained interruption receipts; no concurrent-stream performance success is required for an unavailable capability.",
