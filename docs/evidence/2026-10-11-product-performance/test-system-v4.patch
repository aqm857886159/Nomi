+test('portable new runners use owned index/common and retain workload/clipboard guards',()=>{for(const name of ['document-format-gap-completion','ui-gap-completion','task-center-gap-completion']){const s=fs.readFileSync(new URL(`./baseline/${name}.mjs`,import.meta.url),'utf8');assert.ok(s.includes('./completion-common.mjs'));assert.ok(s.includes('actualFixtureIndex'));assert.ok(!s.includes('/bin/cp'));assert.ok(!s.includes('2026-10-11'));}const s=fs.readFileSync(new URL('./baseline/ui-gap-completion.mjs',import.meta.url),'utf8');assert.ok(s.includes('verifyNativeWorkload'));assert.ok(s.includes('restoreClipboard(originalClipboard)'));});
