@@ -0,0 +1,188 @@
+// Independent axes. A workspace is a categorical surface; project-library size is a separate axis.
+export const AXES = {
+  nodes: { small: 6, typical: 48, heavy: 320 },
+  imageVideo: {
+    small: { images: 4, videos: 2 },
+    typical: { images: 24, videos: 24 },
+    heavy: { images: 160, videos: 160 },
+  },
+  uniqueMediaAssets: { small: 3, typical: 48, heavy: 320 },
+  documents: { small: 2, typical: 24, heavy: 160 },
+  shots: { small: 12, typical: 48, heavy: 320 },
+  clips: { small: 4, typical: 24, heavy: 160 },
+  agentSessions: { small: 2, typical: 5, heavy: 10 },
+  libraryProjects: { small: 3, typical: 24, heavy: 401 },
+  cache: { cold: "cold", hot: "hot" },
+  workspace: {
+    creation: "creation",
+    storyboard: "storyboard",
+    generation: "generation",
+    preview: "preview",
+  },
+};
+const byFeature = {
+  P01: ["libraryProjects"],
+  P02: [
+    "nodes",
+    "imageVideo",
+    "documents",
+    "shots",
+    "clips",
+    "agentSessions",
+    "libraryProjects",
+    "cache",
+    "workspace",
+  ],
+  P03: ["libraryProjects"],
+  P04: ["documents", "shots", "cache"],
+  P05: ["shots"],
+  P06: ["shots", "imageVideo"],
+  P09: ["nodes", "imageVideo"],
+  P17: ["nodes", "clips"],
+  P19: ["nodes", "imageVideo", "clips"],
+  P22: ["clips", "shots", "imageVideo"],
+  P23: ["clips", "shots"],
+  P24: ["clips", "imageVideo"],
+  P25: ["clips", "shots", "imageVideo"],
+  P26: ["clips", "imageVideo"],
+  P27: ["agentSessions", "documents", "workspace"],
+  P28: ["agentSessions", "nodes", "workspace"],
+  P29: ["agentSessions"],
+  P30: ["agentSessions"],
+  P31: ["agentSessions", "shots"],
+  P32: ["shots", "agentSessions", "workspace"],
+  P33: ["shots", "agentSessions", "workspace"],
+  P34: ["agentSessions"],
+  P35: ["agentSessions"],
+  P36: ["nodes", "imageVideo"],
+  P37: ["nodes", "clips", "agentSessions"],
+  P38: ["workspace"],
+  UI_PROMPT_LIBRARY: ["nodes","imageVideo","documents","workspace"],
+};
+for (const id of [
+  "P07",
+  "P08",
+  "P10",
+  "P11",
+  "P12",
+  "P13",
+  "P14",
+  "P15",
+  "P16",
+  "P18",
+  "P20",
+  "P21",
+  "R07",
+])
+  byFeature[id] = ["nodes", "imageVideo"];
+for (const id of ["T1", "T2", "T3", "T4", "T5"])
+  byFeature[id] = [
+    "nodes",
+    "imageVideo",
+    "documents",
+    "shots",
+    "clips",
+    "agentSessions",
+    "workspace",
+  ];
+export const BASE_AXES = Object.fromEntries(
+  Object.entries(AXES).map(([axis, values]) => [
+    axis,
+    values[
+      axis === "cache" ? "hot" : axis === "workspace" ? "generation" : "small"
+    ],
+  ]),
+);
+export const applicableAxes = (ids) => [
+  ...new Set(
+    ids
+      .flatMap((id) => byFeature[id] ?? ["workspace"])
+      .flatMap((axis) =>
+        axis === "imageVideo" ? [axis, "uniqueMediaAssets"] : [axis],
+      ),
+  ),
+];
+function valid(values) {
+  return values.nodes >= values.imageVideo.images + values.imageVideo.videos;
+}
+function caseFor(label, overrides) {
+  const values = { ...BASE_AXES, ...overrides };
+  if (
+    values.uniqueMediaAssets >
+    values.imageVideo.images + values.imageVideo.videos
+  )
+    values.imageVideo =
+      values.uniqueMediaAssets === 48
+        ? AXES.imageVideo.typical
+        : AXES.imageVideo.heavy;
+  if (!valid(values))
+    values.nodes = values.imageVideo.images + values.imageVideo.videos;
+  return { label, values };
+}
+export function dimensionCases(axes) {
+  const cases = [];
+  for (const axis of axes)
+    for (const [level, value] of Object.entries(AXES[axis]))
+      cases.push(caseFor(`${axis}-${level}`, { [axis]: value }));
+  const allHeavy = Object.fromEntries(
+    axes.map((axis) => [
+      axis,
+      AXES[axis][
+        axis === "cache" ? "hot" : axis === "workspace" ? "generation" : "heavy"
+      ],
+    ]),
+  );
+  cases.push(caseFor("all-heavy", allHeavy));
+  return cases;
+}
+// Each feasible pair value combination is explicit. Illegal total-node/media combinations are excluded with a reason.
+export function pairwiseCases(axes) {
+  const cases = [],
+    excluded = [];
+  for (let i = 0; i < axes.length; i++)
+    for (let j = i + 1; j < axes.length; j++)
+      for (const [a, av] of Object.entries(AXES[axes[i]]))
+        for (const [b, bv] of Object.entries(AXES[axes[j]])) {
+          const label = `${axes[i]}-${a}--${axes[j]}-${b}`,
+            overrides = { [axes[i]]: av, [axes[j]]: bv };
+          if (
+            axes[i] === "nodes" &&
+            axes[j] === "imageVideo" &&
+            av < bv.images + bv.videos
+          ) {
+            excluded.push({
+              label,
+              reason: "total nodes cannot be fewer than image+video nodes",
+            });
+            continue;
+          }
+          const totalMedia = overrides.imageVideo
+            ? overrides.imageVideo.images + overrides.imageVideo.videos
+            : null;
+          if (
+            (overrides.nodes !== undefined &&
+              overrides.uniqueMediaAssets > overrides.nodes) ||
+            (totalMedia !== null && overrides.uniqueMediaAssets > totalMedia)
+          ) {
+            excluded.push({
+              label,
+              reason:
+                "unique media assets cannot exceed media/total node count in this canvas fixture",
+            });
+            continue;
+          }
+          cases.push(caseFor(label, overrides));
+        }
+  return { cases, excluded };
+}
+export function sameAxes(expected, actual) {
+  return (
+    !!actual &&
+    Object.keys(AXES).every((key) =>
+      key === "imageVideo"
+        ? expected[key].images === actual[key]?.images &&
+          expected[key].videos === actual[key]?.videos
+        : expected[key] === actual[key],
+    )
+  );
+}
