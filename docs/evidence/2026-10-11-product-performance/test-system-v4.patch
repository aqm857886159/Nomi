+const request=(i,scenarioId)=>({requestId:"request-"+i,scenarioId,body:{model:"deepseek-flash",messages:[{role:"system",content:"Reply briefly."},{role:"user",content:"Count from one to twenty."}],max_tokens:128,stream:true,thinking:{type:"disabled"}},origin:"https://api.deepseek.com",method:"POST",endpointPath:"/v1/chat/completions",syntheticContext:true,autoRetries:0});
+test("shared persisted ledger gives only three serial permits and keeps unknown cancelled cost",()=>{
