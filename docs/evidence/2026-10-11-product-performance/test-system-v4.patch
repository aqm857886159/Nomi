+import os from "node:os";
+import { execFileSync } from "node:child_process";
+export function capturePower({
+  platform = os.platform(),
+  exec = execFileSync,
+} = {}) {
+  const sampledAt = new Date().toISOString();
+  if (platform !== "darwin")
+    return {
+      status: "unknown",
+      sampledAt,
+      reason: "PLATFORM_POWER_PROBE_UNSUPPORTED",
+    };
+  try {
+    const battery = exec("pmset", ["-g", "batt"], {
+        encoding: "utf8",
+        stdio: ["ignore", "pipe", "pipe"],
+      }),
+      settings = exec("pmset", ["-g"], {
+        encoding: "utf8",
+        stdio: ["ignore", "pipe", "pipe"],
+      }),
+      source = battery.includes("'AC Power'")
+        ? "ac"
+        : battery.includes("'Battery Power'")
+          ? "battery"
+          : null,
+      lowPowerMode = settings.match(/\blowpowermode\s+(\d+)/)?.[1];
+    if (source === null || lowPowerMode === undefined)
+      return {
+        status: "unknown",
+        sampledAt,
+        reason: "POWER_FIELDS_UNAVAILABLE",
+      };
+    return {
+      status: "measured",
+      sampledAt,
+      source,
+      lowPowerMode: Number(lowPowerMode),
+      powerMode: `${source}:lowpowermode=${lowPowerMode}`,
+    };
+  } catch {
+    return { status: "unknown", sampledAt, reason: "POWER_PROBE_UNAVAILABLE" };
+  }
+}
+export function captureHost() {
+  const power = capturePower();
+  return {
+    platform: os.platform(),
+    arch: os.arch(),
+    osVersion: os.release(),
+    hardwareClass: `${os.arch()} ${os.cpus()[0]?.model || "unknown-cpu"} ${os.cpus().length} logical-cpus`,
+    powerMode: power.powerMode ?? null,
+    powerSnapshot: power,
+    buildKind: "production-build-dev-electron",
+  };
+}
