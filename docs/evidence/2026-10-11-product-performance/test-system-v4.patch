+    last=await cleanupOwned(file,{...ops,wait});terminated+=last.terminated??0;
+    if(!last.confirmed)return {...last,terminated,residualInventory:{complete:true,rounds:rounds+1,emptyRounds}};
+    if(emptyRounds>=2)return {...last,terminated,residualInventory:{complete:true,rounds:rounds+1,emptyRounds,proof:'owned-pid-birth + owned-profile/group residual absence'}};
+    await wait(100);
+  }
+  return {...last,confirmed:false,terminated,reason:'RESIDUAL_PROCESSES_STILL_APPEARING',unconfirmed:Math.max(1,last.unconfirmed??0),residualInventory:{complete:false,rounds,emptyRounds}};
+}
+
+export async function runOwnedProcess(command,args,{cwd,env,timeoutMs=25*60*1000,ownersFile,stdoutFile,stderrFile}={}) {
+  if(unconfirmedExitSeen||queueInterrupted)throw Error('Native queue stopped after unresolved cleanup or interruption');
+  let child,startToken,stdout,stderr,stdoutFd,stderrFd,completion,settle;
+  let timedOut=false,spawnError=null,interrupted=null,status=null,timeoutDescendants=null,terminating=false;
+  let timeout,force,abandon,cleanup,setupError;
+  const requestTermination=()=>{
+    if(terminating||!child?.pid||child.exitCode!==null||child.signalCode!==null)return;
+    terminating=true;
+    timeoutDescendants=captureOwnedDescendants(child.pid,ownersFile,{expectedStart:startToken});
+    if(sameStamp(birthStamp(child.pid),startToken))try{child.kill('SIGTERM');}catch{}
+    force=setTimeout(()=>{if(sameStamp(birthStamp(child.pid),startToken))try{child.kill('SIGKILL');}catch{}},2000);
