+export const UI_TEXT_GROUPS = {
+ 'document-gaps':['document-native-copy-paste','document-delete-cancel','document-rename-escape','document-rename-blur'],
+ 'public-prompts':['prompt-public-source-filter','prompt-public-group-expand-collapse','prompt-public-copy'],
+ prompts:['prompt-drawer-open','prompt-required-validation','prompt-create-cancel','prompt-create-image','prompt-create-video','prompt-edit-content-type','prompt-search-and-clear','prompt-category-filter','prompt-preview-keyboard','prompt-send-image-to-canvas','prompt-send-video-to-canvas','prompt-delete','prompt-delete-undo'],
