new file mode 100644
--- /dev/null
+++ b/tests/quality-system/baseline/milestones.mjs
@@ -0,0 +1,66 @@
+// Selectors are explicit per workflow family; a missing target remains unsupported.
+export function feedbackSelector(scenario) {
+  if (scenario.startsWith("group-")) return ".generation-canvas-v2__stage";
+  if (scenario.startsWith("canvas-") || scenario === "video-hover")
+    return ".generation-canvas-v2__stage";
+  if (scenario.startsWith("timeline-")) return ".workbench-preview";
+  if (scenario.startsWith("storyboard-")) return "[data-storyboard-editor]";
+  if (scenario.startsWith("document")) return '[aria-label="创作文档编辑区"]';
+  if (scenario.startsWith("agent-")) return null; // Streaming itself is not feedback to an unrelated concurrent action
+  if (scenario.startsWith("project-")) return "[data-shell-project-menu]";
+  return null;
+}
+export async function confirmInteractive(instance, sample) {
+  const w = instance.win,
+    menu = w.locator("[data-shell-project-menu]");
+  if (!(await menu.isVisible().catch(() => false)))
+    return { interactiveUnsupported: true };
+  const before = await menu.getAttribute("aria-expanded");
+  // A fresh trusted click and a visible matching state change are required.
+  await w.evaluate(() => {
+    const p = window.__workflowProbe;
+    if (!p) return;
+    p.ackDispatchAt = performance.now();
+    const fn = (e) => {
+      if (e.isTrusted && e.target?.closest("[data-shell-project-menu]")) {
+        p.ackInputAt = performance.now();
+        document.removeEventListener("pointerdown", fn, true);
+      }
+    };
+    document.addEventListener("pointerdown", fn, true);
+  });
+  await menu.click();
+  await w.waitForFunction(
+    (previous) => {
+      const m = document.querySelector("[data-shell-project-menu]"),
+        p = window.__workflowProbe;
+      if (!m || !p || p.ackInputAt == null) return false;
+      const r = m.getBoundingClientRect();
+      if (
+        r.width > 0 &&
+        r.height > 0 &&
+        m.getAttribute("aria-expanded") !== previous
+      ) {
+        p.ackAt = performance.now();
+        return true;
+      }
+      return false;
+    },
+    before,
+    { polling: "raf", timeout: 5000 },
+  );
+  const a = await w.evaluate(() => {
+    const p = window.__workflowProbe;
+    return {
+      interactiveConfirmedUpperBoundMs: p.ackAt - p.inputAt,
+      controlResponseMs: p.ackAt - p.ackInputAt,
+      controlDispatchGapMs: p.ackInputAt - p.readyAt,
+      feedbackMs:
+        p.separateFeedbackAt == null ? null : p.separateFeedbackAt - p.inputAt,
+      trustedControlAcknowledged: true,
+    };
+  });
+  if ((await menu.getAttribute("aria-expanded")) === "true")
+    await w.keyboard.press("Escape");
+  return a;
+}
