+                ),
+              "all member move",
+            );
+          },
+          verify: async () => {
+            const r = await committed;
+            const after = r.payload.generationCanvas,
+              g = before.groups[0],
+              a = after.nodes.find((n) => n.id === g.nodeIds[0]),
+              b = before.nodes.find((n) => n.id === a.id),
+              dx = a.position.x - b.position.x,
+              dy = a.position.y - b.position.y;
+            for (const n of after.nodes) {
+              const old = before.nodes.find((o) => o.id === n.id);
+              assert(
+                n.position.x - old.position.x ===
+                  (g.nodeIds.includes(n.id) ? dx : 0) &&
