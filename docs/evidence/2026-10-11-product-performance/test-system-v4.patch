new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/owned-child-preload.cjs
@@ -0,0 +1,35 @@
+// Shared owned lifecycle observer. No scans run periodically during measurements.
+'use strict';
+const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process');
+const {readProcessSnapshot,sameStamp}=require('./owned-process-snapshot.cjs');
+const file=process.env.NOMI_QUALITY_OWNERS;
+if(file) {
+ const ps=cp.execFileSync;
+ const stamp=pid=>{try{return ps('/bin/ps',['-p',String(pid),'-o','lstart='],{encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim()||null;}catch{return null;}};
+ const profileFrom=args=>{const a=Array.isArray(args)?args:[];for(let i=0;i<a.length;i++){if(typeof a[i]!=='string')continue;if(a[i].startsWith('--user-data-dir='))return a[i].slice(16);if(a[i]==='--user-data-dir')return a[i+1];}return null;};
+ const record=(pid,kind,args=[])=>{
+  if(!Number.isInteger(pid)||pid<=1)return;
+  const row={pid,startToken:stamp(pid),kind},profile=profileFrom(args);
+  if(profile){try {if(!path.isAbsolute(profile))throw Error('not absolute');row.profile=profile;row.profileCanonical=fs.realpathSync(profile);row.profileSource='owned-launch-user-data-dir';}catch{row.scopeError='OWNED_PROFILE_UNRESOLVED';}}
+  fs.appendFileSync(file,JSON.stringify(row)+'\n',{mode:0o600});return row;
+ };
+ const own=record(process.pid,'owned-runner',process.argv);
+ const captured=new Set();
+ const capture=kind=>{
+  if(captured.has(kind))return;captured.add(kind);
+  try {
+   const snapshot=readProcessSnapshot(),self=snapshot.find(p=>p.pid===process.pid);
+   if(!self||!sameStamp(self.startToken,own?.startToken))throw Error('owner identity unavailable');
+   const seen=new Set([process.pid]),queue=[process.pid];
+   while(queue.length){const pid=queue.shift();for(const child of snapshot.filter(p=>p.ppid===pid)){if(seen.has(child.pid))continue;if(seen.size>=256)throw Error('owned descendants limit');seen.add(child.pid);queue.push(child.pid);fs.appendFileSync(file,JSON.stringify({pid:child.pid,startToken:child.startToken,kind})+'\n');}}
+  }catch{fs.appendFileSync(file,JSON.stringify({pid:process.pid,startToken:own?.startToken,kind:'owned-exit-capture',captureError:'DESCENDANT_SNAPSHOT_UNAVAILABLE'})+'\n');}
+ };
+ process.once('exit',()=>capture('owned-pre-exit-descendant'));
+ if(process.versions.electron&&process.type==='browser') {
+  try {const {app}=require('electron');app.once('will-quit',()=>capture('owned-will-quit-descendant'));}catch{}
+ }
+ for(const name of ['spawn','fork','execFile','exec']) {
+  const original=cp[name];cp[name]=function(...args){const child=Reflect.apply(original,this,args);record(child?.pid,'owned-child',Array.isArray(args[1])?args[1]:[]);return child;};
+ }
+ require('node:module').syncBuiltinESMExports();
+}
diff --git a/scripts/quality-system/owned-process-snapshot.cjs b/scripts/quality-system/owned-process-snapshot.cjs
new file mode 100644
--- /dev/null
+++ b/scripts/quality-system/owned-process-snapshot.cjs
@@ -0,0 +1,47 @@
+'use strict';
+const path=require('node:path');
+const {execFileSync}=require('node:child_process');
+const normalizedStamp=value=>typeof value==='string'?value.trim().replace(/\s+/g,' '):null;
+const sameStamp=(a,b)=>Boolean(a&&b&&normalizedStamp(a)===normalizedStamp(b));
+function parseProcessSnapshot(text) {
+ if(typeof text!=='string'||!text.trim())throw Error('process inventory empty');
+ return text.trim().split('\n').map(line=>{
+  const m=line.trim().match(/^(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+([A-Za-z]{3}\s+[A-Za-z]{3}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}\s+\d{4})\s+(.+)$/);
+  if(!m)throw Error('process inventory malformed or truncated');
+  return {uid:Number(m[1]),pid:Number(m[2]),ppid:Number(m[3]),pgid:Number(m[4]),startToken:normalizedStamp(m[5]),command:m[6]};
+ });
+}
+function readProcessSnapshot() {
+ if(process.platform==='win32')throw Error('process inventory unsupported');
+ return parseProcessSnapshot(execFileSync('/bin/ps',['-axo','uid=,pid=,ppid=,pgid=,lstart=,command=','-ww'],{encoding:'utf8',maxBuffer:16*1024*1024,stdio:['ignore','pipe','ignore'],env:{...process.env,LC_ALL:'C'}}));
+}
+function profileMatches(command,profile) {
+ const escaped=profile.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
+ return new RegExp('(?:^|\\s)--user-data-dir(?:=|\\s)'+escaped+'(?=\\s|$)').test(command) ||
+  new RegExp('(?:^|\\s)--database(?:=|\\s)'+escaped+'/Crashpad(?=\\s|$)').test(command);
+}
+const scopeProfileMatches=(command,scope)=>Boolean((scope.profile&&profileMatches(command,scope.profile))||(scope.profileCanonical&&profileMatches(command,scope.profileCanonical)));
+function selectResidualProcesses(owners,snapshot,{uid=process.getuid?.()}={}) {
+ let complete=Number.isInteger(uid),scopes=[];
+ for(const row of owners) {
+  if(row.scopeError||row.captureError)complete=false;
+  if(!row.profile&&!row.processGroup)continue;
+  const time=Date.parse(row.startToken);
+  if(!Number.isInteger(row.pid)||row.pid<=1||!Number.isFinite(time)||!row.startToken) {complete=false;continue;}
+  if([row.profile,row.profileCanonical].filter(Boolean).some(p=>!path.isAbsolute(p)||/[\r\n\0]/.test(p))){complete=false;continue;}
+  if(row.processGroup&&row.processGroup!==row.pid){complete=false;continue;}
+  const reusedLeader=snapshot.some(p=>p.pid===row.pid&&!sameStamp(p.startToken,row.startToken));
+  scopes.push({...row,time,groupValid:!reusedLeader});
+ }
+ if(!scopes.length)complete=false;
+ const rows=[];
+ for(const p of snapshot) {
+  if(p.uid!==uid||p.pid<=1||p.pid===process.pid)continue;
+  const prior=owners.filter(r=>r.pid===p.pid);if(prior.length&&!prior.some(r=>sameStamp(r.startToken,p.startToken)))continue;
+  const time=Date.parse(p.startToken);if(!Number.isFinite(time)) {complete=false;continue;}
+  const scope=scopes.find(s=>time>=s.time&&(scopeProfileMatches(p.command,s)||(s.processGroup&&s.groupValid&&p.pgid===s.processGroup)));
+  if(scope)rows.push({pid:p.pid,startToken:p.startToken,kind:'owned-residual-scope',matchedBy:scopeProfileMatches(p.command,scope)?'exact-profile':'owned-process-group'});
+ }
+ return {complete,rows,scopeCount:scopes.length};
+}
+module.exports={normalizedStamp,sameStamp,parseProcessSnapshot,readProcessSnapshot,selectResidualProcesses};
