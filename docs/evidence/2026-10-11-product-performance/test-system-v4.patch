+    }catch {last=await cleanupOwned(file,{...ops,wait});return {...last,confirmed:false,reason:'RESIDUAL_INVENTORY_UNAVAILABLE',unconfirmed:Math.max(1,last.unconfirmed??0),residualInventory:{complete:false,rounds}};}
+    if(!selection.complete) {last=await cleanupOwned(file,{...ops,wait});return {...last,confirmed:false,reason:'RESIDUAL_SCOPE_INCOMPLETE',unconfirmed:Math.max(1,last.unconfirmed??0),residualInventory:{complete:false,rounds}};}
+    const known=new Set(rows.map(r=>r.pid+':'+snapshotTools.normalizedStamp(r.startToken)));
+    for(const row of selection.rows)if(!known.has(row.pid+':'+snapshotTools.normalizedStamp(row.startToken)))fs.appendFileSync(file,JSON.stringify(row)+'\n');
