@@ -0,0 +1,404 @@
+import { AXES } from "./axes.mjs";
+import fs from "node:fs";
+import path from "node:path";
+import crypto from "node:crypto";
+import { createRequire } from "node:module";
+import { execFileSync } from "node:child_process";
+const hash = (value) =>
+  crypto.createHash("sha256").update(JSON.stringify(value)).digest("hex");
+export const typescriptFor = (repo) =>
+  createRequire(path.join(repo, "package.json"))("typescript");
+export function scanControlSource(file, source, ts) {
+  const sf = ts.createSourceFile(
+    file,
+    source,
+    ts.ScriptTarget.Latest,
+    true,
+    /\.tsx$|\.jsx$/.test(file) ? ts.ScriptKind.TSX : ts.ScriptKind.TS,
+  );
+  const printer = ts.createPrinter({ removeComments: true }),
+    canonical = (n) =>
+      n ? printer.printNode(ts.EmitHint.Unspecified, n, sf) : "";
+  const controls = [],
+    bindings = new Map(),
+    ordinals = new Map();
+  const gather = (n) => {
+    if (
+      (ts.isFunctionDeclaration(n) || ts.isVariableDeclaration(n)) &&
+      n.name &&
+      ts.isIdentifier(n.name)
+    )
+      bindings.set(n.name.text, [...(bindings.get(n.name.text) ?? []), n]);
+    ts.forEachChild(n, gather);
+  };
+  gather(sf);
+  function ownerOf(n) {
+    for (let p = n.parent; p; p = p.parent)
+      if (
+        (ts.isFunctionDeclaration(p) ||
+          ts.isVariableDeclaration(p) ||
+          ts.isClassDeclaration(p)) &&
+        p.name &&
+        ts.isIdentifier(p.name)
+      )
+        return p.name.text;
+    return "<module>";
+  }
+  function bindingScope(n) {
+    for (let p = n.parent; p; p = p.parent)
+      if (ts.isBlock(p) || ts.isSourceFile(p)) return p;
+    return sf;
+  }
+  function resolveLocal(name, node) {
+    const ancestors = [];
+    for (let p = node; p; p = p.parent) ancestors.push(p);
+    return (bindings.get(name) ?? [])
+      .map((n) => ({ n, depth: ancestors.indexOf(bindingScope(n)) }))
+      .filter((x) => x.depth >= 0)
+      .sort((a, b) => a.depth - b.depth)[0]?.n;
+  }
+  function emit(node, kind, tag, events, labels, dynamic) {
+    const owner = ownerOf(node),
+      key = `${file}#${owner}:${kind}:${tag}:${events.map((e) => e.name).join(",")}:${labels.map((l) => l.name + "=" + l.value).join(",")}`;
+    const ordinal = ordinals.get(key) ?? 0;
+    ordinals.set(key, ordinal + 1);
+    const handlers = events.map(({ name, expression }) => {
+      const named =
+        expression && ts.isIdentifier(expression)
+          ? resolveLocal(expression.text, node)
+          : null;
+      return {
+        name,
+        resolution: named
+          ? "named-local"
+          : expression &&
+              (ts.isArrowFunction(expression) ||
+                ts.isFunctionExpression(expression))
+            ? "inline"
+            : "external-or-dynamic",
+        fingerprint: hash(canonical(named ?? expression)),
+      };
+    });
+    const gaps = [
+      ...dynamic,
+      ...handlers
+        .filter((h) => h.resolution === "external-or-dynamic")
+        .map(
+          (h) => `${h.name}: handler target requires cross-file/dynamic review`,
+        ),
+    ];
+    controls.push({
+      id: hash([key, ordinal]),
+      fingerprint: hash([key, ordinal, handlers, labels]),
+      file,
+      line: sf.getLineAndCharacterOfPosition(node.getStart(sf)).line + 1,
+      owner,
+      kind,
+      tag: tag.length <= 120 ? tag : "expression:" + hash(tag),
+      events: handlers,
+      labels,
+      gaps,
+      resolution: gaps.length ? "unresolved" : "static",
+      coverageState: "unverified",
+    });
+  }
+  const visit = (n) => {
+    if (ts.isJsxOpeningElement(n) || ts.isJsxSelfClosingElement(n)) {
+      const tag = n.tagName.getText(sf),
+        events = [],
+        labels = [],
+        dynamic = [];
+      for (const a of n.attributes.properties) {
+        if (ts.isJsxSpreadAttribute(a)) {
+          dynamic.push("JSX spread may supply controls or handlers");
+          continue;
+        }
+        const name = a.name.getText(sf),
+          init = a.initializer,
+          expression =
+            init && ts.isJsxExpression(init) ? init.expression : init;
+        if (/^on[A-Z]/.test(name)) events.push({ name, expression });
+        if (
+          /^(role|aria-label|aria-disabled|aria-pressed|disabled|title|tabIndex|checked|value|name|data-testid|data-action|data-menu-item|id|type|href)$/.test(
+            name,
+          )
+        ) {
+          const literal = init && ts.isStringLiteral(init);
+          const value = literal ? init.text : null;
+          const safe =
+            typeof value === "string" &&
+            value.length <= 160 &&
+            !/Bearer\s|sk-[A-Za-z0-9]|(?:file|nomi-local):|\/(?:Users|home)\//i.test(
+              value,
+            );
+          labels.push({
+            name,
+            value: safe ? value : null,
+            fingerprint: hash(canonical(expression)),
+          });
+          if (!literal)
+            dynamic.push(`${name}: dynamic value (fingerprint only)`);
+          else if (!safe)
+            dynamic.push(`${name}: long or sensitive-looking literal withheld`);
+        }
+      }
+      const candidateFromAttributes = dynamic.length > 0;
+      if (ts.isJsxOpeningElement(n) && ts.isJsxElement(n.parent)) {
+        const children = n.parent.children;
+        const literals = children.every(
+          (child) =>
+            ts.isJsxText(child) ||
+            (ts.isJsxExpression(child) &&
+              child.expression &&
+              ts.isStringLiteral(child.expression)),
+        );
+        const value = literals
+          ? children
+              .map((child) =>
+                ts.isJsxText(child) ? child.text : child.expression.text,
+              )
+              .join("")
+              .replace(/\s+/g, " ")
+              .trim()
+          : null;
+        const safe =
+          typeof value === "string" &&
+          value.length <= 160 &&
+          !/Bearer\s|sk-[A-Za-z0-9]|(?:file|nomi-local):|\/(?:Users|home)\//i.test(
+            value,
+          );
+        labels.push({
+          name: "children",
+          value: safe ? value : null,
+          fingerprint: hash(children.map((child) => canonical(child)).join("")),
+        });
+        if (!literals)
+          dynamic.push(
+            "children: rendered expression requires runtime mapping (fingerprint only)",
+          );
+        else if (!safe)
+          dynamic.push("children: long or sensitive-looking literal withheld");
+      }
+      const semantic =
+        /^(button|input|textarea|select|option|a|summary|menu|menuitem)$/i.test(
+          tag,
+        ) ||
+        labels.some((l) => l.name === "role") ||
+        /(Button|MenuItem|Toggle|Slider|Select|DropZone|Hotkey|Shortcut|CommandItem)$/.test(
+          tag,
+        );
+      if (events.length || semantic || candidateFromAttributes)
+        emit(n, "jsx", tag, events, labels, dynamic);
+    }
+    if (
+      ts.isCallExpression(n) &&
+      ts.isPropertyAccessExpression(n.expression) &&
+      n.expression.name.text === "addEventListener"
+    ) {
+      const type = n.arguments[0],
+        callback = n.arguments[1],
+        label = type && ts.isStringLiteral(type) ? type.text : "dynamic-event";
+      if (
+        /click|pointer|mouse|key|drop|drag|wheel|input|change|submit|paste|copy|cut|touch|dynamic/.test(
+          label,
+        )
+      )
+        emit(
+          n,
+          "listener",
+          canonical(n.expression.expression),
+          [{ name: label, expression: callback }],
+          [],
+          label === "dynamic-event" ? ["dynamic event name"] : [],
+        );
+    }
+    if (
+      ts.isPropertyAssignment(n) &&
+      /^(on[A-Z].*|action|handler|execute)$/.test(
+        n.name.getText(sf).replace(/[\"']/g, ""),
+      )
+    )
+      emit(
+        n,
+        "object-command",
+        n.name.getText(sf),
+        [{ name: n.name.getText(sf), expression: n.initializer }],
+        [],
+        ["object command requires rendered menu/control mapping"],
+      );
+    if (
+      ts.isCallExpression(n) &&
+      /registerShortcut|registerHotkey|useHotkeys|registerCommand/.test(
+        canonical(n.expression),
+      )
+    )
+      emit(
+        n,
+        "command",
+        canonical(n.expression),
+        [],
+        [],
+        ["command registration requires runtime key/handler enumeration"],
+      );
+    ts.forEachChild(n, visit);
+  };
+  visit(sf);
+  return {
+    controls,
+    parseErrors: sf.parseDiagnostics.map((d) => ({
+      file,
+      start: d.start,
+      code: d.code,
+      message: ts.flattenDiagnosticMessageText(d.messageText, " "),
+    })),
+  };
+}
+export function scanControls(repo, { base = null, files = null } = {}) {
+  const ts = typescriptFor(repo),
+    git = (args) =>
+      execFileSync("git", args, {
+        cwd: repo,
+        encoding: "utf8",
+        maxBuffer: 32 * 1024 * 1024,
+      });
+  const selected =
+    files ??
+    (base
+      ? git(["ls-tree", "-r", "--name-only", base, "--", "src"])
+      : git(["ls-files", "--", "src"])
+    )
+      .split("\n")
+      .filter(
+        (f) =>
+          /\.(tsx?|jsx?)$/.test(f) && !/(?:\.test\.|\.spec\.|\.d\.ts$)/.test(f),
+      );
+  const controls = [],
+    parseErrors = [];
+  for (const file of selected) {
+    let source;
+    try {
+      source = base
+        ? git(["show", `${base}:${file}`])
+        : fs.readFileSync(path.join(repo, file), "utf8");
+    } catch {
+      continue;
+    }
+    const scanned = scanControlSource(file, source, ts);
+    controls.push(...scanned.controls);
+    parseErrors.push(...scanned.parseErrors);
+  }
+  return {
+    schemaVersion: 1,
+    source: "TypeScript AST; same parser used by check-control-contract.mjs",
+    claim: "source control candidates, not proof of rendered runtime controls",
+    filesScanned: selected.length,
+    controls,
+    parseErrors,
+    counts: {
+      controls: controls.length,
+      unresolved: controls.filter((c) => c.resolution === "unresolved").length,
+    },
+  };
+}
+export function checkControlCoverage({
+  current,
+  baseline = null,
+  mappings,
+  scenarios,
+  results = null,
+}) {
+  const errors = [
+      ...current.parseErrors.map((e) => `AST parse gap ${e.file}:${e.code}`),
+    ],
+    unresolved = [],
+    required = [];
+  const old = new Set(baseline?.controls.map((c) => c.fingerprint) ?? []);
+  const changed = current.controls.filter((c) => !old.has(c.fingerprint));
+  for (const c of changed) {
+    const links =
+      mappings?.controls?.filter((m) => m.fingerprint === c.fingerprint) ?? [];
+    if (!links.length) {
+      errors.push(`${c.file}:${c.line}: unmapped control ${c.fingerprint}`);
+      unresolved.push({
+        fingerprint: c.fingerprint,
+        reason: "missing assertion/case mapping",
+      });
+      continue;
+    }
+    if (
+      c.gaps.length &&
+      !links.some((m) => m.resolutionEvidence?.length >= 12)
+    ) {
+      errors.push(`${c.fingerprint}: dynamic control not resolved`);
+      unresolved.push({ fingerprint: c.fingerprint, gaps: c.gaps });
+    }
+    if (
+      !links.some(
+        (m) =>
+          scenarios.find((s) => s.id === m.scenarioId)?.kind === "functional",
+      ) ||
+      !links.some(
+        (m) =>
+          scenarios.find((s) => s.id === m.scenarioId)?.kind === "performance",
+      )
+    )
+      errors.push(
+        `${c.fingerprint}: requires functional AND performance cases`,
+      );
+    const axisContract = mappings?.axisContracts?.find(
+      (a) => a.fingerprint === c.fingerprint,
+    );
+    if (
+      !axisContract?.axes?.length ||
+      axisContract.axes.some((axis) => !AXES[axis])
+    )
+      errors.push(
+        `${c.fingerprint}: explicit applicable-axis contract required`,
+      );
+    for (const axis of axisContract?.axes ?? [])
+      for (const [level, value] of Object.entries(AXES[axis] ?? {})) {
+        if (
+          !links.some((m) => {
+            const s = scenarios.find((s) => s.id === m.scenarioId);
+            return (
+              s?.kind === "performance" &&
+              JSON.stringify(s.expectedAxes?.[axis]) === JSON.stringify(value)
+            );
+          })
+        )
+          errors.push(
+            `${c.fingerprint}: missing performance case for ${axis}.${level}`,
+          );
+      }
+    for (const m of links) {
+      required.push(m.scenarioId);
+      if (
+        !scenarios.some((s) => s.id === m.scenarioId) ||
+        !m.assertionIds?.length ||
+        !m.runtimeSelector
+      )
+        errors.push(`${c.fingerprint}: missing known scenario/assertions`);
+      if (results) {
+        const r = results.find((r) => r.scenarioId === m.scenarioId);
+        if (
+          r?.status !== "passed" ||
+          !r?.controlFingerprints?.includes(c.fingerprint) ||
+          m.assertionIds.some(
+            (id) =>
+              !r?.assertions?.some((a) => a.id === id && a.passed === true),
+          )
+        )
+          errors.push(
+            `${c.fingerprint}: execution lacks exact control/assertion receipt`,
+          );
+      }
+    }
+  }
+  return {
+    pass: !errors.length,
+    errors,
+    changedControls: changed.length,
+    unresolved,
+    required: [...new Set(required)],
+  };
+}
