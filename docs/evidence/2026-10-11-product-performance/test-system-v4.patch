+      file,
+      JSON.stringify({
+        pid,
+        startToken: birthStamp(pid),
+        kind: "electron-owned-app-metrics",
+      }) + "\n",
+    );
+  }
+}
+const exists = (pid) => {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (e) {
+    return e.code !== "ESRCH";
+  }
+};
+export async function cleanupOwned(
+  file,
+  {
+    signal = process.kill,
+    stamp = birthStamp,
+    alive = exists,
+    wait = pause,
+    scanRound = 0,
+  } = {},
+) {
+  if (!fs.existsSync(file))
+    return {
+      confirmed: false,
+      reason: "MISSING_OWNERS_RECEIPT",
+      terminated: 0,
+      unconfirmed: 1,
+    };
+  let rows, snapshot;
+  try {
+    snapshot = fs.readFileSync(file, "utf8");
+    rows = snapshot
+      .split("\n")
+      .filter(Boolean)
+      .map((s) => JSON.parse(s));
+  } catch {
+    return {
+      confirmed: false,
+      reason: "INVALID_OWNERS_RECEIPT",
+      terminated: 0,
+      unconfirmed: 1,
+    };
+  }
+  const unique = [
+    ...new Map(rows.map((r) => [`${r.pid}:${r.startToken}`, r])).values(),
+  ].reverse();
+  let terminated = 0,
+    unconfirmed = 0,
+    identityRejected = 0;
+  for (const row of unique) {
+    if (!Number.isInteger(row.pid) || row.pid <= 1) {
+      unconfirmed++;
+      continue;
+    }
+    if (!alive(row.pid)) continue;
+    const current = stamp(row.pid);
+    if (!row.startToken || !current) {
+      unconfirmed++;
+      continue;
+    }
+    if (!sameStamp(current,row.startToken)) {
+      identityRejected++;
+      continue;
+    } // Original owner exited; never signal the replacement.
+    try {
+      signal(row.pid, "SIGTERM");
+      terminated++;
+      await wait(100);
+      if (alive(row.pid) && sameStamp(stamp(row.pid),row.startToken))
+        signal(row.pid, "SIGKILL");
+    } catch {}
+    let ended = false;
+    for (let i = 0; i < 20; i++) {
+      const after = stamp(row.pid);
+      if (!alive(row.pid) || (after && !sameStamp(after,row.startToken))) {
+        ended = true;
+        break;
+      }
+      await wait(100);
+    }
+    if (!ended) unconfirmed++;
+  }
+  if (fs.readFileSync(file, "utf8") !== snapshot) {
+    if (scanRound >= 3)
+      return {
+        confirmed: false,
+        reason: "OWNERS_CHANGED_DURING_CLEANUP",
+        unconfirmed: 1,
+        terminated,
+      };
+    const later = await cleanupOwned(file, {
+      signal,
+      stamp,
+      alive,
+      wait,
+      scanRound: scanRound + 1,
+    });
