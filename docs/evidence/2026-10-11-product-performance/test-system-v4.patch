+    const code = `import fs from 'node:fs';const m=await import(${JSON.stringify(pathToFileURL(path.join(c.repoRoot, "electron/shared/canvas/edgeAdmission.ts")).href)});const {admitNewEdges}=m.default||m;const p=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(JSON.stringify(admitNewEdges({nodes:p.nodes,known:new Set(),next:p.edges})));`;
+    const admission = JSON.parse(
+      execFileSync(
+        process.execPath,
+        [
+          "--import",
+          pathToFileURL(require.resolve("tsx")).href,
+          "--input-type=module",
+          "-e",
+          code,
+          input,
+        ],
+        {
+          cwd: c.repoRoot,
+          encoding: "utf8",
+          stdio: ["ignore", "pipe", "pipe"],
+        },
+      ),
+    );
+    const edgeDigest = (edges) =>
+      hash(
+        JSON.stringify(
+          edges.map(({ id, source, target, mode, order }) => ({
+            id,
+            source,
+            target,
+            mode,
+            order,
+          })),
+        ),
+      );
+    groupAudit.push({
+      scale,
+      sourceEdgeSHA256: edgeDigest(originalEdges),
+      canonicalEdgeSHA256: edgeDigest(admission.edges),
+      canonicalEdges: admission.edges,
+      rejectedCount: admission.rejected.length,
+      rejected: admission.rejected.map(({ edge, reason }) => ({
+        id: edge.id,
+        reason,
+      })),
+    });
+    const audit = {
+      contract: "electron/shared/canvas/edgeAdmission.ts",
+      originalEdgeCount: originalEdges.length,
+      canonicalEdgeCount: admission.edges.length,
+      rejectedCount: admission.rejected.length,
+      originalEdgeDigest: hash(JSON.stringify(originalEdges)),
+      canonicalEdgeDigest: hash(JSON.stringify(admission.edges)),
+      reasons: admission.rejected.map((x) => x.reason),
+    };
+    const base = {
+      scale,
+      projectRoot: f.projectRoot,
+      summary: f.summary,
+      fixtureVersion: f.fixtureVersion,
+      metadataIntegrity: f.metadataIntegrity,
+      layoutIntegrity: f.layoutIntegrity,
+      mediaProvenance: provenance,
+      mediaProfile,
+      edgeAdmission: audit,
+    };
+    legacy.push({
+      ...base,
+      record: structuredClone(f.record),
+      fixtureVariant: "legacy-rejected-edges+metadata-layout-v2",
+      fixtureDigest: hash(JSON.stringify(f.record.payload)),
+    });
+    f.record.payload.generationCanvas.edges = admission.edges;
+    for (const rel of ["project.json", ".nomi/project.json"])
+      writeJson(path.join(f.projectRoot, rel), f.record);
+    f.summary.references = admission.edges.length;
+    f.summary.canvasEdges = admission.edges.length;
+    fixtures.push({
+      ...base,
+      record: f.record,
+      fixtureVariant: "canonical-admitted-edges+metadata-layout-v2",
+      fixtureDigest: hash(JSON.stringify(f.record.payload)),
+    });
+  }
+  const registry = fixtures.map((f, i) => ({
+    id: f.record.id,
+    name: f.record.name,
+    rootPath: f.projectRoot,
+    lastOpenedAt: 100 - i,
+    missing: false,
+  }));
+  writeJson(path.join(c.privateRoot, "group-edge-fixture-audit.private.json"), {
+    rows: groupAudit,
+    source: sourceIdentity(c.repoRoot),
+  });
+  writeJson(c.fixtureIndex, fixtures);
+  writeJson(path.join(c.privateRoot, "legacy-fixtures.private.json"), legacy);
+  writeJson(
+    path.join(path.dirname(c.fixtureIndex), "registry.private.json"),
+    registry,
+  );
+  writeJson(path.join(c.privateRoot, "media-integrity.private.json"), sources);
+  for (const s of sources)
+    if (hashFile(s.file) !== s.sha256)
+      throw new Error("Read-only original integrity failed");
+  rejectSymlinks(path.join(c.privateRoot, "projects"));
+  const receipt = {
+    schemaVersion: 1,
+    status: "prepared-not-executed",
+    source: sourceIdentity(c.repoRoot),
+    mediaProvenance: provenance,
+    mediaProfile,
+    mediaManifest,
+    sourceIntegrity: true,
+    scales: fixtures.map((f) => ({
+      scale: f.scale,
+      counts: f.summary,
+      fixtureVariant: f.fixtureVariant,
+      fixtureDigest: f.fixtureDigest,
+      fixtureVersion: f.fixtureVersion,
+      metadataIntegrity: f.metadataIntegrity,
+      layoutIntegrity: f.layoutIntegrity,
+      edgeAdmission: f.edgeAdmission,
+    })),
+    limits: [
+      "Node counts reuse media; distinct-media-heavy remains unexecuted",
+      "No Electron launched during fixture preparation",
+    ],
+  };
+  writeJson(path.join(c.outputDir, "prepare.json"), receipt);
+  return receipt;
+}
