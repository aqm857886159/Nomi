+ const mutations=[s=>delete s[2].index,s=>s[2].index=1,s=>s[2].index=8,s=>[s[1],s[2]]=[s[2],s[1]],s=>delete s[2].isWarmup,s=>s[2].isWarmup='false',s=>s[2].phase='warmup',s=>{s[0].isWarmup=false;s[1].isWarmup=true;}];
+ for(const mutate of mutations){const raw=samples(1,5);mutate(raw);const r=completionResult({status:'executed',samples:raw},mapping(1,5));assert.equal(r.sampleIntegrity.status,'incomplete');assert.notEqual(r.status,'passed');}
+ const raw=samples(1,5);delete raw[2].isWarmup;delete raw[2].index;const r=completionResult({status:'executed',samples:raw},mapping(1,5));assert.equal(r.samples[2].phase,null);assert.equal(r.samples[2].index,null);
+});
+test('normalized gate samples require observed phase/index and exact warmup order',()=>{
+ const normalized=samples(1,5).map(s=>({index:s.index,phase:s.isWarmup?'warmup':'measured'}));
+ assert.equal(sampleSeriesIntegrity(normalized,{warmupRuns:1,measuredRuns:5}).status,'complete');
+ for(const key of ['index','phase']){const copy=structuredClone(normalized);delete copy[1][key];assert.equal(sampleSeriesIntegrity(copy,{warmupRuns:1,measuredRuns:5}).status,'incomplete');}
+});
