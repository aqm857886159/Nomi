+import {
+  validateNotApplicable,
+  metricPolicyFor,
+} from "../../scripts/quality-system/metric-policy.mjs";
+import { isolateLegacyEvaluationSource } from "../../scripts/quality-system/isolation-boundary.mjs";
+const repo = process.env.NOMI_TEST_REPO || process.cwd(),
+  here = path.resolve(import.meta.dirname, "../../scripts/quality-system");
+test("plan declares all runner cells with no implicit execution", () => {
+  const p = baselinePlan();
+  assert.equal(p.jobs.length, 300);
+  assert.equal(p.cells.length, 696);
+  assert.ok(p.cells.every((x) => x.status === "unverified"));
+  assert.ok(p.mandatoryMissing.includes("distinct-media-heavy"));
+  assert.throws(() => baselinePlan({ scales: ["huge"] }), /Unknown scale/);
+});
+test("configuration rejects product/private/output overlap and absent explicit local media", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "nomi-quality-contract-"));
+  try {
+    const file = path.join(dir, "c.json");
+    const c = {
+      repoRoot: repo,
+      privateRoot: repo,
+      outputDir: path.join(dir, "output"),
+    };
+    writeJson(file, c);
+    assert.throws(() => readConfig(file), /outside/);
+    c.privateRoot = path.join(dir, "private");
+    c.outputDir = c.privateRoot;
+    writeJson(file, c);
+    assert.throws(() => readConfig(file), /separate/);
+    c.outputDir = path.join(dir, "output");
+    c.media = { kind: "local" };
+    writeJson(file, c);
+    assert.throws(() => readConfig(file), /allowlist/);
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+test("real credential catalog is blocked without querying a profile", () => {
+  assert.throws(
+    () => credentialIsolationOptions({ requireCatalog: true }),
+    /unsupported/,
+  );
+  assert.equal(credentialIsolationOptions().realProfileAccess, "forbidden");
+});
+test("legacy helper negative control catches real profile access; adapted no-catalog accesses only owned paths", () => {
+  const root = fs.mkdtempSync(
+    path.join(os.tmpdir(), "nomi-quality-isolation-"),
+  );
+  try {
+    const source = fs.readFileSync(
+      path.join(repo, "evals/lib/isoApp.mjs"),
+      "utf8",
+    );
+    const extract = (s) =>
+      s
+        .slice(
+          s.indexOf("export function prepareIsolation("),
+          s.indexOf("\nexport function isolatedAppEnv"),
+        )
+        .replace("export function", "function");
+    let calls = 0;
+    const forbid = () => {
+      calls++;
+      throw new Error("LIVE_PROFILE_READ_FORBIDDEN");
+    };
+    const guarded = Object.fromEntries(
+      ["rmSync", "mkdirSync", "existsSync", "readFileSync", "copyFileSync"].map(
+        (method) => [
+          method,
+          (target, ...args) => {
+            assert.ok(path.resolve(target).startsWith(root + path.sep));
+            return fs[method](target, ...args);
+          },
+        ],
+      ),
+    );
+    const bind = (s) =>
+      new Function(
+        "fs",
+        "path",
+        "realNomiProfile",
+        "seedRealCredentials",
+        "prepareIsolatedCatalog",
+        `${extract(s)};return prepareIsolation`,
+      )(guarded, path, forbid, forbid, forbid);
+    assert.throws(
+      () =>
+        bind(source)(path.join(root, "negative"), { requireCatalog: false }),
+      /LIVE_PROFILE/,
+    );
+    assert.equal(calls, 1);
+    calls = 0;
+    const f = bind(isolateLegacyEvaluationSource(source));
+    f(path.join(root, "positive"), { requireCatalog: false });
+    assert.throws(
+      () => f(path.join(root, "blocked"), { requireCatalog: true }),
+      /model-catalog/,
+    );
+    assert.equal(calls, 0);
+  } finally {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+test("not-applicable requires reviewed source and complete guard; it cannot waive required metrics", () => {
+  const p = metricPolicyFor("group-delete", repo),
+    g = {
+      externalAttempts: 0,
+      networkGuardLayers: ["fetch", "http", "https", "socket", "chromium"],
+    };
+  assert.equal(p.networkWaitMs.requirement, "not-applicable");
+  const a = { networkWaitMs: { ...p.networkWaitMs, status: "not-applicable" } };
+  assert.equal(validateNotApplicable("networkWaitMs", p, a, g), true);
+  assert.equal(
+    validateNotApplicable("networkWaitMs", p, a, { ...g, externalAttempts: 1 }),
+    false,
+  );
+  assert.equal(
+    validateNotApplicable(
+      "networkWaitMs",
+      p,
+      { networkWaitMs: { status: "not-applicable" } },
+      g,
+    ),
+    false,
+  );
+  assert.equal(
+    validateNotApplicable(
+      "inputFeedbackMs",
+      p,
+      { inputFeedbackMs: { status: "not-applicable" } },
