+// Installed through the existing read-only preload subscription before opening a project.
+// Retain counts/identity only; never copy prompt, transcript, model credentials or parts.
+export function installNativeLaneObserver() {
+  window.__qualityLaneObservation?.unsubscribe?.();
+  const state={snapshot:null,events:0,unsubscribe:null};
+  window.__qualityLaneObservation=state;
+  const bridge=window.nomiDesktop?.agentLane;
+  if(typeof bridge?.onProjection!=="function")return {installed:false};
+  state.unsubscribe=bridge.onProjection(p=>{
+    state.events++;
+    const lanes=Array.isArray(p?.lanes)?p.lanes:null;
+    const active=lanes?.find(l=>l.laneName===p.active?.lane);
+    state.snapshot={closed:p?.closed===true,running:typeof p?.active?.running==="boolean"?p.active.running:null,sessionHistory:lanes?.length??null,activeSessionId:typeof active?.sessionId==="string"?active.sessionId:null,observedAt:performance.now()};
+  });
+  return {installed:true};
+}
+export function idleStreamObservation(snapshot, transcripts) {
+  const matched=!!snapshot?.activeSessionId && transcripts.some(t=>t.sessionId===snapshot.activeSessionId);
+  // running=false is the native operation state. Product's single-open-lane
+  // contract permits proving zero only when that active session is known idle.
+  // running=true alone cannot prove a provider stream count (it may be a tool).
+  const complete=snapshot?.closed===false && snapshot.running===false && matched && snapshot.sessionHistory===transcripts.length;
+  return {activeStreams:complete?0:null,source:"native-agent-lane-projection",activeOperationRunning:snapshot?.running??null,sessionMatched:matched,reason:complete?null:"Missing/mismatched/closed projection or native operation active; provider stream count not exposed"};
+}
