{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx!",
    "src/dev/optimizeDepsEntry.ts",
    "src/devlab/*.tsx",
    "electron/main.ts!",
    "electron/preload.ts!",
    "electron/mcpServerEntry.ts!",
    "worker/index.ts!",
    "scripts/**/*.{mjs,ts,cjs}",
    "tests/**/*.{mjs,ts,tsx}",
    "evals/**/*.{mjs,ts}",
    "**/*.test.{ts,tsx,mjs}",
    "**/*.node-test.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "electron/**/*.{ts,mts}!",
    "worker/**/*.ts!"
  ],
  "ignore": [
    "**/__fixtures__/**",
    "tests/fixtures/**"
  ],
  "ignoreDependencies": [
    "hono"
  ],
  "vite": false
}
