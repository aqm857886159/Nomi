{
  "name": "nomi",
  "private": true,
  "version": "0.21.0",
  "description": "Open-source AI video workbench. Bring any model or your local ComfyUI, and let Claude Code or Cursor direct it over MCP. Local-first: projects, prompts, and keys stay on your machine.",
  "author": "青阳 <TZ857886159>",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/aqm857886159/Nomi.git"
  },
  "scripts": {
    "dev": "node ./scripts/dev-electron.mjs",
    "dev:low-memory": "node ./scripts/dev-low-memory.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "pnpm run check:electron-install && pnpm run build:renderer && pnpm run build:electron",
    "build:renderer": "node scripts/build-tailwind.mjs --minify && vite build --mode production",
    "build:electron": "node scripts/build-electron.mjs",
    "build:site": "node scripts/build-marketing-site.mjs && node scripts/build-marketing-site.mjs --check",
    "build:sitemap": "node scripts/build-marketing-sitemap.mjs",
    "check:sitemap": "node scripts/build-marketing-sitemap.mjs --check",
    "check:handbook": "tsx scripts/build-handbook-html.mjs --check",
    "seo:audit": "node scripts/seo/seo-audit.mjs",
    "test:seo": "node --test tests/seo/*.node.mjs scripts/seo/seo-audit.node.mjs",
    "check:site": "node scripts/build-marketing-site.mjs --check && node scripts/build-marketing-sitemap.mjs --check && pnpm run check:handbook && node tests/ux/marketing-home.static.mjs",
    "test:packaging": "node scripts/packaging/platform-binaries.test.cjs",
    "audit:package-size": "node scripts/packaging/audit-packaged-media.cjs",
    "start": "node ./scripts/start-electron.mjs",
    "start:low-memory": "node ./scripts/start-low-memory.mjs",
    "preview": "vite preview",
    "test": "vitest run && pnpm run test:agent-runtime",
    "test:agent-runtime": "tsc -p tests/agent-runtime/tsconfig.json && node --test --test-concurrency=1 .tmp/agent-runtime-tests/tests/agent-runtime/*.test.mjs",
    "test:agent-system:l1": "tsc -p tests/agent-system/tsconfig.json && node --test --test-concurrency=1 .tmp/agent-system-tests/tests/agent-system/contracts/l1-replay.node-test.mjs",
    "test:agent-system:m0-m1": "tsc -p tests/agent-system/tsconfig.json && node --test --test-concurrency=1 .tmp/agent-system-tests/tests/agent-system/schema.node-test.mjs .tmp/agent-system-tests/tests/agent-system/contracts/l1-replay.node-test.mjs",
    "test:build": "pnpm run build",
    "check:filesize": "node ./scripts/check-file-sizes.mjs",
    "check:icons": "node ./scripts/check-app-icons.cjs",
    "generate:icons": "node ./scripts/generate-app-icon.cjs",
    "check:tokens": "node ./scripts/check-design-tokens.mjs",
    "check:dangling-tokens": "node ./scripts/check-dangling-tokens.mjs",
    "check:archetype-defaults": "tsx scripts/gen-archetype-wire-defaults.ts --check",
    "check:archetype-sources": "node ./scripts/check-archetype-sources.mjs",
    "check:root-cause-contracts": "node --test ./scripts/check-root-cause-contracts.node-test.mjs && node ./scripts/check-root-cause-contracts.mjs",
    "check:ponytail-review": "node --test ./scripts/ponytail-review-hook.node-test.mjs",
    "check:model-certification-coverage": "node ./scripts/check-model-certification-coverage.mjs",
    "check:git-delivery": "node --test ./scripts/git-delivery.node-test.mjs",
    "check:secrets": "node ./scripts/check-no-secrets.mjs --all",
    "check:symlinks": "node ./scripts/check-no-machine-symlinks.mjs",
    "check:electron-install": "node --test ./scripts/electron-install-identity.node-test.mjs && node ./scripts/check-electron-install.mjs",
    "check:controls": "node ./scripts/check-control-contract.mjs",
    "check:e2e-launch": "node ./scripts/check-e2e-launch.mjs",
    "check:docs-index": "node ./scripts/check-docs-index.mjs",
    "check:doc-status": "node ./scripts/check-doc-status.mjs",
    "check:ledger": "node --test ./scripts/build-delivery-ledger.node-test.mjs && node ./scripts/build-delivery-ledger.mjs --check",
    "check:handoff": "node ./scripts/check-handoff.mjs",
    "gen:ledger": "node ./scripts/build-delivery-ledger.mjs",
    "ledger:brief": "node ./scripts/build-delivery-ledger.mjs --brief",
    "check:i18n": "node ./scripts/check-i18n-visible-text.mjs && tsx ./scripts/check-i18n-key-parity.ts && tsx ./scripts/check-i18n-key-refs.ts && node ./scripts/check-i18n-fragile-match.mjs",
    "check:test-waits": "node ./scripts/check-test-waits.mjs",
    "check:ipc-sender-binding": "node ./scripts/check-ipc-sender-binding.mjs",
    "check:agents-sync": "node ./scripts/gen-agents-md.mjs --check",
    "check:claude-hooks": "node --test ./scripts/pre-push-check.node-test.mjs && node ./scripts/install-claude-hooks.cjs --check",
    "check:vocabularies": "node --test ./scripts/check-vocabularies*.node-test.mjs && node ./scripts/check-vocabularies.mjs",
    "gen:agents": "node ./scripts/gen-agents-md.mjs",
    "gen:archetype-defaults": "tsx scripts/gen-archetype-wire-defaults.ts",
    "radar:models": "tsx scripts/model-radar.ts",
    "build:handbook": "tsx scripts/build-handbook-html.mjs",
    "check:audit": "node ./scripts/check-audit-cadence.mjs && node ./scripts/check-eval-cadence.mjs",
    "gates:contracts": "pnpm run check:gates-chain && pnpm run check:ponytail-review && pnpm run check:git-delivery && pnpm run check:docs-index && pnpm run check:doc-status && pnpm run check:ledger && pnpm run check:quality-gate-workflow && pnpm run check:cla-workflow && pnpm run check:electron-install && pnpm run check:icons && pnpm run check:filesize && pnpm run check:tokens && pnpm run check:dangling-tokens && pnpm run check:archetype-defaults && pnpm run check:archetype-sources && pnpm run check:model-certification-coverage && pnpm run check:root-cause-contracts && pnpm run check:secrets && pnpm run check:symlinks && pnpm run check:nul-bytes && pnpm run check:i18n && pnpm run check:heavy-path && pnpm run check:mcp-payload && pnpm run check:boundaries && pnpm run check:adoption-bridge && pnpm run check:ipc-sender-binding && pnpm run check:batch-machines && pnpm run check:test-waits && pnpm run check:agents-sync && pnpm run check:claude-hooks && pnpm run check:hook-behavior && pnpm run check:controls && pnpm run check:vocabularies && pnpm run check:e2e-launch && pnpm run check:walkthroughs && pnpm run check:site && pnpm run lint:ci && pnpm run typecheck && pnpm run check:test-types",
    "gates": "pnpm run gates:contracts && pnpm run test && pnpm run build && node ./scripts/stamp-gates-ok.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.pi.json --noEmit",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=82",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "feedback:radar": "node ./scripts/feedback-radar.mjs",
    "stats": "node ./scripts/stats-downloads.mjs",
    "stats:snapshot": "node ./scripts/stats-downloads.mjs --snapshot",
    "stats:html": "node ./scripts/stats-downloads.mjs --html",
    "lab:onboard": "tsx scripts/lab-onboard.ts",
    "eval:ops": "node ./scripts/eval-ops-report.mjs",
    "eval:run": "node ./scripts/eval-run.mjs",
    "eval:score": "node ./scripts/eval-score.mjs",
    "eval:diff": "node ./scripts/eval-diff.mjs",
    "eval:baseline": "node ./scripts/eval-baseline.mjs",
    "eval:view": "node ./scripts/eval-trace-viewer.mjs",
    "eval:judge-calibrate": "node ./scripts/eval-judge-calibrate.mjs",
    "eval:review-images": "node ./scripts/eval-review-images.mjs",
    "eval:generate-quality": "node ./scripts/eval-review-images.mjs",
    "eval:journey": "node ./scripts/eval-journey.mjs",
    "dist": "pnpm run check:electron-install && electron-builder",
    "dist:mac:dir": "pnpm run check:electron-install && electron-builder --mac dir --arm64 && node tests/ux/packaged-mcp-smoke.e2e.mjs release/mac-arm64/Nomi.app",
    "postinstall": "node ./scripts/install-electron-runtime.mjs && node ./scripts/install-git-hooks.cjs && node ./scripts/install-claude-hooks.cjs",
    "test:e2e": "pnpm run check:electron-install && node tests/ux/smoke.e2e.mjs",
    "test:mcp": "pnpm run check:electron-install && node tests/ux/mcp-journey.e2e.mjs",
    "test:mcp-journey": "pnpm run check:electron-install && node tests/ux/mcp-l1-handshake.e2e.mjs",
    "test:model-integration:no-repo": "node tests/ux/model-integration-no-repo.mjs",
    "test:model-integration:packaged": "node tests/ux/model-integration-packaged.e2e.mjs",
    "test:model-integration:trusted-audio": "node tests/ux/model-integration-trusted-audio.e2e.mjs",
    "test:model-integration:fault-matrix": "node tests/ux/model-integration-fault-matrix.e2e.mjs",
    "test:model-access:inventory": "vitest run tests/ux/model-access-journeys/inventory.test.mjs",
    "test:model-access:journeys": "node tests/ux/model-access-journeys/run-journeys.mjs --all",
    "test:model3d:asset-library": "node tests/ux/model3d-asset-library.e2e.mjs",
    "test:canvas:critical": "node tests/ux/canvas-real-suite.mjs critical",
    "test:canvas:acceptance": "node tests/ux/canvas-real-suite.mjs full",
    "test:canvas:performance": "node tests/ux/canvas-real-suite.mjs performance",
    "test:canvas-perf": "node tests/ux/canvas-performance-benchmark.e2e.mjs",
    "test:canvas-perf:compare": "node tests/ux/canvas-performance-compare.mjs",
    "test:canvas-perf:fixture": "node tests/ux/fixtures/gen-canvas-performance-fixture.mjs",
    "test:site": "pnpm run check:site && node tests/ux/marketing-quickstart.static.mjs && node tests/ux/download-selection.contract.mjs",
    "test:site:visual": "pnpm run build:site && node tests/ux/marketing-home.visual.mjs",
    "test:journeys": "pnpm run check:electron-install && node ./scripts/eval-journey.mjs --ci",
    "kill:zombies": "pkill -f \"$PWD/node_modules/.pnpm/electron\" || true",
    "test:system": "node scripts/test-system.mjs",
    "test:system:ci": "node scripts/test-system.mjs ci",
    "test:system:contracts": "node scripts/test-system.mjs ci-contracts",
    "test:system:unit": "node scripts/test-system.mjs ci-unit",
    "test:system:focused": "node scripts/test-focused.mjs",
    "test:system:desktop": "node scripts/test-system.mjs ci-desktop",
    "test:system:journeys": "node scripts/test-system.mjs ci-journeys",
    "test:system:canvas:critical": "node scripts/test-system.mjs ci-canvas-critical",
    "test:system:canvas:full": "node scripts/test-system.mjs ci-canvas-full",
    "test:system:performance": "node scripts/test-system.mjs ci-performance",
    "test:system:full": "node scripts/test-system.mjs full-local",
    "test:system:release": "node scripts/test-system.mjs release",
    "delivery:preflight": "node scripts/git-delivery.mjs preflight",
    "delivery:verify-merged": "node scripts/git-delivery.mjs verify-merged",
    "check:walkthroughs": "node ./scripts/check-walkthroughs.mjs",
    "check:heavy-path": "node ./scripts/check-heavy-path.mjs",
    "check:mcp-payload": "pnpm exec tsx scripts/check-mcp-payload.ts",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "check:adoption-bridge": "node ./scripts/check-adoption-bridge.mjs",
    "check:batch-machines": "node ./scripts/check-batch-machines.mjs",
    "check:test-types": "node ./scripts/check-test-types.mjs",
    "check:gates-chain": "node ./scripts/check-gates-chain.mjs",
    "check:quality-gate-workflow": "node --test ./scripts/validation-policy.node-test.mjs ./scripts/check-quality-gate-workflow.node-test.mjs ./scripts/ci-annotation-hygiene.node-test.mjs ./scripts/test-focused.node-test.mjs",
    "check:cla-workflow": "node --test ./scripts/check-cla-workflow.node-test.mjs",
    "check:nul-bytes": "node ./scripts/check-source-nul-bytes.mjs",
    "check:hook-behavior": "node --test ./scripts/check-hook-behavior.node-test.mjs && node ./scripts/check-hook-behavior.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1",
    "@ai-sdk/openai-compatible": "^0.2.16",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@imgly/background-removal": "^1.7.0",
    "@leafer-in/editor": "^2.1.0",
    "@leafer-in/export": "^2.1.0",
    "@mantine/core": "^7.13.1",
    "@mantine/modals": "^7.13.1",
    "@mantine/notifications": "^7.13.1",
    "@photo-sphere-viewer/core": "5.14.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@react-three/drei": "^9",
    "@react-three/fiber": "^8",
    "@tabler/icons-react": "^3.19.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tiptap/core": "3.23.5",
    "@tiptap/extension-highlight": "3.23.5",
    "@tiptap/extension-list": "3.23.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-table": "3.23.5",
    "@tiptap/pm": "3.23.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/suggestion": "3.23.5",
    "@xmldom/xmldom": "0.9.12",
    "@xyflow/react": "12.11.5",
    "ai": "^4.3.19",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "framer-motion": "^12.39.0",
    "i18next": "26.3.6",
    "immer": "^11.1.8",
    "leafer-ui": "^2.1.0",
    "mammoth": "^1.12.0",
    "perfect-freehand": "^1.2.2",
    "quickjs-emscripten": "0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "17.0.10",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "remark-gfm": "4.0.1",
