  "build": {
    "appId": "com.nomi.app",
    "productName": "Nomi",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack-mac.cjs",
    "extraResources": [{ "from": "assets/sound", "to": "assets/sound" }],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**",
      "node_modules/.pnpm/@ffmpeg-installer+*/**",
      "node_modules/@ffprobe-installer/**",
      "node_modules/.pnpm/@ffprobe-installer+*/**",
      "node_modules/@anthropic-ai/sandbox-runtime/vendor/**",
      "node_modules/.pnpm/@anthropic-ai+sandbox-runtime@*/node_modules/@anthropic-ai/sandbox-runtime/vendor/**"
    ],
    "icon": "build/icon.png",
    "files": [
      "dist/**",
      "dist-electron/**",
      "public/**",
      "resources/**",
      "skills/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/chord": "0.85.1",
      "@earendil-works/pi-agent-core": "0.85.1",
      "@earendil-works/pi-ai": "0.85.1",
      "@earendil-works/pi-coding-agent": "0.85.1",
      "@earendil-works/pi-telemetry": "0.85.1",
      "@earendil-works/pi-tui": "0.85.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/darwin-x64",
      "@ffmpeg-installer/linux-x64",
      "@ffmpeg-installer/win32-x64",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/darwin-x64",
      "@ffprobe-installer/linux-x64",
      "@ffprobe-installer/win32-x64"
    ],
    "ignoredBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffprobe-installer/darwin-arm64"
    ]
  }
