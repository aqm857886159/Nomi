{
  "schema": "agent-param-eval/v1",
  "$comment": "Agent 参数写对 / 重试题库。每题 = 一句用户说法 + 起始状态 + 机器可判的期望。判分在 agent-param-eval-judge.mjs，跑器在 agent-param-eval-real-model.walk.mjs。生成一律停在付费确认卡（跑器永远点「取消」），所以只有大脑模型的文字费用。说法按真实反馈的类型改写，不是用户原文。",
  "script": "清晨六点，老街的早点铺开门，蒸笼的白汽顶起锅盖。\n阿桥背着书包从巷口跑过来，差一点撞翻门口的竹筐。\n她在柜台前掏出皱巴巴的零钱，老板娘笑着递给她两个热包子。\n她边跑边啃包子，穿过正在拉卷帘门的菜场。\n公交车刚好进站，她挤上车，把脸贴在起雾的车窗上。\n车窗外，晨光一点点爬上整条老街。",
  "fixtures": {
    "empty": "空项目，空画布，无文稿，无素材",
    "script": "创作页已写入 6 个场景的文稿（`script`），画布空",
    "assets": "素材库有 3 个素材：图片『小林』、图片『便利店』、8 秒视频『跑步素材』（跑器用 ffmpeg 现生成，不依赖私有素材）；画布空",
    "drafts1": "固定存储夹具：1 个视频镜头，5 秒、16:9",
    "drafts3": "固定存储夹具：3 个视频镜头，各 5 秒、16:9",
    "drafts6": "固定存储夹具：6 个视频镜头，各 5 秒、16:9"
  },
  "families": {
    "single": "单参数：比例 / 时长 / 张数 / 分辨率 / 指定模型与开关",
    "boundary": "越界取值（99 秒、3 秒、8K、4k）：第一次被拒后能不能改对或转问",
    "verbatim": "用户逐字给提示词（含一条要润色的阳性对照）",
    "script_batch": "按文稿批量分镜",
    "reference": "素材参考（图、视频、首尾帧）",
    "edit": "改已有镜头（局部意图不许顺带改别的）",
    "batch_edit": "批量改 / 追加镜头",
    "stage": "白模预演（stage_shot）",
    "spend": "付费确认前后",
    "read_only": "只问不做"
  },
  "tasks": [
    { "id": "P01", "lang": "zh", "family": "single", "fixture": "empty",
      "say": "给我生成一条 16:9、8 秒的视频，一只纸船在雨后的水洼里漂。先别生成，起草就行。",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "params": [ { "kind": "duration", "value": 8, "honest": true }, { "kind": "aspect", "value": "16:9", "honest": true } ] } } } },
    { "id": "P02", "lang": "en", "family": "single", "fixture": "empty",
      "say": "Make a 9:16 video, 5 seconds, a girl running through a night market.",
      "expect": { "firstWrite": ["draft_shots"], "retryMax": 1,
        "plan": { "count": 1, "each": { "params": [ { "kind": "duration", "value": 5, "honest": true }, { "kind": "aspect", "value": "9:16", "honest": true } ] } } } },
    { "id": "P03", "lang": "zh", "family": "single", "fixture": "empty",
      "say": "做一张竖版的海报图，要 4 张，先别生成。",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "countOrParam": { "kind": "count", "value": 4 }, "each": { "params": [ { "kind": "aspect", "oneOf": ["9:16", "3:4", "2:3"], "honest": true } ] } } } },
    { "id": "P04", "lang": "en", "family": "single", "fixture": "empty",
      "say": "Generate 3 variations of a cozy cabin, square 1:1. Draft only, don't generate yet.",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "countOrParam": { "kind": "count", "value": 3 }, "each": { "params": [ { "kind": "aspect", "value": "1:1", "honest": true } ] } } } },
    { "id": "P05", "lang": "zh", "family": "single", "fixture": "empty", "catalogDependent": true,
      "say": "用 Seedance 2.0 做一条 6 秒的视频，不要声音，720p，先别生成。",
      "expect": { "firstWrite": ["draft_shots", "list_models"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "modelLike": "seedance", "params": [ { "kind": "duration", "value": 6, "honest": true }, { "kind": "audio", "value": false }, { "kind": "resolution", "value": "720p", "honest": true } ] } } } },
    { "id": "P06", "approvals": { "delete_from_canvas": "approve" }, "lang": "en", "family": "single", "fixture": "empty", "catalogDependent": true,
      "say": "Use the fast variant of the video model, no audio, 4k. Draft only.",
      "expect": { "firstWrite": ["draft_shots", "list_models"], "noGenerate": true, "retryMax": 2,
        "readback": { "variantLike": "fast", "params": [ { "kind": "audio", "value": false }, { "kind": "resolution", "value": "4k" } ] },
        "plan": { "count": 1, "each": { "variantLike": "fast", "params": [ { "kind": "audio", "value": false }, { "kind": "resolution", "value": "4k", "honest": true } ] } } } },

    { "id": "P07", "lang": "zh", "family": "boundary", "fixture": "empty",
      "say": "生成一个 99 秒的视频，一只猫在打哈欠。先别生成。",
      "expect": { "noGenerate": true, "retryMax": 2,
        "boundary": { "kind": "duration", "value": 99 } } },
    { "id": "P08", "lang": "en", "family": "boundary", "fixture": "empty",
      "say": "Make a video of a lighthouse at night in 8K resolution. Draft only.",
      "expect": { "noGenerate": true, "retryMax": 2,
        "boundary": { "kind": "resolution", "value": "8k" } } },
    { "id": "P09", "lang": "zh", "family": "boundary", "fixture": "empty",
      "say": "做一条 3 秒的视频，一只猫打哈欠，先别生成。",
      "expect": { "firstWrite": ["draft_shots", "list_models"], "noGenerate": true, "retryMax": 2,
        "plan": { "count": 1, "each": { "params": [ { "kind": "duration", "value": 3, "honest": true } ] } } } },

    { "id": "P10", "lang": "zh", "family": "verbatim", "fixture": "empty",
      "say": "提示词写：一只橘猫坐在窗台上。就这么写，别加别的。先别生成。",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "promptVerbatim": "一只橘猫坐在窗台上" } } } },
    { "id": "P11", "lang": "en", "family": "verbatim", "fixture": "empty",
      "say": "Prompt: \"a red kite over a wheat field\". Use exactly that wording. Draft only.",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "promptVerbatim": "a red kite over a wheat field" } } } },
    { "id": "P12", "lang": "zh", "family": "verbatim", "fixture": "empty",
      "say": "镜头提示词就用这句，一个字都别改：雨夜里的霓虹灯牌在积水里晃动。先别生成。",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "promptVerbatim": "雨夜里的霓虹灯牌在积水里晃动" } } } },
    { "id": "P13", "defaultModelDependent": true, "lang": "en", "family": "verbatim", "fixture": "empty",
      "say": "Draft a video shot with exactly this prompt, no embellishment: 'two old men playing chess in a park'. Don't generate.",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "promptVerbatim": "two old men playing chess in a park" } } } },
    { "id": "P14", "lang": "en", "family": "verbatim", "fixture": "empty", "note": "阳性对照：用户明确要润色时可以扩写，但不许丢要素",
      "say": "Draft a shot and polish my prompt to make it more cinematic: \"a man walks in rain\". Don't generate.",
      "expect": { "firstWrite": ["draft_shots"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "promptContainsAll": [["man", "男人", "男子", "男性"], ["walk", "走", "行走", "步行"], ["rain", "雨"]], "promptLongerThan": 22 } } } },

    { "id": "P15", "lang": "zh", "family": "script_batch", "fixture": "script",
      "say": "把文稿拆成分镜，每个场景一镜，都用 16:9、5 秒，先别生成。",
      "expect": { "firstWrite": ["draft_shots", "read_script", "list_models", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 6, "each": { "params": [ { "kind": "duration", "value": 5, "honest": true }, { "kind": "aspect", "value": "16:9", "honest": true } ] } } } },
    { "id": "P16", "lang": "en", "family": "script_batch", "fixture": "script",
      "say": "Break the script into shots, one per scene, 5 seconds each, all 16:9. Don't generate yet.",
      "expect": { "firstWrite": ["draft_shots", "read_script", "list_models", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 6, "each": { "params": [ { "kind": "duration", "value": 5, "honest": true }, { "kind": "aspect", "value": "16:9", "honest": true } ] } } } },
    { "id": "P17", "lang": "zh", "family": "script_batch", "fixture": "script",
      "say": "把文稿拆成分镜，每个场景一镜，全部用同一个视频模型，每镜 8 秒，先别生成。",
      "expect": { "firstWrite": ["draft_shots", "read_script", "list_models", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 6, "sameModel": true, "each": { "params": [ { "kind": "duration", "value": 8, "honest": true } ] } } } },
    { "id": "P18", "lang": "en", "family": "script_batch", "fixture": "script",
      "say": "Turn the script into 4 video shots, vertical 9:16. Draft only.",
      "expect": { "firstWrite": ["draft_shots", "read_script", "list_models", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 4, "each": { "params": [ { "kind": "aspect", "value": "9:16", "honest": true } ] } } } },

    { "id": "P19", "lang": "zh", "family": "reference", "fixture": "assets",
      "say": "用『跑步素材』那段视频做参考，生成一条类似运镜的新视频，先别生成。",
      "expect": { "firstWrite": ["draft_shots", "look_at_media", "list_models"], "noGenerate": true, "retryMax": 2,
        "plan": { "count": 1, "each": { "refsMin": 1 } } } },
    { "id": "P20", "lang": "en", "family": "reference", "fixture": "assets",
      "say": "Use the character photo 小林 and the convenience store photo 便利店 as references for a 6-second shot. Draft only.",
      "expect": { "firstWrite": ["draft_shots", "look_at_media", "list_models"], "noGenerate": true, "retryMax": 2,
        "plan": { "count": 1, "each": { "refsMin": 2, "params": [ { "kind": "duration", "value": 6, "honest": true } ] } } } },
    { "id": "P21", "lang": "zh", "family": "reference", "fixture": "assets",
      "say": "第一帧用便利店那张图，尾帧用小林那张，做一条 5 秒的视频，先别生成。",
      "expect": { "firstWrite": ["draft_shots", "look_at_media", "list_models"], "noGenerate": true, "retryMax": 2,
        "plan": { "count": 1, "each": { "refsMin": 2, "params": [ { "kind": "duration", "value": 5, "honest": true } ] } } } },
    { "id": "P22", "lang": "en", "family": "reference", "fixture": "assets",
      "say": "Use the 8-second running clip as a video reference and keep it 16:9. Draft only.",
      "expect": { "firstWrite": ["draft_shots", "look_at_media", "list_models"], "noGenerate": true, "retryMax": 2,
        "plan": { "count": 1, "each": { "refsMin": 1, "params": [ { "kind": "aspect", "value": "16:9", "honest": true } ] } } } },

    { "id": "P23", "lang": "zh", "family": "edit", "fixture": "drafts3",
      "say": "把镜2的时长改成 8 秒，别的都别动。",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "edit": { "shotIndex": 1, "params": [ { "kind": "duration", "value": 8, "honest": true } ], "unchangedFields": ["prompt", "modelId"], "othersUnchanged": true } } },
    { "id": "P24", "lang": "en", "family": "edit", "fixture": "drafts3",
      "say": "Change shot 3 to 16:9, nothing else.",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "edit": { "shotIndex": 2, "params": [ { "kind": "aspect", "value": "16:9", "honest": true } ], "unchangedFields": ["prompt", "modelId"], "othersUnchanged": true } } },
    { "id": "P25", "lang": "zh", "family": "edit", "fixture": "drafts3",
      "say": "镜1 的提示词改成：一只黑猫坐在窗台上",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "edit": { "shotIndex": 0, "promptVerbatim": "一只黑猫坐在窗台上", "unchangedFields": ["modelId"], "unchangedParams": ["duration"], "othersUnchanged": true } } },
    { "id": "P26", "lang": "en", "family": "edit", "fixture": "drafts3",
      "say": "Set the prompt of shot 1 to: \"a black cat on a windowsill\". Nothing else.",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "edit": { "shotIndex": 0, "promptVerbatim": "a black cat on a windowsill", "unchangedFields": ["modelId"], "unchangedParams": ["duration"], "othersUnchanged": true } } },
    { "id": "P27", "defaultModelDependent": true, "lang": "zh", "family": "edit", "fixture": "drafts1",
      "say": "把时长改成 3 秒",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 2,
        "edit": { "shotIndex": 0, "params": [ { "kind": "duration", "value": 3, "honest": true } ], "unchangedFields": ["prompt", "modelId"], "othersUnchanged": true } } },
    { "id": "P28", "lang": "en", "family": "edit", "fixture": "drafts1",
      "say": "Set the resolution to 8K.",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 2,
        "edit": { "shotIndex": 0, "params": [ { "kind": "resolution", "value": "8k", "honest": true } ], "unchangedFields": ["prompt", "modelId"], "othersUnchanged": true } } },

    { "id": "P29", "defaultModelDependent": true, "lang": "zh", "family": "batch_edit", "fixture": "drafts6",
      "say": "把这 6 镜的比例统一成 21:9。",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas", "list_models"], "noGenerate": true, "retryMax": 2,
        "plan": { "count": 6, "each": { "params": [ { "kind": "aspect", "value": "21:9", "honest": true } ] } } } },
    { "id": "P30", "lang": "en", "family": "batch_edit", "fixture": "drafts6",
      "say": "Make every shot 8 seconds.",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas", "list_models"], "noGenerate": true, "retryMax": 2,
        "plan": { "count": 6, "each": { "params": [ { "kind": "duration", "value": 8, "honest": true } ] } } } },
    { "id": "P31", "lang": "zh", "family": "batch_edit", "fixture": "drafts3",
      "say": "再加两镜：一镜特写，一镜远景，设置跟上面的一样。",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 5, "each": { "params": [ { "kind": "duration", "value": 5, "honest": true }, { "kind": "aspect", "value": "16:9", "honest": true } ] } } } },
    { "id": "P32", "lang": "en", "family": "batch_edit", "fixture": "drafts3",
      "say": "Add one more shot at the end: a wide shot of the street. Same settings as the others.",
      "expect": { "firstWrite": ["draft_shots", "look_at_canvas"], "noGenerate": true, "retryMax": 1,
        "plan": { "count": 4, "each": { "params": [ { "kind": "duration", "value": 5, "honest": true }, { "kind": "aspect", "value": "16:9", "honest": true } ] } } } },

    { "id": "P33", "defaultModelDependent": true, "lang": "zh", "family": "stage", "fixture": "drafts3",
      "say": "给镜2搭个白模预演：警察追着犯人跑，路人站在旁边看。",
      "expect": { "firstWrite": ["stage_shot", "look_at_canvas"], "mustCallAccepted": ["stage_shot"], "retryMax": 2 } },
    { "id": "P34", "lang": "en", "family": "stage", "fixture": "drafts3",
      "say": "Block out a gray 3D preview for shot 2: a cop chases a thief while a pedestrian watches.",
      "expect": { "firstWrite": ["stage_shot", "look_at_canvas"], "mustCallAccepted": ["stage_shot"], "retryMax": 2 } },

    { "id": "P35", "lang": "zh", "family": "spend", "fixture": "drafts3",
      "say": "生成吧。",
      "expect": { "firstWrite": ["generate", "look_at_canvas"], "mustCall": ["generate"], "spendCardShown": true, "retryMax": 1 } },
    { "id": "P36", "lang": "en", "family": "spend", "fixture": "empty",
      "say": "Make a 5 second video of a paper boat drifting on a puddle, and generate it.",
      "expect": { "firstWrite": ["draft_shots", "list_models"], "mustCall": ["draft_shots", "generate"], "spendCardShown": true, "retryMax": 1,
        "plan": { "count": 1, "each": { "params": [ { "kind": "duration", "value": 5, "honest": true } ] } } } },

    { "id": "P37", "lang": "zh", "family": "read_only", "fixture": "empty",
      "say": "现在有哪些视频模型可以用？各自支持多长的时长？先别做任何东西。",
      "expect": { "firstWrite": "none", "mustCall": ["list_models"], "retryMax": 0 } },
    { "id": "P38", "lang": "en", "family": "read_only", "fixture": "empty",
      "say": "Which aspect ratios can the default video model do? Don't make anything yet.",
      "expect": { "firstWrite": "none", "mustCall": ["list_models"], "retryMax": 0 } },
    { "id": "P39", "fixtureUnavailable": "固定草稿没有可撤销写回执和对应会话历史，不能公平评判撤销；需补原生可撤销事务夹具。", "approvals": { "undo": "approve", "delete_from_canvas": "approve" }, "lang": "en", "family": "edit", "fixture": "drafts1", "note": "撤销取自上一次写入的回执 changeId，不编造",
      "say": "Undo that last change.",
      "expect": { "firstWrite": ["undo", "look_at_canvas"], "mustCallAccepted": ["undo"], "retryMax": 1 } }
  ],
  "untestable": [
    { "idea": "换模型后参数跟随（把这个视频换成另一个模型、时长不变）", "why": "要求目录里至少有两个可互换的视频模型；题库跑在用户自己的目录上，目录里有几个模型跑前不可知，判不了「另一个」对不对。需要固定目录夹具（改产品代码或新增合成目录）后才能进库。" },
    { "idea": "按展示名选 APIMart 新模型（gpt-image-2 等）、按参考数量能力筛模型", "why": "同上，依赖目录里恰好有这些模型；先要「只读目录」量具（list_models 结果快照）再出题。" },
    { "idea": "改已有白模预演（两个角色靠近些、路人朝镜头走）", "why": "起始态要一份真预演；用 prelude 搭要先让模型过 stage_shot，失败率本身就是被测量，起始态不稳。" },
    { "idea": "删除再重建（delete_from_canvas 后 draft_shots）", "why": "单独的删除重建题尚无逐项成功定义；已有题可显式声明 approvals，未声明的删除或撤销卡仍拒绝并记 unspecified。" },
    { "idea": "节点 id 与素材 id 混用（图片节点改用视频模型让它动起来）", "why": "起始态要一张带产物的图片节点，种它要改画布持久格式夹具；本线不改产品代码。" }
  ]
}
