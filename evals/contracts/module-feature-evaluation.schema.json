{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nomi.local/schemas/module-feature-evaluation/v1.json",
  "title": "Nomi Module/Feature Evaluation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "contractId",
    "module",
    "goal",
    "successExperience",
    "metrics",
    "journeys",
    "automatedChecks",
    "humanJudgments",
    "failureRecovery",
    "evidence",
    "nonGoals"
  ],
  "properties": {
    "contractVersion": { "const": "module-feature-evaluation/v1" },
    "contractId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "module": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 20 },
    "successExperience": { "type": "string", "minLength": 20 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definition", "owner", "method", "threshold", "targetOnly"],
        "properties": {
          "id": { "type": "string" },
          "definition": { "type": "string", "minLength": 10 },
          "owner": { "enum": ["automated", "human", "automated+human"] },
          "method": { "type": "string", "minLength": 10 },
          "threshold": {},
          "targetOnly": { "type": "boolean" }
        }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps", "passCriteria"],
        "properties": {
          "id": { "type": "string" },
          "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "passCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
        }
      }
    },
    "automatedChecks": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "humanJudgments": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "failureRecovery": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "commit", "artifacts"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
  }
}
